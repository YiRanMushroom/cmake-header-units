# HeaderUnits.cmake -- prototype: EXTERNAL headers (STL, third-party) as C++20 header units.
#
# Toolchains: GCC 16 (+libstdc++), Clang 22 (GNU driver; libstdc++ or MSVC STL). Generator: Ninja.
#
#   include(HeaderUnits)                       # top-level CMakeLists.txt, after project(), before add_subdirectory()
#   add_header_units(<set> HEADERS <name>...
#                    [LINK_LIBRARIES <imported-target>...]
#                    [COMPILE_DEFINITIONS <def>...] [COMPILE_OPTIONS <opt>...]
#                    [CXX_STANDARD <n>] [CXX_EXTENSIONS <bool>] [POSITION_INDEPENDENT_CODE <bool>])
#   target_import_header_units(<consumer> <set> [SOURCES <src>...])
#
# Every place that relies on CMake internals or on undocumented CMake behaviour (unsupported, may break with
# any CMake release) is marked with "CMAKE-INTERNAL" -- grep for it.  See README.md for the design.

include_guard(GLOBAL)

if(CMAKE_VERSION VERSION_LESS 4.2)
  message(FATAL_ERROR "HeaderUnits: CMake >= 4.2 is required (OBJECT_NAME source property).")
endif()
if(NOT CMAKE_CXX_COMPILER_LOADED)
  message(FATAL_ERROR "HeaderUnits: include(HeaderUnits) must come after project(... CXX) / enable_language(CXX).")
endif()
if(NOT CMAKE_GENERATOR STREQUAL "Ninja")
  message(FATAL_ERROR "HeaderUnits: only the single-config 'Ninja' generator is supported (got '${CMAKE_GENERATOR}').")
endif()

if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
  set(_HU_TC GCC)
  if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS 16)
    message(WARNING "HeaderUnits: tested with GCC 16 only (found ${CMAKE_CXX_COMPILER_VERSION}).")
  endif()
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "GNU")
  set(_HU_TC Clang)
  if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS 22)
    message(WARNING "HeaderUnits: tested with Clang 22 only (found ${CMAKE_CXX_COMPILER_VERSION}).")
  endif()
else()
  message(FATAL_ERROR "HeaderUnits: unsupported compiler '${CMAKE_CXX_COMPILER_ID}' "
    "(frontend '${CMAKE_CXX_COMPILER_FRONTEND_VARIANT}'). Supported: GCC, and Clang with the GNU-style driver "
    "(clang++, not clang-cl). MSVC and clang-cl are not supported by this prototype.")
endif()
set(_HU_DIR "${CMAKE_BINARY_DIR}/CMakeFiles/header_units")
set_property(GLOBAL PROPERTY _HU_TC "${_HU_TC}")
set_property(GLOBAL PROPERTY _HU_DIR "${_HU_DIR}")
if(_HU_DIR MATCHES "[ \t]" AND _HU_TC STREQUAL "GCC")
  message(FATAL_ERROR "HeaderUnits: with GCC the build directory must not contain spaces (GCC's module-mapper file parser cannot handle them).")
endif()

if(_HU_TC STREQUAL "GCC")
  execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -print-prog-name=g++-mapper-server
                  OUTPUT_VARIABLE _hu_srv OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT IS_ABSOLUTE "${_hu_srv}" OR NOT EXISTS "${_hu_srv}")
    message(FATAL_ERROR "HeaderUnits: '${CMAKE_CXX_COMPILER} -print-prog-name=g++-mapper-server' gave '${_hu_srv}', not an existing file.")
  endif()
  set_property(GLOBAL PROPERTY _HU_GCC_SERVER "${_hu_srv}")
  # Compile-time module mapper: CMake's per-TU .modmap (named modules) + this TU's header-unit map, if any.
  # $1 = CMake's <MODULE_MAP_FILE>, $2 = the TU's source path (Ninja's $in; relative = inside the build dir).
  file(CONFIGURE OUTPUT "${_HU_DIR}/gcc-mapper.sh" @ONLY CONTENT [=[#!/bin/sh
# Generated by HeaderUnits.cmake -- do not edit.
case "$2" in /*) src="$2" ;; *) src="$PWD/$2" ;; esac
map="@_HU_DIR@/src$src.map"
if [ -f "$map" ]; then exec "@_hu_srv@" - "$1" "$map"; fi
exec "@_hu_srv@" - "$1"
]=])
  # CMAKE-INTERNAL: CMAKE_CXX_MODULE_MAP_FLAG is CMake's private template for the GCC module-mapper option of
  # its scanned compile rule (Modules/Compiler/GNU-CXX.cmake).  We replace "-fmodule-mapper=<MODULE_MAP_FILE>"
  # by a mapper *program* (gcc-mapper.sh -> g++-mapper-server) that serves CMake's modmap PLUS the TU's
  # header-unit map.  "$in" is a Ninja variable (the source of the compile edge) injected into CMake's rule;
  # CMake writes sources as absolute paths, or relative to the top build dir when inside it (gcc-mapper.sh
  # handles both).
  set(_hu_old "${CMAKE_CXX_MODULE_MAP_FLAG}")
  string(FIND "${_hu_old}" "-fmodule-mapper=<MODULE_MAP_FILE>" _hu_pos)
  if(_hu_pos LESS 0)
    message(FATAL_ERROR "HeaderUnits: CMAKE_CXX_MODULE_MAP_FLAG='${_hu_old}' does not contain '-fmodule-mapper=<MODULE_MAP_FILE>'; "
      "this CMake version changed its internal GCC module rule, GCC header units cannot be supported.")
  endif()
  string(REPLACE "-fmodule-mapper=<MODULE_MAP_FILE>"
         "'-fmodule-mapper=|/bin/sh ${_HU_DIR}/gcc-mapper.sh <MODULE_MAP_FILE> $in'"
         CMAKE_CXX_MODULE_MAP_FLAG "${_hu_old}")
  set_property(GLOBAL PROPERTY _HU_GCC_MAP_FLAG "${CMAKE_CXX_MODULE_MAP_FLAG}")
  unset(_hu_old)
  unset(_hu_pos)
  unset(_hu_srv)
endif()

# ---------------------------------------------------------------------------------------------------------
# Resolve <name> -> absolute path exactly as the compiler does for "#include <name>" with the set's flags:
# one try_compile (same CMAKE_CXX_FLAGS, -std, usage requirements of LINK_LIBRARIES) whose probe TUs each
# include an empty marker header and then <name>, compiled with -H; the first depth-1 header after the
# marker is the resolved file.
function(_hu_resolve out_var set)
  cmake_parse_arguments(PARSE_ARGV 2 A "" "STD;EXT" "HEADERS;LIBS;DEFS;OPTS;INCS")
  get_property(hudir GLOBAL PROPERTY _HU_DIR)
  set(srcs)
  set(i 0)
  foreach(h IN LISTS A_HEADERS)
    set(marker "${hudir}/probe/hu_probe_marker_${i}.h")
    if(NOT EXISTS "${marker}")
      file(WRITE "${marker}" "\n")
    endif()
    list(APPEND srcs SOURCE_FROM_CONTENT "hu_probe_${i}.cpp" "#include \"${marker}\"\n#include <${h}>\n")
    math(EXPR i "${i} + 1")
  endforeach()
  set(defs)
  foreach(d IN LISTS A_DEFS)
    list(APPEND defs "-D${d}")
  endforeach()
  set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
  set(incflags)
  if(A_INCS)
    string(REPLACE ";" "\\;" incs_esc "${A_INCS}")
    set(incflags CMAKE_FLAGS "-DINCLUDE_DIRECTORIES=${incs_esc}")
  endif()
  try_compile(ok ${srcs}
    ${incflags}
    LINK_LIBRARIES ${A_LIBS}
    COMPILE_DEFINITIONS -H ${defs} ${A_OPTS}
    CXX_STANDARD ${A_STD} CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS ${A_EXT}
    OUTPUT_VARIABLE log
    NO_CACHE)
  if(NOT ok)
    message(FATAL_ERROR "HeaderUnits: add_header_units(${set}): probe compile failed -- a header cannot be found or "
      "does not compile on its own with the set's flags/LINK_LIBRARIES:\n${log}")
  endif()
  string(REPLACE "\r" "" log "${log}")
  string(REPLACE ";" "\\;" log "${log}")
  string(REPLACE "\n" ";" lines "${log}")
  set(cur "")
  foreach(line IN LISTS lines)
    if(line MATCHES "^\\. (.*)hu_probe_marker_([0-9]+)\\.h$")
      set(cur "${CMAKE_MATCH_2}")
    elseif(NOT cur STREQUAL "" AND line MATCHES "^\\. (.+)$")
      file(TO_CMAKE_PATH "${CMAKE_MATCH_1}" p)
      set(res_${cur} "${p}")
      set(cur "")
    endif()
  endforeach()
  set(paths)
  set(i 0)
  foreach(h IN LISTS A_HEADERS)
    if(NOT DEFINED res_${i})
      message(FATAL_ERROR "HeaderUnits: add_header_units(${set}): could not determine the file for <${h}> from the -H output:\n${log}")
    endif()
    list(APPEND paths "${res_${i}}")
    math(EXPR i "${i} + 1")
  endforeach()
  set(${out_var} "${paths}" PARENT_SCOPE)
endfunction()

function(_hu_bool out v)
  if(v)
    set(${out} ON PARENT_SCOPE)
  else()
    set(${out} OFF PARENT_SCOPE)
  endif()
endfunction()

# ---------------------------------------------------------------------------------------------------------
# Header-unit import declarations in a file ("import <x>;", "import \"x\";", optionally exported), as a list of
# "a|<name>" (angle) and "q|<name>" (quote).  Imports produced by macros or hidden in #if are not considered.
function(_hu_scan_imports out file)
  set(r)
  file(STRINGS "${file}" ls REGEX "^[ \t]*(export[ \t]+)?import[ \t]*[<\"][^>\"]+[>\"][ \t]*;")
  foreach(l IN LISTS ls)
    if(l MATCHES "import[ \t]*<([^>]+)>")
      list(APPEND r "a|${CMAKE_MATCH_1}")
    elseif(l MATCHES "import[ \t]*\"([^\"]+)\"")
      list(APPEND r "q|${CMAKE_MATCH_1}")
    endif()
  endforeach()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# "a|x" -> x ; "q|x" -> the normalized absolute path if x exists relative to <dir> (quote lookup), else x.
# CMake-side lookup of <name> in the given include dirs, then the compiler's implicit include dirs ("" if not found).
function(_hu_find_header out name)
  set(r "")
  if(IS_ABSOLUTE "${name}")
    if(EXISTS "${name}")
      set(r "${name}")
    endif()
  else()
    foreach(d IN LISTS ARGN CMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES)
      if(d AND EXISTS "${d}/${name}" AND NOT IS_DIRECTORY "${d}/${name}")
        set(r "${d}/${name}")
        break()
      endif()
    endforeach()
  endif()
  if(r)
    cmake_path(NORMAL_PATH r)
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# Header unit lookup by import name (angle name, or absolute path for a quote import found next to the importer):
# outputs set, resolved path, BMI, (Clang) module name and module map; set is "" if no set provides it.
function(_hu_lookup prefix name)
  string(MD5 k "${name}")
  get_property(t GLOBAL PROPERTY _HU_NAME_SET_${k})
  if(NOT t AND IS_ABSOLUTE "${name}")
    get_property(t GLOBAL PROPERTY _HU_PATH_SET_${k})
  endif()
  set(${prefix}_SET "${t}" PARENT_SCOPE)
  if(NOT t)
    return()
  endif()
  get_property(hs GLOBAL PROPERTY _HU_SET_${t}_HEADERS)
  get_property(ps GLOBAL PROPERTY _HU_SET_${t}_PATHS)
  get_property(bs GLOBAL PROPERTY _HU_SET_${t}_CMIS)
  get_property(ms GLOBAL PROPERTY _HU_SET_${t}_MIDS)
  get_property(mm GLOBAL PROPERTY _HU_SET_${t}_MMAPS)
  list(FIND hs "${name}" idx)
  if(idx LESS 0)
    list(FIND ps "${name}" idx)
  endif()
  list(GET ps ${idx} p)
  list(GET bs ${idx} b)
  set(${prefix}_PATH "${p}" PARENT_SCOPE)
  set(${prefix}_BMI "${b}" PARENT_SCOPE)
  if(ms)
    list(GET ms ${idx} m)
    list(GET mm ${idx} mp)
    set(${prefix}_MID "${m}" PARENT_SCOPE)
    set(${prefix}_MAP "${mp}" PARENT_SCOPE)
  endif()
endfunction()

# Set plus the sets its header units import, transitively.
function(_hu_set_closure out s)
  set(r "${s}")
  set(todo "${s}")
  while(todo)
    list(POP_FRONT todo x)
    get_property(ds GLOBAL PROPERTY _HU_SET_${x}_DEPSETS)
    foreach(d IN LISTS ds)
      if(NOT d IN_LIST r)
        list(APPEND r "${d}")
        list(APPEND todo "${d}")
      endif()
    endforeach()
  endwhile()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

function(_hu_import_name out entry dir)
  string(SUBSTRING "${entry}" 2 -1 n)
  if(entry MATCHES "^q\\|" AND NOT IS_ABSOLUTE "${n}" AND EXISTS "${dir}/${n}")
    set(n "${dir}/${n}")
    cmake_path(NORMAL_PATH n)
  endif()
  set(${out} "${n}" PARENT_SCOPE)
endfunction()

function(add_header_units set)
  cmake_parse_arguments(PARSE_ARGV 1 A "" "CXX_STANDARD;CXX_EXTENSIONS;POSITION_INDEPENDENT_CODE" "HEADERS;LINK_LIBRARIES;COMPILE_DEFINITIONS;COMPILE_OPTIONS;INCLUDE_DIRECTORIES")
  get_property(tc GLOBAL PROPERTY _HU_TC)
  get_property(hudir GLOBAL PROPERTY _HU_DIR)
  if(A_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "add_header_units(${set}): unexpected arguments: ${A_UNPARSED_ARGUMENTS}")
  endif()
  if(TARGET ${set})
    message(FATAL_ERROR "add_header_units(${set}): a target named '${set}' already exists.")
  endif()
  if(NOT set MATCHES "^[A-Za-z0-9_.+-]+$")
    message(FATAL_ERROR "add_header_units(${set}): set names may only contain [A-Za-z0-9_.+-].")
  endif()
  if(NOT A_HEADERS)
    message(FATAL_ERROR "add_header_units(${set}): HEADERS is empty.")
  endif()
  # Header resolution uses try_compile(), which only accepts IMPORTED targets.  For in-tree (project) targets
  # their INTERFACE include directories / definitions are passed to the probe directly (plain paths and
  # $<BUILD_INTERFACE:...> only); the OBJECT library that builds the BMIs links them normally.
  set(probe_libs)
  set(probe_incs ${A_INCLUDE_DIRECTORIES})
  set(probe_defs ${A_COMPILE_DEFINITIONS})
  foreach(l IN LISTS A_LINK_LIBRARIES)
    set(imp TRUE)
    if(TARGET ${l})
      get_target_property(imp ${l} IMPORTED)
    endif()
    if(imp)
      list(APPEND probe_libs ${l})
      continue()
    endif()
    foreach(prop INTERFACE_INCLUDE_DIRECTORIES INTERFACE_COMPILE_DEFINITIONS)
      get_target_property(vals ${l} ${prop})
      if(NOT vals)
        continue()
      endif()
      foreach(v IN LISTS vals)
        if(v MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
          set(v "${CMAKE_MATCH_1}")
        elseif(v MATCHES "^\\$<INSTALL_INTERFACE:")
          continue()
        endif()
        if(v MATCHES "\\$<")
          message(FATAL_ERROR "add_header_units(${set}): ${prop} of in-tree target '${l}' contains a generator "
            "expression ('${v}') the module cannot evaluate at configure time; pass the directories with INCLUDE_DIRECTORIES.")
        endif()
        if(prop STREQUAL "INTERFACE_INCLUDE_DIRECTORIES")
          list(APPEND probe_incs "${v}")
        else()
          list(APPEND probe_defs "${v}")
        endif()
      endforeach()
    endforeach()
  endforeach()
  # Language level of the set (consumers must match exactly: GCC and Clang reject -std mismatches).
  if(DEFINED A_CXX_STANDARD)
    set(std "${A_CXX_STANDARD}")
  else()
    set(std "${CMAKE_CXX_STANDARD}")
  endif()
  if(NOT std OR std LESS 20)
    message(FATAL_ERROR "add_header_units(${set}): needs CXX_STANDARD >= 20 (set CMAKE_CXX_STANDARD or pass CXX_STANDARD).")
  endif()
  if(DEFINED A_CXX_EXTENSIONS)
    _hu_bool(ext "${A_CXX_EXTENSIONS}")
  elseif(DEFINED CMAKE_CXX_EXTENSIONS)
    _hu_bool(ext "${CMAKE_CXX_EXTENSIONS}")
  else()
    _hu_bool(ext "${CMAKE_CXX_EXTENSIONS_DEFAULT}")
  endif()
  list(REMOVE_DUPLICATES A_HEADERS)
  if(tc STREQUAL "Clang" AND CMAKE_INTERMEDIATE_DIR_STRATEGY STREQUAL "SHORT")
    message(FATAL_ERROR "add_header_units(${set}): CMAKE_INTERMEDIATE_DIR_STRATEGY=SHORT is not supported with Clang "
      "(the module needs to know where the header-unit PCM objects are written).")
  endif()

  # Headers that contain import declarations cannot go through the try_compile probe (the header units they
  # import do not exist at configure time): find them CMake-side first.  Without HU_ALLOW_HEADER_IMPORTS
  # such a header is an error; with it, the CMake-side path is used directly.
  set(search_incs ${probe_incs})
  foreach(l IN LISTS probe_libs)
    if(TARGET ${l})
      get_target_property(li ${l} INTERFACE_INCLUDE_DIRECTORIES)
      if(li)
        foreach(i IN LISTS li)
          if(NOT i MATCHES "\\$<")
            list(APPEND search_incs "${i}")
          endif()
        endforeach()
      endif()
    endif()
  endforeach()
  set(probe_headers)
  foreach(h IN LISTS A_HEADERS)
    _hu_find_header(cand "${h}" ${search_incs})
    set(imps)
    if(cand)
      _hu_scan_imports(imps "${cand}")
    endif()
    if(imps)
      if(NOT HU_ALLOW_HEADER_IMPORTS)
        set(shown "${imps}")
        list(TRANSFORM shown REPLACE "^a\\|(.*)$" "import <\\1>")
        list(TRANSFORM shown REPLACE "^q\\|(.*)$" "import \"\\1\"")
        string(JOIN ", " shown ${shown})
        message(FATAL_ERROR "add_header_units(${set}): header <${h}> ('${cand}') contains ${shown}. Import declarations "
          "inside headers are not supported yet: use #include in headers (inside a TU that receives the header units, "
          "a #include of a header unit is turned into an import automatically), or set HU_ALLOW_HEADER_IMPORTS ON "
          "(experimental: header units that import other header units).")
      endif()
      string(MAKE_C_IDENTIFIER "${h}" hid)
      set(direct_${hid} "${cand}")
    else()
      list(APPEND probe_headers "${h}")
    endif()
  endforeach()
  set(probe_paths)
  if(probe_headers)
    _hu_resolve(probe_paths ${set} HEADERS ${probe_headers} LIBS ${probe_libs} DEFS ${probe_defs} INCS ${probe_incs}
                OPTS ${A_COMPILE_OPTIONS} STD ${std} EXT ${ext})
  endif()
  set(paths)
  foreach(h IN LISTS A_HEADERS)
    string(MAKE_C_IDENTIFIER "${h}" hid)
    if(DEFINED direct_${hid})
      list(APPEND paths "${direct_${hid}}")
    else()
      list(POP_FRONT probe_paths pp)
      list(APPEND paths "${pp}")
    endif()
  endforeach()

  add_library(${set} OBJECT)
  # Ordering anchor: a utility target that is complete only when every BMI of the set is built.  Consumers
  # depend on it, so their object-order phony (and that of any BMI target CMake synthesizes from them for
  # cross-target importers of their named modules, Kitware #28166) waits for the BMIs.
  add_custom_target(${set}_ready)
  add_dependencies(${set}_ready ${set})
  set_target_properties(${set} PROPERTIES
    CXX_STANDARD ${std} CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS ${ext}
    CXX_SCAN_FOR_MODULES OFF)       # header units are not scanned: each is built in isolation
  if(A_LINK_LIBRARIES)
    target_link_libraries(${set} PRIVATE ${A_LINK_LIBRARIES})
  endif()
  if(A_COMPILE_DEFINITIONS)
    target_compile_definitions(${set} PRIVATE ${A_COMPILE_DEFINITIONS})
  endif()
  if(A_INCLUDE_DIRECTORIES)
    target_include_directories(${set} PRIVATE ${A_INCLUDE_DIRECTORIES})
  endif()
  if(A_COMPILE_OPTIONS)
    target_compile_options(${set} PRIVATE ${A_COMPILE_OPTIONS})
  endif()
  if(DEFINED A_POSITION_INDEPENDENT_CODE)
    _hu_bool(pic "${A_POSITION_INDEPENDENT_CODE}")
  else()
    _hu_bool(pic "${CMAKE_POSITION_INDEPENDENT_CODE}")
  endif()
  set_target_properties(${set} PROPERTIES POSITION_INDEPENDENT_CODE ${pic})

  set(cmis)
  set(rpaths)
  set(mids)
  set(mmaps)
  set(hmaps)
  set(maplines "")
  foreach(h p IN ZIP_LISTS A_HEADERS paths)
    if(IS_ABSOLUTE "${h}")
      # a header found relative to a source file (quote import), given by absolute path: short object name
      string(MD5 hh "${h}")
      string(SUBSTRING "${hh}" 0 8 hh)
      get_filename_component(fn "${h}" NAME)
      set(oname "abs/${hh}_${fn}")
    else()
      set(oname "${h}")
    endif()
    string(REGEX REPLACE "[^A-Za-z0-9_./+-]" "_" oname "${oname}")
    string(REPLACE ".." "__" oname "${oname}")
    if(tc STREQUAL "GCC")
      # GCC: a header unit's identity is the path string; CMake passes the source as this absolute path.
      cmake_path(NORMAL_PATH p OUTPUT_VARIABLE np)
      if(NOT np STREQUAL p OR NOT IS_ABSOLUTE "${p}")
        message(FATAL_ERROR "add_header_units(${set}): GCC resolves <${h}> to '${p}', which is not a normalized absolute "
          "path. CMake would compile '${np}', a different header-unit identity for GCC. Not supported.")
      endif()
      if(p MATCHES "[ \t]")
        message(FATAL_ERROR "add_header_units(${set}): <${h}> resolves to '${p}' (contains a space); GCC's mapper files cannot express it.")
      endif()
      string(FIND "${p}" "${CMAKE_BINARY_DIR}/" inbin)
      if(inbin EQUAL 0)
        message(FATAL_ERROR "add_header_units(${set}): <${h}> resolves into the build tree ('${p}'); CMake's Ninja generator "
          "passes such sources as relative paths, which changes GCC's header-unit identity. Not supported.")
      endif()
      get_property(owner GLOBAL PROPERTY "_HU_GCC_OWNER_${p}")
      if(owner)
        message(FATAL_ERROR "add_header_units(${set}): <${h}> ('${p}') is already a header unit of set '${owner}'. "
          "With GCC a header has exactly one header unit per build tree (mapper and include translation are keyed by path).")
      endif()
      set_property(GLOBAL PROPERTY "_HU_GCC_OWNER_${p}" ${set})
      set(cmi "${hudir}/gcm/${set}${p}.gcm")
      set(hmap "${hudir}/gcc/${set}/${oname}.map")
      # Isolation: the header's own build sees a mapper that lists only itself, so GCC does not translate the
      # #includes inside it into imports of other header units -> CMI content independent of build order.
      file(CONFIGURE OUTPUT "${hmap}" CONTENT "${p} ${cmi}\n")
      list(APPEND hmaps "${hmap}")
      string(APPEND maplines "${p} ${cmi}\n")
      set_source_files_properties("${p}" TARGET_DIRECTORY ${set} PROPERTIES
        LANGUAGE CXX
        OBJECT_NAME "hu/${oname}"
        # -fdeps-format=p1689r5: without it GCC's -MD depfile gets make rules for module names
        # ("<hdr>.c++-module: <cmi>", .PHONY) that Ninja records as never-existing inputs (always dirty).
        COMPILE_OPTIONS "-fmodules;-fmodule-header;-fmodule-mapper=${hmap};-fdeps-format=p1689r5"
        OBJECT_OUTPUTS "${cmi}")
      list(APPEND cmis "${cmi}")
    else()
      # Clang: the "object" written by -fmodule-header ... -c is the header unit's PCM.
      file(REAL_PATH "${p}" p)
      # Lazy, named header unit (Buck2-style, without stubs): a module map declares the REAL header as the only
      # header of module <mid>; consumers get -fmodule-map-file + -fmodule-file=<mid>=<pcm>, so every
      # #include / import that resolves to this file (any spelling) becomes an import of <mid>, and the PCM is
      # only read by TUs that actually reach the header.  The BMI's own compile must NOT see the module map
      # (Clang 22 then writes a PCM that crashes its consumers).
      string(MAKE_C_IDENTIFIER "${set}__${oname}" mid)
      set(mmap "${hudir}/clang/${set}/${mid}.modulemap")
      file(CONFIGURE OUTPUT "${mmap}" CONTENT "module \"${mid}\" {\n  header \"${p}\"\n  export *\n}\n")
      list(APPEND mids "${mid}")
      list(APPEND mmaps "${mmap}")
      set_source_files_properties("${p}" TARGET_DIRECTORY ${set} PROPERTIES
        LANGUAGE CXX
        OBJECT_NAME "hu/${oname}"
        COMPILE_OPTIONS "-fmodule-header=system;-xc++-system-header;-fmodule-name=${mid};-Wno-unused-command-line-argument")
      # CMAKE-INTERNAL: location of an object file (<target binary dir>/CMakeFiles/<target>.dir/<OBJECT_NAME><ext>
      # with the default CMAKE_INTERMEDIATE_DIR_STRATEGY=FULL).  Needed because OBJECT_DEPENDS does not accept
      # $<TARGET_OBJECTS>.  If CMake ever places the object elsewhere, Ninja stops with "missing and no known
      # rule to make it" (loud failure, never a silent misbuild).
      list(APPEND cmis "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/${set}.dir/hu/${oname}${CMAKE_CXX_OUTPUT_EXTENSION}")
    endif()
    target_sources(${set} PRIVATE "${p}")
    list(APPEND rpaths "${p}")
  endforeach()

  # Import declarations inside the headers: an error unless HU_ALLOW_HEADER_IMPORTS is ON (experimental).
  foreach(h p IN ZIP_LISTS A_HEADERS rpaths)
    _hu_scan_imports(imps "${p}")
    if(NOT imps)
      continue()
    endif()
    if(NOT HU_ALLOW_HEADER_IMPORTS)
      set(shown "${imps}")
      list(TRANSFORM shown REPLACE "^a\\|(.*)$" "import <\\1>")
      list(TRANSFORM shown REPLACE "^q\\|(.*)$" "import \"\\1\"")
      string(JOIN ", " shown ${shown})
      message(FATAL_ERROR "add_header_units(${set}): header <${h}> ('${p}') contains ${shown}. Import declarations inside "
        "headers are not supported yet: use #include in headers (inside a TU that receives the header units, a "
        "#include of a header unit is turned into an import automatically), or set HU_ALLOW_HEADER_IMPORTS ON "
        "(experimental: header units that import other header units).")
    endif()
    string(MD5 hk "${p}")
    set_property(GLOBAL PROPERTY _HU_HDRIMPORTS_${hk} "${imps}")
  endforeach()
  # Registry: header name / resolved path -> set (used by target_auto_header_units and header imports).
  foreach(h p IN ZIP_LISTS A_HEADERS rpaths)
    string(MD5 k "${h}")
    set_property(GLOBAL PROPERTY _HU_NAME_SET_${k} ${set})
    string(MD5 k "${p}")
    set_property(GLOBAL PROPERTY _HU_PATH_SET_${k} ${set})
  endforeach()

  get_property(sets GLOBAL PROPERTY _HU_SETS)
  if(NOT sets)
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _hu_finalize)
  endif()
  set_property(GLOBAL APPEND PROPERTY _HU_SETS ${set})
  set_property(GLOBAL PROPERTY _HU_SET_${set}_HEADERS "${A_HEADERS}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_PATHS "${rpaths}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_STD "${std}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_EXT "${ext}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_PIC "${pic}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_OPTS "${A_COMPILE_OPTIONS}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_MAPLINES "${maplines}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_CMIS "${cmis}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_MIDS "${mids}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_MMAPS "${mmaps}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_HMAPS "${hmaps}")
  set(msg "")
  foreach(h p IN ZIP_LISTS A_HEADERS rpaths)
    string(APPEND msg "\n     <${h}> -> ${p}")
  endforeach()
  message(STATUS "HeaderUnits: set '${set}' (${tc}, CXX_STANDARD ${std}, CXX_EXTENSIONS ${ext}):${msg}")
endfunction()

# ---------------------------------------------------------------------------------------------------------
function(target_import_header_units consumer set)
  cmake_parse_arguments(PARSE_ARGV 2 A "" "" "SOURCES")
  if(A_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "target_import_header_units(${consumer} ${set}): unexpected arguments: ${A_UNPARSED_ARGUMENTS}")
  endif()
  if(NOT TARGET ${consumer})
    message(FATAL_ERROR "target_import_header_units: '${consumer}' is not a target.")
  endif()
  get_property(sets GLOBAL PROPERTY _HU_SETS)
  if(NOT set IN_LIST sets)
    message(FATAL_ERROR "target_import_header_units(${consumer} ${set}): '${set}' is not a header-unit set (add_header_units).")
  endif()
  # (never name a variable "n": if(NOT n) tests the boolean constant N, not the variable)
  get_property(cnt GLOBAL PROPERTY _HU_REQ_COUNT)
  if(NOT cnt)
    set(cnt 0)
  endif()
  math(EXPR cnt "${cnt} + 1")
  set_property(GLOBAL PROPERTY _HU_REQ_COUNT ${cnt})
  set_property(GLOBAL PROPERTY _HU_REQ_${cnt}_TARGET ${consumer})
  set_property(GLOBAL PROPERTY _HU_REQ_${cnt}_SET ${set})
  if(DEFINED A_SOURCES)
    set(abs)
    foreach(s IN LISTS A_SOURCES)
      cmake_path(ABSOLUTE_PATH s BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE OUTPUT_VARIABLE a)
      list(APPEND abs "${a}")
    endforeach()
    set_property(GLOBAL PROPERTY _HU_REQ_${cnt}_SOURCES "${abs}")
    set_property(GLOBAL PROPERTY _HU_REQ_${cnt}_ALL OFF)
  else()
    set_property(GLOBAL PROPERTY _HU_REQ_${cnt}_ALL ON)
  endif()
endfunction()

# All C++ sources of a target, as absolute paths (SOURCES + CXX_MODULES file sets).
# target_auto_header_units(<target> [LINK_LIBRARIES ...] [INCLUDE_DIRECTORIES ...] [COMPILE_DEFINITIONS ...]
#                          [COMPILE_OPTIONS ...] [CXX_STANDARD <n>] [CXX_EXTENSIONS <bool>] [EXCLUDE <name>...]
#                          [NO_RECONFIGURE])
# Scans the target's C++ sources (call it after the sources and target_link_libraries are set) for
# "import <x>;" / "import \"x\";" and makes every imported header a header unit of the target:
#   * headers that already belong to a set (any target's) are reused;
#   * the rest go into a new set <target>_hu, built with the target's direct LINK_LIBRARIES (targets only),
#     INCLUDE_DIRECTORIES and COMPILE_DEFINITIONS (plain values and $<BUILD_INTERFACE:...>), plus the given ones;
#   * "x" found next to the importing source is used by absolute path (like the compiler's quote lookup);
#   * with HU_ALLOW_HEADER_IMPORTS ON, headers imported by those headers are added too (recursively).
# The scanned sources become CMAKE_CONFIGURE_DEPENDS (a new import re-runs CMake) unless NO_RECONFIGURE.
function(target_auto_header_units tgt)
  cmake_parse_arguments(PARSE_ARGV 1 A "NO_RECONFIGURE" "CXX_STANDARD;CXX_EXTENSIONS"
    "LINK_LIBRARIES;INCLUDE_DIRECTORIES;COMPILE_DEFINITIONS;COMPILE_OPTIONS;EXCLUDE")
  if(A_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "target_auto_header_units(${tgt}): unexpected arguments: ${A_UNPARSED_ARGUMENTS}")
  endif()
  if(NOT TARGET ${tgt})
    message(FATAL_ERROR "target_auto_header_units: '${tgt}' is not a target.")
  endif()
  get_target_property(sdir ${tgt} SOURCE_DIR)
  get_target_property(srcs ${tgt} SOURCES)
  if(NOT srcs)
    set(srcs)
  endif()
  get_target_property(msets ${tgt} CXX_MODULE_SETS)
  if(msets)
    foreach(ms IN LISTS msets)
      get_target_property(mf ${tgt} CXX_MODULE_SET_${ms})
      if(mf)
        list(APPEND srcs ${mf})
      endif()
    endforeach()
  endif()
  set(names)
  set(files)
  foreach(s IN LISTS srcs)
    if(s MATCHES "\\$<" OR NOT s MATCHES "\\.(cpp|cc|cxx|c\\+\\+|C|cppm|ccm|cxxm|c\\+\\+m|ixx|mpp)$")
      continue()
    endif()
    if(NOT IS_ABSOLUTE "${s}")
      set(s "${sdir}/${s}")
    endif()
    cmake_path(NORMAL_PATH s)
    if(NOT EXISTS "${s}")
      continue()
    endif()
    list(APPEND files "${s}")
    _hu_scan_imports(imps "${s}")
    get_filename_component(d "${s}" DIRECTORY)
    foreach(e IN LISTS imps)
      _hu_import_name(n "${e}" "${d}")
      list(APPEND names "${n}")
    endforeach()
  endforeach()
  if(files AND NOT A_NO_RECONFIGURE)
    set_property(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${files})
  endif()
  if(names)
    list(REMOVE_DUPLICATES names)
  endif()
  if(A_EXCLUDE AND names)
    list(REMOVE_ITEM names ${A_EXCLUDE})
  endif()
  if(NOT names)
    message(STATUS "HeaderUnits: target_auto_header_units(${tgt}): no header-unit imports found.")
    return()
  endif()

  # Flags for a new set: the target's own usage context.
  set(libs ${A_LINK_LIBRARIES})
  get_target_property(ll ${tgt} LINK_LIBRARIES)
  if(ll)
    foreach(l IN LISTS ll)
      if(NOT l MATCHES "\\$<" AND TARGET "${l}")
        list(APPEND libs "${l}")
      endif()
    endforeach()
  endif()
  set(incs ${A_INCLUDE_DIRECTORIES})
  get_target_property(ti ${tgt} INCLUDE_DIRECTORIES)
  if(ti)
    foreach(i IN LISTS ti)
      if(i MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
        set(i "${CMAKE_MATCH_1}")
      endif()
      if(NOT i MATCHES "\\$<")
        list(APPEND incs "${i}")
      endif()
    endforeach()
  endif()
  set(defs ${A_COMPILE_DEFINITIONS})
  get_target_property(td ${tgt} COMPILE_DEFINITIONS)
  if(td)
    foreach(d IN LISTS td)
      if(NOT d MATCHES "\\$<")
        list(APPEND defs "${d}")
      endif()
    endforeach()
  endif()
  set(stdargs)
  if(DEFINED A_CXX_STANDARD)
    list(APPEND stdargs CXX_STANDARD ${A_CXX_STANDARD})
  else()
    get_target_property(tstd ${tgt} CXX_STANDARD)
    if(tstd)
      list(APPEND stdargs CXX_STANDARD ${tstd})
    endif()
  endif()
  if(DEFINED A_CXX_EXTENSIONS)
    list(APPEND stdargs CXX_EXTENSIONS ${A_CXX_EXTENSIONS})
  else()
    get_target_property(text ${tgt} CXX_EXTENSIONS)
    if(NOT text STREQUAL "text-NOTFOUND")
      list(APPEND stdargs CXX_EXTENSIONS ${text})
    endif()
  endif()

  set(used)
  set(todo ${names})
  while(todo)
    set(fresh)
    foreach(n IN LISTS todo)
      string(MD5 k "${n}")
      get_property(s GLOBAL PROPERTY _HU_NAME_SET_${k})
      if(NOT s AND IS_ABSOLUTE "${n}")
        get_property(s GLOBAL PROPERTY _HU_PATH_SET_${k})
      endif()
      if(s)
        list(APPEND used ${s})
      else()
        list(APPEND fresh "${n}")
      endif()
    endforeach()
    if(NOT fresh)
      break()
    endif()
    set(sn "${tgt}_hu")
    set(i 2)
    while(TARGET ${sn})
      set(sn "${tgt}_hu_${i}")
      math(EXPR i "${i} + 1")
    endwhile()
    add_header_units(${sn} HEADERS ${fresh} LINK_LIBRARIES ${libs} INCLUDE_DIRECTORIES ${incs}
                     COMPILE_DEFINITIONS ${defs} COMPILE_OPTIONS ${A_COMPILE_OPTIONS} ${stdargs})
    list(APPEND used ${sn})
    set(todo)
    if(HU_ALLOW_HEADER_IMPORTS)
      get_property(ps GLOBAL PROPERTY _HU_SET_${sn}_PATHS)
      foreach(p IN LISTS ps)
        string(MD5 hk "${p}")
        get_property(imps GLOBAL PROPERTY _HU_HDRIMPORTS_${hk})
        get_filename_component(d "${p}" DIRECTORY)
        foreach(e IN LISTS imps)
          _hu_import_name(n "${e}" "${d}")
          list(APPEND todo "${n}")
        endforeach()
      endforeach()
      if(todo)
        list(REMOVE_DUPLICATES todo)
      endif()
    endif()
  endwhile()
  list(REMOVE_DUPLICATES used)
  foreach(s IN LISTS used)
    target_import_header_units(${tgt} ${s})
  endforeach()
  string(JOIN ", " ul ${used})
  message(STATUS "HeaderUnits: target_auto_header_units(${tgt}): ${ul}")
endfunction()

function(_hu_target_cxx_sources out tgt)
  get_target_property(sdir ${tgt} SOURCE_DIR)
  get_target_property(bdir ${tgt} BINARY_DIR)
  get_target_property(srcs ${tgt} SOURCES)
  if(NOT srcs)
    set(srcs)
  endif()
  get_target_property(msets ${tgt} CXX_MODULE_SETS)
  if(msets)
    foreach(ms IN LISTS msets)
      if(ms STREQUAL "CXX_MODULES")
        get_target_property(f ${tgt} CXX_MODULE_SET)
      else()
        get_target_property(f ${tgt} CXX_MODULE_SET_${ms})
      endif()
      if(f)
        list(APPEND srcs ${f})
      endif()
    endforeach()
  endif()
  set(res)
  foreach(s IN LISTS srcs)
    if(s MATCHES "\\$<")
      message(FATAL_ERROR "target_import_header_units(${tgt}): source '${s}' is a generator expression; list the sources with SOURCES.")
    endif()
    if(NOT s MATCHES "\\.(cpp|cc|cxx|c\\+\\+|C|cppm|ixx|mpp|cxxm|ccm|c\\+\\+m)$")
      continue()
    endif()
    if(IS_ABSOLUTE "${s}")
      set(a "${s}")
    elseif(EXISTS "${sdir}/${s}")
      set(a "${sdir}/${s}")
    else()
      set(a "${bdir}/${s}")
    endif()
    cmake_path(NORMAL_PATH a)
    list(APPEND res "${a}")
  endforeach()
  list(REMOVE_DUPLICATES res)
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

function(_hu_check_compat consumer set)
  get_property(std GLOBAL PROPERTY _HU_SET_${set}_STD)
  get_property(ext GLOBAL PROPERTY _HU_SET_${set}_EXT)
  get_property(sdir GLOBAL PROPERTY _HU_SET_${set}_DIR)
  get_target_property(cstd ${consumer} CXX_STANDARD)
  get_target_property(cext ${consumer} CXX_EXTENSIONS)
  if(cext STREQUAL "cext-NOTFOUND")
    set(cext "${CMAKE_CXX_EXTENSIONS_DEFAULT}")
  endif()
  _hu_bool(cext "${cext}")
  set(why "")
  if(NOT cstd STREQUAL std)
    string(APPEND why "\n  consumer CXX_STANDARD='${cstd}' but the set was built with CXX_STANDARD=${std}")
  endif()
  if(NOT cext STREQUAL ext)
    string(APPEND why "\n  consumer CXX_EXTENSIONS=${cext} but the set uses CXX_EXTENSIONS=${ext} (-std=c++NN vs -std=gnu++NN)")
  endif()
  get_target_property(feats ${consumer} COMPILE_FEATURES)
  foreach(f IN LISTS feats)
    if(f MATCHES "^cxx_std_([0-9]+)$" AND CMAKE_MATCH_1 GREATER std)
      string(APPEND why "\n  consumer requests compile feature ${f} (> c++${std})")
    endif()
  endforeach()
  get_target_property(opts ${consumer} COMPILE_OPTIONS)
  foreach(o IN LISTS opts)
    if(o MATCHES "^-std=|^/std:")
      string(APPEND why "\n  consumer has compile option '${o}'")
    endif()
  endforeach()
  # Exceptions / RTTI must match (both compilers reject a mismatch when the BMI is loaded).
  get_property(sopts GLOBAL PROPERTY _HU_SET_${set}_OPTS)
  set(a "")
  set(b "")
  foreach(o IN LISTS opts)
    if(o MATCHES "^-f(no-)?(exceptions|rtti)$")
      list(APPEND a "${o}")
    endif()
  endforeach()
  foreach(o IN LISTS sopts)
    if(o MATCHES "^-f(no-)?(exceptions|rtti)$")
      list(APPEND b "${o}")
    endif()
  endforeach()
  if(NOT "${a}" STREQUAL "${b}")
    string(APPEND why "\n  exceptions/RTTI options differ: consumer '${a}', set '${b}'")
  endif()
  # PIC: both compilers silently accept a mismatch; only predefined macros (__PIC__/__pic__) differ.
  get_property(spic GLOBAL PROPERTY _HU_SET_${set}_PIC)
  get_target_property(type ${consumer} TYPE)
  get_target_property(cpic ${consumer} POSITION_INDEPENDENT_CODE)
  if(type MATCHES "SHARED_LIBRARY|MODULE_LIBRARY")
    set(cpic ON)
  endif()
  _hu_bool(cpic "${cpic}")
  if(NOT cpic STREQUAL spic)
    message(WARNING "target_import_header_units(${consumer} ${set}): POSITION_INDEPENDENT_CODE is ${cpic} for the consumer "
      "but ${spic} for the set. GCC and Clang accept this silently; only __PIC__-dependent preprocessor branches in the "
      "headers could differ. Pass POSITION_INDEPENDENT_CODE to add_header_units() to match.")
  endif()
  get_target_property(cdir ${consumer} SOURCE_DIR)
  foreach(v CMAKE_CXX_FLAGS CMAKE_CXX_FLAGS_${CMAKE_BUILD_TYPE})
    get_directory_property(a DIRECTORY "${cdir}" DEFINITION ${v})
    get_directory_property(b DIRECTORY "${sdir}" DEFINITION ${v})
    if(NOT a STREQUAL b)
      string(APPEND why "\n  ${v} differs between the consumer's directory ('${a}') and the set's directory ('${b}')")
    endif()
  endforeach()
  get_property(tc GLOBAL PROPERTY _HU_TC)
  if(tc STREQUAL "GCC")
    get_property(flag GLOBAL PROPERTY _HU_GCC_MAP_FLAG)
    get_directory_property(a DIRECTORY "${cdir}" DEFINITION CMAKE_CXX_MODULE_MAP_FLAG)
    if(NOT a STREQUAL flag)
      string(APPEND why "\n  CMAKE_CXX_MODULE_MAP_FLAG in the consumer's directory is not the HeaderUnits override "
                        "(include(HeaderUnits) must run in the top-level CMakeLists.txt before add_subdirectory())")
    endif()
  endif()
  if(why)
    message(FATAL_ERROR "target_import_header_units(${consumer} ${set}): target '${consumer}' is incompatible with "
      "header-unit set '${set}':${why}\nA header unit must be compiled with exactly the consumer's language settings.")
  endif()
endfunction()

# Runs at the end of the top-level directory: all targets and their sources are known.
function(_hu_finalize)
  get_property(tc GLOBAL PROPERTY _HU_TC)
  get_property(hudir GLOBAL PROPERTY _HU_DIR)
  # Manifest for tools/tests: set|header name|resolved path|BMI
  get_property(sets GLOBAL PROPERTY _HU_SETS)
  set(manifest "")
  foreach(s IN LISTS sets)
    get_property(hs GLOBAL PROPERTY _HU_SET_${s}_HEADERS)
    get_property(ps GLOBAL PROPERTY _HU_SET_${s}_PATHS)
    get_property(bs GLOBAL PROPERTY _HU_SET_${s}_CMIS)
    foreach(h p b IN ZIP_LISTS hs ps bs)
      string(APPEND manifest "${s}|${h}|${p}|${b}\n")
    endforeach()
  endforeach()
  file(CONFIGURE OUTPUT "${hudir}/manifest.txt" CONTENT "${manifest}")

  # HU_ALLOW_HEADER_IMPORTS (experimental): a header unit whose header imports other header units is built after
  # them and sees them: Clang gets their module maps + named -fmodule-file, GCC gets them in the header's own
  # mapper.  The importing set records the imported sets, so its consumers receive them as well.
  foreach(s IN LISTS sets)
    get_property(hs GLOBAL PROPERTY _HU_SET_${s}_HEADERS)
    get_property(ps GLOBAL PROPERTY _HU_SET_${s}_PATHS)
    get_property(bs GLOBAL PROPERTY _HU_SET_${s}_CMIS)
    get_property(hm GLOBAL PROPERTY _HU_SET_${s}_HMAPS)
    set(i -1)
    foreach(h p b IN ZIP_LISTS hs ps bs)
      math(EXPR i "${i} + 1")
      string(MD5 hk "${p}")
      get_property(imps GLOBAL PROPERTY _HU_HDRIMPORTS_${hk})
      if(NOT imps)
        continue()
      endif()
      get_filename_component(d "${p}" DIRECTORY)
      set(opts)
      set(deps)
      set(maplines "${p} ${b}\n")
      foreach(e IN LISTS imps)
        _hu_import_name(n "${e}" "${d}")
        _hu_lookup(DEP "${n}")
        if(NOT DEP_SET)
          message(FATAL_ERROR "HeaderUnits: header <${h}> ('${p}', set ${s}) imports '${n}', which is not a header unit of any "
            "set. Declare it with add_header_units() (or let target_auto_header_units() discover it).")
        endif()
        if(DEP_PATH STREQUAL p)
          message(FATAL_ERROR "HeaderUnits: header <${h}> imports itself.")
        endif()
        if(NOT DEP_SET STREQUAL s)
          get_property(cur GLOBAL PROPERTY _HU_SET_${s}_DEPSETS)
          if(NOT DEP_SET IN_LIST cur)
            set_property(GLOBAL APPEND PROPERTY _HU_SET_${s}_DEPSETS ${DEP_SET})
          endif()
        endif()
        list(APPEND deps "${DEP_BMI}")
        if(tc STREQUAL "GCC")
          string(APPEND maplines "${DEP_PATH} ${DEP_BMI}\n")
        else()
          file(RELATIVE_PATH rb "${CMAKE_BINARY_DIR}" "${DEP_BMI}")
          list(APPEND opts "-fmodule-map-file=${DEP_MAP}" "-fmodule-file=${DEP_MID}=${rb}")
        endif()
      endforeach()
      if(tc STREQUAL "GCC")
        list(GET hm ${i} hmap)
        file(CONFIGURE OUTPUT "${hmap}" CONTENT "${maplines}")
      else()
        list(APPEND opts "-fmodule-file-deps" "-Wno-experimental-header-units")
      endif()
      get_property(sdir GLOBAL PROPERTY _HU_SET_${s}_DIR)
      set_property(SOURCE "${p}" TARGET_DIRECTORY ${s} APPEND PROPERTY COMPILE_OPTIONS ${opts})
      set_property(SOURCE "${p}" TARGET_DIRECTORY ${s} APPEND PROPERTY OBJECT_DEPENDS ${deps})
    endforeach()
  endforeach()
  get_property(cnt GLOBAL PROPERTY _HU_REQ_COUNT)
  if(NOT cnt)
    return()
  endif()
  foreach(i RANGE 1 ${cnt})
    get_property(t GLOBAL PROPERTY _HU_REQ_${i}_TARGET)
    get_property(s GLOBAL PROPERTY _HU_REQ_${i}_SET)
    get_property(all GLOBAL PROPERTY _HU_REQ_${i}_ALL)
    _hu_check_compat(${t} ${s})
    if(all)
      _hu_target_cxx_sources(srcs ${t})
    else()
      get_property(srcs GLOBAL PROPERTY _HU_REQ_${i}_SOURCES)
      _hu_target_cxx_sources(tsrcs ${t})
      foreach(src IN LISTS srcs)
        if(NOT src IN_LIST tsrcs)
          message(FATAL_ERROR "target_import_header_units(${t} ${s}): '${src}' is not a C++ source of target '${t}'.")
        endif()
      endforeach()
    endif()
    _hu_set_closure(sclos ${s})
    foreach(src IN LISTS srcs)
      string(MD5 k "${t}|${src}")
      get_property(known GLOBAL PROPERTY _HU_TU_${k}_SETS SET)
      if(NOT known)
        set_property(GLOBAL APPEND PROPERTY _HU_TUS "${t}|${src}")
      endif()
      set_property(GLOBAL APPEND PROPERTY _HU_TU_${k}_SETS ${sclos})
    endforeach()
    foreach(cs IN LISTS sclos)
      add_dependencies(${t} ${cs}_ready)
    endforeach()
  endforeach()

  get_property(tus GLOBAL PROPERTY _HU_TUS)
  foreach(tu IN LISTS tus)
    string(FIND "${tu}" "|" bar)
    string(SUBSTRING "${tu}" 0 ${bar} t)
    math(EXPR bar "${bar} + 1")
    string(SUBSTRING "${tu}" ${bar} -1 src)
    string(MD5 k "${tu}")
    get_property(tsets GLOBAL PROPERTY _HU_TU_${k}_SETS)
    list(REMOVE_DUPLICATES tsets)
    list(SORT tsets)
    # One source file -> one set list (source properties are per directory; GCC's map is per source path).
    string(MD5 sk "${src}")
    get_property(prev GLOBAL PROPERTY _HU_SRC_${sk})
    if(prev AND NOT prev STREQUAL "${tsets}")
      message(FATAL_ERROR "target_import_header_units: source '${src}' is used by several targets with different "
        "header-unit sets ('${prev}' vs '${tsets}'). Not supported.")
    endif()
    set_property(GLOBAL PROPERTY _HU_SRC_${sk} "${tsets}")
    if(prev)
      continue()
    endif()
    # A TU must not receive two header units of the same header.
    set(seen)
    foreach(s IN LISTS tsets)
      get_property(ps GLOBAL PROPERTY _HU_SET_${s}_PATHS)
      foreach(p IN LISTS ps)
        if(p IN_LIST seen)
          message(FATAL_ERROR "target_import_header_units(${t}): source '${src}' would get two header units for '${p}' (sets ${tsets}).")
        endif()
        list(APPEND seen "${p}")
      endforeach()
    endforeach()

    set(opts)
    set(deps)
    if(tc STREQUAL "GCC")
      if(src MATCHES "[ \t]")
        message(FATAL_ERROR "target_import_header_units(${t}): source path '${src}' contains a space; GCC's mapper cannot express it.")
      endif()
      get_property(srv GLOBAL PROPERTY _HU_GCC_SERVER)
      set(content "")
      foreach(s IN LISTS tsets)
        get_property(ml GLOBAL PROPERTY _HU_SET_${s}_MAPLINES)
        get_property(c GLOBAL PROPERTY _HU_SET_${s}_CMIS)
        string(APPEND content "${ml}")
        list(APPEND deps ${c})
      endforeach()
      set(smap "${hudir}/src${src}.map")
      file(CONFIGURE OUTPUT "${smap}" CONTENT "${content}")
      # CMAKE-INTERNAL (observed): CMake's GCC scan rule passes no -fmodule-mapper of its own.
      # Dependency scan: this option lets the scan see the header
      # units (GCC must load them for their macros).  -f: unknown (named) modules get fallback names instead
      # of an error; the scan never reads named-module CMIs.  In the compile command this option is
      # overridden by the later mapper of CMAKE_CXX_MODULE_MAP_FLAG (gcc-mapper.sh serving the same map).
      list(APPEND opts "-fmodule-mapper=|${srv} -f - ${smap}")
    else()
      foreach(s IN LISTS tsets)
        get_property(pcms GLOBAL PROPERTY _HU_SET_${s}_CMIS)
        get_property(mids GLOBAL PROPERTY _HU_SET_${s}_MIDS)
        get_property(mmaps GLOBAL PROPERTY _HU_SET_${s}_MMAPS)
        foreach(pcm mid mmap IN ZIP_LISTS pcms mids mmaps)
          # Spell the PCM relative to the top build dir (Ninja's cwd and node names): -fmodule-file-deps writes it
          # into the depfile as spelled, and an absolute spelling would be a different Ninja node (consumers would
          # only rebuild on the NEXT ninja run after a header edit).
          file(RELATIVE_PATH rpcm "${CMAKE_BINARY_DIR}" "${pcm}")
          list(APPEND opts "-fmodule-map-file=${mmap}" "-fmodule-file=${mid}=${rpcm}")
        endforeach()
        list(APPEND deps ${pcms})
      endforeach()
      list(APPEND opts "-fmodule-file-deps" "-Wno-experimental-header-units" "-Wno-ambiguous-macro")
    endif()
    # CMAKE-INTERNAL (observed Ninja-generator behaviour, not documented): per-source COMPILE_OPTIONS and
    # OBJECT_DEPENDS are applied to the dependency-SCAN statement of the source as well as to its compile
    # statement.  That is what orders the BMI builds before the scan; tests/run_suite.cmake verifies it in
    # build.ninja for every consumer.  (add_dependencies() alone does NOT order object compilation in Ninja.)
    set_property(SOURCE "${src}" TARGET_DIRECTORY ${t} APPEND PROPERTY COMPILE_OPTIONS ${opts})
    set_property(SOURCE "${src}" TARGET_DIRECTORY ${t} APPEND PROPERTY OBJECT_DEPENDS ${deps})
    set_property(SOURCE "${src}" TARGET_DIRECTORY ${t} PROPERTY CXX_SCAN_FOR_MODULES ON)
  endforeach()
endfunction()
