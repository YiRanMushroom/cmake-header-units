# HeaderUnits/Common.cmake -- toolchain-independent helpers: header lookup, import scanning, the set registry,
# usage-requirement collection, and the consumer/set compatibility check.

include_guard(GLOBAL)

# ---------------------------------------------------------------------------------------------------------
# Header lookup: <name> -> the file the compiler opens for "#include <name>" with a set's flags.  The compiler
# reports its search list for those flags ("<compiler> <flags> -x c++ -E -v": the "#include <...> search starts
# here:" list, -I directories first, then -isystem ones, then its own), and the first directory holding <name> is the
# file.  One cheap compiler run per distinct set of flags (shared within the configure run); nothing is compiled.
#
# The search list for CMAKE_CXX_FLAGS (and the build type's), sysroot / target / external toolchain, INCS as -I,
# SYSINCS as -isystem (imported targets and SYSTEM directories, as CMake passes them) and OPTS ("SHELL:" items
# split).  Directories come out normalized (forward slashes, no "." / ".."), the spelling used for header paths; a
# directory the compiler spells otherwise (an -I directory given with "..") is also recorded with its spelling
# (_HU_RAWDIRS_<md5 of the normalized directory>).
function(_hu_search_dirs out)
  cmake_parse_arguments(PARSE_ARGV 1 A "" "" "INCS;SYSINCS;OPTS")
  separate_arguments(args NATIVE_COMMAND "${CMAKE_CXX_FLAGS}")
  if(CMAKE_BUILD_TYPE)
    string(TOUPPER "${CMAKE_BUILD_TYPE}" cfg)
    separate_arguments(cf NATIVE_COMMAND "${CMAKE_CXX_FLAGS_${cfg}}")
    list(APPEND args ${cf})
  endif()
  if(CMAKE_SYSROOT AND CMAKE_CXX_COMPILE_OPTIONS_SYSROOT)
    list(APPEND args "${CMAKE_CXX_COMPILE_OPTIONS_SYSROOT}${CMAKE_SYSROOT}")
  endif()
  if(CMAKE_CXX_COMPILER_TARGET AND CMAKE_CXX_COMPILE_OPTIONS_TARGET)
    list(APPEND args "${CMAKE_CXX_COMPILE_OPTIONS_TARGET}${CMAKE_CXX_COMPILER_TARGET}")
  endif()
  if(CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN AND CMAKE_CXX_COMPILE_OPTIONS_EXTERNAL_TOOLCHAIN)
    list(APPEND args "${CMAKE_CXX_COMPILE_OPTIONS_EXTERNAL_TOOLCHAIN}${CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN}")
  endif()
  foreach(d IN LISTS A_INCS)
    list(APPEND args "-I${d}")
  endforeach()
  foreach(d IN LISTS A_SYSINCS)
    list(APPEND args -isystem "${d}")
  endforeach()
  foreach(o IN LISTS A_OPTS)
    if(o MATCHES "^SHELL:(.*)$")
      separate_arguments(so UNIX_COMMAND "${CMAKE_MATCH_1}")
      list(APPEND args ${so})
    else()
      list(APPEND args "${o}")
    endif()
  endforeach()
  string(MD5 k "${args}")
  get_property(have GLOBAL PROPERTY _HU_SEARCH_${k} SET)
  if(NOT have)
    get_property(hudir GLOBAL PROPERTY _HU_DIR)
    set(f "${hudir}/probe/empty.cpp")
    if(NOT EXISTS "${f}")
      file(WRITE "${f}" "")
    endif()
    execute_process(COMMAND "${CMAKE_CXX_COMPILER}" ${args} -x c++ -E -v "${f}"
                    OUTPUT_QUIET ERROR_VARIABLE err RESULT_VARIABLE rc)
    string(REPLACE "\r" "" err "${err}")
    set(raw "${err}")
    string(REPLACE ";" "\\;" err "${err}")
    string(REPLACE "\n" ";" lines "${err}")
    set(dirs)
    set(in FALSE)
    foreach(l IN LISTS lines)
      if(l MATCHES "^#include <\\.\\.\\.> search starts here")
        set(in TRUE)
      elseif(l MATCHES "^End of search list")
        break()
      elseif(in AND l MATCHES "^ +(.+)$")
        string(REGEX REPLACE " \\(framework directory\\)$" "" d "${CMAKE_MATCH_1}")
        file(TO_CMAKE_PATH "${d}" raw)
        string(REGEX REPLACE "(.)/$" "\\1" raw "${raw}")
        set(d "${raw}")
        cmake_path(NORMAL_PATH d)
        string(REGEX REPLACE "(.)/$" "\\1" d "${d}")
        list(APPEND dirs "${d}")
        if(NOT raw STREQUAL d)
          # the compiler's own spelling of the directory (GCC on Linux names a header found there by it): kept for
          # the GCC mapper keys
          string(MD5 dk "${d}")
          get_property(raws GLOBAL PROPERTY _HU_RAWDIRS_${dk})
          if(NOT raw IN_LIST raws)
            set_property(GLOBAL APPEND PROPERTY _HU_RAWDIRS_${dk} "${raw}")
          endif()
        endif()
      endif()
    endforeach()
    if(NOT rc EQUAL 0 OR NOT dirs)
      string(JOIN " " shown ${args})
      message(FATAL_ERROR "HeaderUnits: no include search list from '${CMAKE_CXX_COMPILER} ${shown} -x c++ -E -v' "
        "(exit ${rc}):\n${raw}")
    endif()
    list(REMOVE_DUPLICATES dirs)
    set_property(GLOBAL PROPERTY _HU_SEARCH_${k} "${dirs}")
  endif()
  get_property(v GLOBAL PROPERTY _HU_SEARCH_${k})
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# The search list of a set or a target's auto request: INCS, OPTS and the usage requirements of LIBS.
function(_hu_set_search_dirs out)
  cmake_parse_arguments(PARSE_ARGV 1 A "" "" "INCS;LIBS;OPTS")
  _hu_collect_usage(U ${A_LIBS})
  _hu_search_dirs(d INCS ${A_INCS} ${U_INCS} SYSINCS ${U_SYSINCS} OPTS ${A_OPTS} ${U_OPTS})
  set(${out} "${d}" PARENT_SCOPE)
endfunction()

function(_hu_bool out v)
  if(v)
    set(${out} ON PARENT_SCOPE)
  else()
    set(${out} OFF PARENT_SCOPE)
  endif()
endfunction()

# ---------------------------------------------------------------------------------------------------------
# Header-unit import declarations in a file ("import <x>;", "import \"x\";", optionally exported), as a list of
# "a|<name>" (angle) and "q|<name>" (quote).  Imports produced by macros or hidden in #if are not considered.
function(_hu_scan_imports out file)
  set(r)
  file(STRINGS "${file}" ls REGEX "^[ \t]*(export[ \t]+)?import[ \t]*[<\"][^>\"]+[>\"][ \t]*;")
  foreach(l IN LISTS ls)
    if(l MATCHES "import[ \t]*<([^>]+)>")
      list(APPEND r "a|${CMAKE_MATCH_1}")
    elseif(l MATCHES "import[ \t]*\"([^\"]+)\"")
      list(APPEND r "q|${CMAKE_MATCH_1}")
    endif()
  endforeach()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# <name> in a search list (_hu_search_dirs): the first directory holding it, "" if none.  An absolute name stands for
# itself.  The result is normalized, like the directories.
function(_hu_find_header out name)
  set(r "")
  if(IS_ABSOLUTE "${name}")
    if(EXISTS "${name}" AND NOT IS_DIRECTORY "${name}")
      set(r "${name}")
    endif()
  else()
    foreach(d IN LISTS ARGN)
      if(EXISTS "${d}/${name}" AND NOT IS_DIRECTORY "${d}/${name}")
        set(r "${d}/${name}")
        break()
      endif()
    endforeach()
  endif()
  if(r)
    cmake_path(NORMAL_PATH r)
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# Header unit lookup by import name (angle name, or absolute path for a quote import found next to the importer):
# outputs set, resolved path, BMI, (Clang) module name and module map; set is "" if no set provides it.
function(_hu_lookup prefix name)
  string(MD5 k "${name}")
  get_property(t GLOBAL PROPERTY _HU_NAME_SET_${k})
  if(NOT t AND IS_ABSOLUTE "${name}")
    get_property(t GLOBAL PROPERTY _HU_PATH_SET_${k})
  endif()
  set(${prefix}_SET "${t}" PARENT_SCOPE)
  if(NOT t)
    return()
  endif()
  get_property(hs GLOBAL PROPERTY _HU_SET_${t}_HEADERS)
  get_property(ps GLOBAL PROPERTY _HU_SET_${t}_PATHS)
  get_property(bs GLOBAL PROPERTY _HU_SET_${t}_CMIS)
  get_property(ms GLOBAL PROPERTY _HU_SET_${t}_MIDS)
  get_property(mm GLOBAL PROPERTY _HU_SET_${t}_MMAPS)
  list(FIND hs "${name}" idx)
  if(idx LESS 0)
    list(FIND ps "${name}" idx)
  endif()
  list(GET ps ${idx} p)
  list(GET bs ${idx} b)
  set(${prefix}_PATH "${p}" PARENT_SCOPE)
  set(${prefix}_BMI "${b}" PARENT_SCOPE)
  if(ms)
    list(GET ms ${idx} m)
    list(GET mm ${idx} mp)
    set(${prefix}_MID "${m}" PARENT_SCOPE)
    set(${prefix}_MAP "${mp}" PARENT_SCOPE)
  endif()
endfunction()

# Set plus the sets its header units import, transitively.
function(_hu_set_closure out s)
  set(r "${s}")
  set(todo "${s}")
  while(todo)
    list(POP_FRONT todo x)
    get_property(ds GLOBAL PROPERTY _HU_SET_${x}_DEPSETS)
    foreach(d IN LISTS ds)
      if(NOT d IN_LIST r)
        list(APPEND r "${d}")
        list(APPEND todo "${d}")
      endif()
    endforeach()
  endwhile()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# "a|x" -> x ; "q|x" -> the normalized absolute path if x exists relative to <dir> (quote lookup), else x.
function(_hu_import_name out entry dir)
  string(SUBSTRING "${entry}" 2 -1 n)
  if(entry MATCHES "^q\\|" AND NOT IS_ABSOLUTE "${n}" AND EXISTS "${dir}/${n}")
    set(n "${dir}/${n}")
    cmake_path(NORMAL_PATH n)
  endif()
  set(${out} "${n}" PARENT_SCOPE)
endfunction()

# Usage requirements of LINK_LIBRARIES for the header lookup, following INTERFACE_LINK_LIBRARIES recursively: ALIAS
# resolved, $<LINK_ONLY:...> (private dependencies of static libraries) and cross-directory markers (::@...) skipped,
# $<BUILD_INTERFACE:x> -> x, $<INSTALL_INTERFACE:...> dropped.  Other generator expressions cannot be evaluated at
# configure time and are skipped (VERBOSE message); a header found only through such a directory is then not found
# (pass the directory with INCLUDE_DIRECTORIES).  Include directories as CMake passes them to a consumer: those of
# IMPORTED targets (unless SYSTEM is OFF), of SYSTEM targets and INTERFACE_SYSTEM_INCLUDE_DIRECTORIES as -isystem
# (<prefix>_SYSINCS), the others as -I (<prefix>_INCS).  Also <prefix>_DEFS, <prefix>_OPTS (INTERFACE_COMPILE_OPTIONS)
# and <prefix>_FEATS.
function(_hu_collect_usage prefix)
  set(incs)
  set(sysincs)
  set(defs)
  set(opts)
  set(feats)
  set(seen)
  set(todo ${ARGN})
  while(todo)
    list(POP_FRONT todo l)
    if(l MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
      set(l "${CMAKE_MATCH_1}")
    endif()
    if(l STREQUAL "" OR l MATCHES "^::@" OR l MATCHES "\\$<")
      if(l MATCHES "\\$<" AND NOT l MATCHES "^\\$<(LINK_ONLY|INSTALL_INTERFACE):")
        message(VERBOSE "HeaderUnits: the header lookup skips link item '${l}'")
      endif()
      continue()
    endif()
    if(NOT TARGET "${l}")
      continue()            # a plain library: no usage requirements
    endif()
    get_target_property(al "${l}" ALIASED_TARGET)
    if(al)
      set(l "${al}")
    endif()
    if(l IN_LIST seen)
      continue()
    endif()
    list(APPEND seen "${l}")
    get_target_property(imp "${l}" IMPORTED)
    get_target_property(sys "${l}" SYSTEM)
    if(imp AND sys STREQUAL "sys-NOTFOUND")
      set(sys ON)           # IMPORTED targets are SYSTEM unless set otherwise
    endif()
    get_target_property(sysdirs "${l}" INTERFACE_SYSTEM_INCLUDE_DIRECTORIES)
    if(NOT sysdirs)
      set(sysdirs)
    endif()
    foreach(prop INTERFACE_INCLUDE_DIRECTORIES INTERFACE_COMPILE_DEFINITIONS INTERFACE_COMPILE_OPTIONS INTERFACE_COMPILE_FEATURES)
      get_target_property(vals "${l}" ${prop})
      if(NOT vals)
        continue()
      endif()
      foreach(v IN LISTS vals)
        if(v MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
          set(v "${CMAKE_MATCH_1}")
        endif()
        if(v STREQUAL "" OR v MATCHES "\\$<")
          if(v MATCHES "\\$<" AND NOT v MATCHES "^\\$<INSTALL_INTERFACE:")
            message(VERBOSE "HeaderUnits: the header lookup skips ${prop} item '${v}' of ${l}")
          endif()
          continue()
        endif()
        if(prop STREQUAL "INTERFACE_INCLUDE_DIRECTORIES")
          if(sys OR v IN_LIST sysdirs)
            list(APPEND sysincs "${v}")
          else()
            list(APPEND incs "${v}")
          endif()
        elseif(prop STREQUAL "INTERFACE_COMPILE_DEFINITIONS")
          list(APPEND defs "${v}")
        elseif(prop STREQUAL "INTERFACE_COMPILE_OPTIONS")
          list(APPEND opts "${v}")
        else()
          list(APPEND feats "${v}")
        endif()
      endforeach()
    endforeach()
    get_target_property(ill "${l}" INTERFACE_LINK_LIBRARIES)
    if(ill)
      list(APPEND todo ${ill})
    endif()
  endwhile()
  foreach(v incs sysincs defs feats)
    if(${v})
      list(REMOVE_DUPLICATES ${v})
    endif()
  endforeach()
  foreach(v INCS SYSINCS DEFS OPTS FEATS)
    string(TOLOWER "${v}" lv)
    set(${prefix}_${v} "${${lv}}" PARENT_SCOPE)
  endforeach()
endfunction()

# All C++ sources of a target, as absolute paths (SOURCES + CXX_MODULES file sets).
function(_hu_target_cxx_sources out tgt)
  get_target_property(sdir ${tgt} SOURCE_DIR)
  get_target_property(bdir ${tgt} BINARY_DIR)
  get_target_property(srcs ${tgt} SOURCES)
  if(NOT srcs)
    set(srcs)
  endif()
  get_target_property(msets ${tgt} CXX_MODULE_SETS)
  if(msets)
    foreach(ms IN LISTS msets)
      if(ms STREQUAL "CXX_MODULES")
        get_target_property(f ${tgt} CXX_MODULE_SET)
      else()
        get_target_property(f ${tgt} CXX_MODULE_SET_${ms})
      endif()
      if(f)
        list(APPEND srcs ${f})
      endif()
    endforeach()
  endif()
  set(res)
  foreach(s IN LISTS srcs)
    if(s MATCHES "\\$<")
      message(FATAL_ERROR "target_import_header_units(${tgt}): source '${s}' is a generator expression; list the sources with SOURCES.")
    endif()
    if(NOT s MATCHES "\\.(cpp|cc|cxx|c\\+\\+|C|cppm|ixx|mpp|cxxm|ccm|c\\+\\+m)$")
      continue()
    endif()
    if(IS_ABSOLUTE "${s}")
      set(a "${s}")
    elseif(EXISTS "${sdir}/${s}")
      set(a "${sdir}/${s}")
    else()
      set(a "${bdir}/${s}")
    endif()
    cmake_path(NORMAL_PATH a)
    list(APPEND res "${a}")
  endforeach()
  list(REMOVE_DUPLICATES res)
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

function(_hu_check_compat consumer set)
  get_property(std GLOBAL PROPERTY _HU_SET_${set}_STD)
  get_property(ext GLOBAL PROPERTY _HU_SET_${set}_EXT)
  get_property(sdir GLOBAL PROPERTY _HU_SET_${set}_DIR)
  # The consumer's effective standard: CXX_STANDARD, or the compiler default when it is unset, raised by compile
  # features (its own and those of its link interface), as CMake picks the -std flag.  E.g. a target with only
  # target_compile_features(cxx_std_20) gets no -std flag on GCC 16, whose default is already C++20.
  get_target_property(cstd ${consumer} CXX_STANDARD)
  if(NOT cstd)
    set(cstd "${CMAKE_CXX_STANDARD_DEFAULT}")
  endif()
  get_target_property(feats ${consumer} COMPILE_FEATURES)
  if(NOT feats)
    set(feats)
  endif()
  get_target_property(cll ${consumer} LINK_LIBRARIES)
  if(cll)
    _hu_collect_usage(CU ${cll})
    list(APPEND feats ${CU_FEATS})
  endif()
  set(cfeat "")
  foreach(f IN LISTS feats)
    if(f MATCHES "^cxx_std_([0-9]+)$" AND CMAKE_MATCH_1 GREATER cstd)
      set(cstd "${CMAKE_MATCH_1}")
      set(cfeat " (raised by compile feature ${f})")
    endif()
  endforeach()
  get_target_property(cext ${consumer} CXX_EXTENSIONS)
  if(cext STREQUAL "cext-NOTFOUND")
    set(cext "${CMAKE_CXX_EXTENSIONS_DEFAULT}")
  endif()
  _hu_bool(cext "${cext}")
  set(why "")
  if(NOT cstd STREQUAL std)
    string(APPEND why "\n  consumer's C++ standard is C++${cstd}${cfeat} (CXX_STANDARD, else the compiler default) but the set was built with CXX_STANDARD=${std}")
  endif()
  if(NOT cext STREQUAL ext)
    string(APPEND why "\n  consumer CXX_EXTENSIONS=${cext} but the set uses CXX_EXTENSIONS=${ext} (-std=c++NN vs -std=gnu++NN)")
  endif()
  get_target_property(opts ${consumer} COMPILE_OPTIONS)
  foreach(o IN LISTS opts)
    if(o MATCHES "^-std=|^/std:")
      string(APPEND why "\n  consumer has compile option '${o}'")
    endif()
  endforeach()
  # Exceptions / RTTI must match (both compilers reject a mismatch when the BMI is loaded).
  get_property(sopts GLOBAL PROPERTY _HU_SET_${set}_OPTS)
  set(a "")
  set(b "")
  foreach(o IN LISTS opts)
    if(o MATCHES "^-f(no-)?(exceptions|rtti)$")
      list(APPEND a "${o}")
    endif()
  endforeach()
  foreach(o IN LISTS sopts)
    if(o MATCHES "^-f(no-)?(exceptions|rtti)$")
      list(APPEND b "${o}")
    endif()
  endforeach()
  if(NOT "${a}" STREQUAL "${b}")
    string(APPEND why "\n  exceptions/RTTI options differ: consumer '${a}', set '${b}'")
  endif()
  # PIC: both compilers silently accept a mismatch; only predefined macros (__PIC__/__pic__) differ.
  get_property(spic GLOBAL PROPERTY _HU_SET_${set}_PIC)
  get_target_property(type ${consumer} TYPE)
  get_target_property(cpic ${consumer} POSITION_INDEPENDENT_CODE)
  if(type MATCHES "SHARED_LIBRARY|MODULE_LIBRARY")
    set(cpic ON)
  endif()
  _hu_bool(cpic "${cpic}")
  if(NOT cpic STREQUAL spic)
    message(WARNING "target_import_header_units(${consumer} ${set}): POSITION_INDEPENDENT_CODE is ${cpic} for the consumer "
      "but ${spic} for the set. GCC and Clang accept this silently; only __PIC__-dependent preprocessor branches in the "
      "headers could differ. Pass POSITION_INDEPENDENT_CODE to add_header_units() to match.")
  endif()
  get_target_property(cdir ${consumer} SOURCE_DIR)
  foreach(v CMAKE_CXX_FLAGS CMAKE_CXX_FLAGS_${CMAKE_BUILD_TYPE})
    get_directory_property(a DIRECTORY "${cdir}" DEFINITION ${v})
    get_directory_property(b DIRECTORY "${sdir}" DEFINITION ${v})
    if(NOT a STREQUAL b)
      string(APPEND why "\n  ${v} differs between the consumer's directory ('${a}') and the set's directory ('${b}')")
    endif()
  endforeach()
  get_property(tc GLOBAL PROPERTY _HU_TC)
  cmake_language(CALL _hu_${tc}_check_compat)
  if(why)
    message(FATAL_ERROR "target_import_header_units(${consumer} ${set}): target '${consumer}' is incompatible with "
      "header-unit set '${set}':${why}\nA header unit must be compiled with exactly the consumer's language settings.")
  endif()
endfunction()
