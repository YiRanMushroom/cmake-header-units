# HeaderUnits/Common.cmake -- toolchain-independent helpers: header lookup, import scanning, the set registry,
# usage-requirement collection, and the consumer/set compatibility check.

include_guard(GLOBAL)

# ---------------------------------------------------------------------------------------------------------
# Header lookup: <name> -> the file the compiler opens for "#include <name>" when it compiles a given target.
#
# The compiler reports its own search list ("<compiler> <flags> -x c++ -E -v", the "#include <...> search starts
# here:" list).  It is asked once per distinct set of options (_hu_search_base), with two empty marker directories
# where CMake puts a target's -I and -isystem (clang-cl: -imsvc) directories; each target's list is then that list with
# its own directories in the markers' places (_hu_search_list).  So the number of compiler runs does not grow with the
# number of targets (STATUS "HeaderUnits: header lookup: <n> compiler run(s)" at the end), and nothing is compiled.

# Variable <var> as seen at the end of directory <dir> (the current scope when <dir> is empty).
function(_hu_dirvar out dir var)
  if(dir)
    get_directory_property(v DIRECTORY "${dir}" DEFINITION ${var})
  else()
    set(v "${${var}}")
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# A directory as spelled (forward slashes, no trailing slash) and normalized (no "." / "..").
function(_hu_dir_spellings raw_out norm_out d)
  file(TO_CMAKE_PATH "${d}" r)
  string(REGEX REPLACE "(.)/$" "\\1" r "${r}")
  set(n "${r}")
  cmake_path(NORMAL_PATH n)
  string(REGEX REPLACE "(.)/$" "\\1" n "${n}")
  set(${raw_out} "${r}" PARENT_SCOPE)
  set(${norm_out} "${n}" PARENT_SCOPE)
endfunction()

# The search list for one set of options, with the markers: CMake's compile rule is "$DEFINES $INCLUDES $FLAGS", so
# a target's -I / -isystem directories come before CMAKE_CXX_FLAGS (and the build type's), sysroot / target /
# external toolchain, the language level (some options are refused without it, e.g. GCC's -freflection without
# -std=c++26) and the target's COMPILE_OPTIONS.  Options that cannot change the search list (warnings, -D/-U, -O, -g)
# are left out, so targets that differ only in those share the run.  A list printed with a non-zero exit code is used
# (the list comes before the compiler looks at the source; the real compile reports a bad option anyway).
# Outputs <p>_LIST (normalized directories; the markers as @I and @S, with clang-cl also @B) and <p>_RAW (the
# compiler's spelling).
function(_hu_search_base p)
  cmake_parse_arguments(PARSE_ARGV 1 A "" "DIR;STD;EXT" "OPTS")
  get_property(hudir GLOBAL PROPERTY _HU_DIR)
  set(mI "${hudir}/probe/mI")
  set(mS "${hudir}/probe/mS")
  set(mB "${hudir}/probe/mB")
  if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    # cl prints no search list (no -E -v): it searches the directories of its command line in order, then those of
    # the INCLUDE environment variable, which Ninja passes on from the configure's environment (a developer prompt).
    # CMake's command line is "$INCLUDES $FLAGS": the target's /I and /external:I (SYSTEM) directories, then any in
    # CMAKE_CXX_FLAGS (and the build type's) and the compile options.  Assembled here, without a compiler run; the
    # self-check verifies it.
    set(list "@I" "@S")
    set(raws "${mI}" "${mS}")
    set(toks)
    _hu_dirvar(fl "${A_DIR}" CMAKE_CXX_FLAGS)
    separate_arguments(f NATIVE_COMMAND "${fl}")
    list(APPEND toks ${f})
    if(CMAKE_BUILD_TYPE)
      string(TOUPPER "${CMAKE_BUILD_TYPE}" cfg)
      _hu_dirvar(fl "${A_DIR}" CMAKE_CXX_FLAGS_${cfg})
      separate_arguments(f NATIVE_COMMAND "${fl}")
      list(APPEND toks ${f})
    endif()
    foreach(o IN LISTS A_OPTS)
      if(o MATCHES "^SHELL:(.*)$")
        separate_arguments(so WINDOWS_COMMAND "${CMAKE_MATCH_1}")
        list(APPEND toks ${so})
      else()
        list(APPEND toks "${o}")
      endif()
    endforeach()
    set(next FALSE)
    foreach(x IN LISTS toks)
      set(d "")
      if(next)
        set(d "${x}")
        set(next FALSE)
      elseif(x MATCHES "^[-/](external:)?I$")
        set(next TRUE)
      elseif(x MATCHES "^[-/](external:)?I(.+)$")
        set(d "${CMAKE_MATCH_2}")
      endif()
      if(d)
        _hu_dir_spellings(r n "${d}")
        list(APPEND list "${n}")
        list(APPEND raws "${r}")
      endif()
    endforeach()
    set(envinc "$ENV{INCLUDE}")
    foreach(d IN LISTS envinc)
      if(d)
        _hu_dir_spellings(r n "${d}")
        list(APPEND list "${n}")
        list(APPEND raws "${r}")
      endif()
    endforeach()
    get_property(scset GLOBAL PROPERTY _HU_SC_SET)
    if(NOT scset)
      set_property(GLOBAL PROPERTY _HU_SC_SET ON)
      set_property(GLOBAL PROPERTY _HU_SC_DIR "${A_DIR}")
      set_property(GLOBAL PROPERTY _HU_SC_STD "${A_STD}")
      set_property(GLOBAL PROPERTY _HU_SC_EXT "${A_EXT}")
      set_property(GLOBAL PROPERTY _HU_SC_OPTS "${A_OPTS}")
    endif()
    set(${p}_LIST "${list}" PARENT_SCOPE)
    set(${p}_RAW "${raws}" PARENT_SCOPE)
    set(${p}_ARGS /I "${mI}" /external:W0 /external:I "${mS}" PARENT_SCOPE)
    return()
  endif()
  set(args -I "${mI}" -isystem "${mS}")
  if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    # clang-cl: CMake passes SYSTEM directories as -imsvc (CMAKE_INCLUDE_SYSTEM_FLAG_CXX), which clang-cl searches after
    # its own include directory, like those of the INCLUDE environment variable.  Its /external:I (clang's -isystem)
    # directories come right after the -I ones, so the marker mB (@B) shows where the system directories start.
    set(args -I "${mI}" /external:I "${mB}" -imsvc "${mS}")
  endif()
  if(CMAKE_CXX_COMPILER_ARG1)
    separate_arguments(a1 NATIVE_COMMAND "${CMAKE_CXX_COMPILER_ARG1}")
    list(PREPEND args ${a1})
  endif()
  _hu_dirvar(fl "${A_DIR}" CMAKE_CXX_FLAGS)
  separate_arguments(f NATIVE_COMMAND "${fl}")
  list(APPEND args ${f})
  if(CMAKE_BUILD_TYPE)
    string(TOUPPER "${CMAKE_BUILD_TYPE}" cfg)
    _hu_dirvar(fl "${A_DIR}" CMAKE_CXX_FLAGS_${cfg})
    separate_arguments(f NATIVE_COMMAND "${fl}")
    list(APPEND args ${f})
  endif()
  if(CMAKE_SYSROOT AND CMAKE_CXX_COMPILE_OPTIONS_SYSROOT)
    list(APPEND args "${CMAKE_CXX_COMPILE_OPTIONS_SYSROOT}${CMAKE_SYSROOT}")
  endif()
  if(CMAKE_CXX_COMPILER_TARGET AND CMAKE_CXX_COMPILE_OPTIONS_TARGET)
    list(APPEND args "${CMAKE_CXX_COMPILE_OPTIONS_TARGET}${CMAKE_CXX_COMPILER_TARGET}")
  endif()
  if(CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN AND CMAKE_CXX_COMPILE_OPTIONS_EXTERNAL_TOOLCHAIN)
    list(APPEND args "${CMAKE_CXX_COMPILE_OPTIONS_EXTERNAL_TOOLCHAIN}${CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN}")
  endif()
  if(A_STD)
    if(A_EXT AND DEFINED CMAKE_CXX${A_STD}_EXTENSION_COMPILE_OPTION)
      list(APPEND args ${CMAKE_CXX${A_STD}_EXTENSION_COMPILE_OPTION})
    elseif(DEFINED CMAKE_CXX${A_STD}_STANDARD_COMPILE_OPTION)
      list(APPEND args ${CMAKE_CXX${A_STD}_STANDARD_COMPILE_OPTION})
    endif()
  endif()
  foreach(o IN LISTS A_OPTS)
    if(o MATCHES "^SHELL:(.*)$")
      separate_arguments(so UNIX_COMMAND "${CMAKE_MATCH_1}")
    else()
      set(so "${o}")
    endif()
    foreach(x IN LISTS so)
      if((x MATCHES "^-(W|D|U|O|pedantic|fdiagnostics)" AND NOT x MATCHES "^-W[apl],")
         OR x MATCHES "^-g([0-3]|gdb[0-3]?|dwarf.*|split-dwarf|line-tables-only|column-info|z.*)?$"
         OR (CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC" AND x MATCHES "^/(W|D|U|O)"))
        continue()             # (not -gcc-toolchain: Clang's single-dash form selects directories)
      endif()
      list(APPEND args "${x}")
    endforeach()
  endforeach()
  string(MD5 k "${args}")
  get_property(have GLOBAL PROPERTY _HU_BASE_${k}_LIST SET)
  if(NOT have)
    file(MAKE_DIRECTORY "${mI}" "${mS}" "${mB}")
    set(src "${hudir}/probe/empty.cpp")
    if(NOT EXISTS "${src}")
      file(WRITE "${src}" "")
    endif()
    execute_process(COMMAND "${CMAKE_CXX_COMPILER}" ${args} -x c++ -E -v "${src}"
                    OUTPUT_QUIET ERROR_VARIABLE err RESULT_VARIABLE rc)
    get_property(runs GLOBAL PROPERTY _HU_LOOKUP_RUNS)
    if(NOT runs)
      set(runs 0)
    endif()
    math(EXPR runs "${runs} + 1")
    set_property(GLOBAL PROPERTY _HU_LOOKUP_RUNS ${runs})
    string(REPLACE "\r" "" err "${err}")
    set(output "${err}")
    string(REPLACE ";" "\\;" err "${err}")
    string(REPLACE "\n" ";" lines "${err}")
    set(list)
    set(raws)
    set(in FALSE)
    foreach(l IN LISTS lines)
      if(l MATCHES "^#include <\\.\\.\\.> search starts here")
        set(in TRUE)
      elseif(l MATCHES "^End of search list")
        break()
      elseif(in AND l MATCHES "^ +(.+)$")
        string(REGEX REPLACE " \\(framework directory\\)$" "" d "${CMAKE_MATCH_1}")
        _hu_dir_spellings(r n "${d}")
        if(n STREQUAL mI)
          set(n "@I")
        elseif(n STREQUAL mS)
          set(n "@S")
        elseif(n STREQUAL mB)
          set(n "@B")
        endif()
        list(APPEND list "${n}")
        list(APPEND raws "${r}")
      endif()
    endforeach()
    string(JOIN " " shown ${args})
    if(NOT "@I" IN_LIST list OR NOT "@S" IN_LIST list)
      message(FATAL_ERROR "HeaderUnits: no include search list from '${CMAKE_CXX_COMPILER} ${shown} -x c++ -E -v' "
        "(exit ${rc}):\n${output}")
    endif()
    if(NOT rc EQUAL 0)
      message(VERBOSE "HeaderUnits: '${CMAKE_CXX_COMPILER} ${shown} -x c++ -E -v' exited with ${rc}; its search list is "
        "used:\n${output}")
    endif()
    get_property(scset GLOBAL PROPERTY _HU_SC_SET)
    if(NOT scset)              # the self-check uses the options of the first real lookup
      set_property(GLOBAL PROPERTY _HU_SC_SET ON)
      set_property(GLOBAL PROPERTY _HU_SC_DIR "${A_DIR}")
      set_property(GLOBAL PROPERTY _HU_SC_STD "${A_STD}")
      set_property(GLOBAL PROPERTY _HU_SC_EXT "${A_EXT}")
      set_property(GLOBAL PROPERTY _HU_SC_OPTS "${A_OPTS}")
    endif()
    set_property(GLOBAL PROPERTY _HU_BASE_${k}_LIST "${list}")
    set_property(GLOBAL PROPERTY _HU_BASE_${k}_RAW "${raws}")
  endif()
  get_property(v GLOBAL PROPERTY _HU_BASE_${k}_LIST)
  set(${p}_LIST "${v}" PARENT_SCOPE)
  get_property(v GLOBAL PROPERTY _HU_BASE_${k}_RAW)
  set(${p}_RAW "${v}" PARENT_SCOPE)
  set(${p}_ARGS "${args}" PARENT_SCOPE)
endfunction()

# The search list of a target: the base list with INCS at @I and SYSINCS at @S, arranged as CMake and the compiler
# do: a given directory that is one of the compiler's implicit ones is dropped (CMake leaves it out of the command
# line); a missing directory is dropped; a directory listed again is dropped (the first stays; compared by real
# path); a -I directory that is also a system directory is dropped from the -I part.  Outputs <p>_DIRS (normalized) and
# <p>_RAW (as spelled: the given directory, or the compiler's; GCC names a header by it, _hu_gcc_keys).
function(_hu_search_list p)
  cmake_parse_arguments(PARSE_ARGV 1 A "" "DIR;STD;EXT" "INCS;SYSINCS;OPTS")
  _hu_search_base(B DIR "${A_DIR}" STD "${A_STD}" EXT "${A_EXT}" OPTS ${A_OPTS})
  list(FIND B_LIST "@B" sat)   # where the system directories start: clang-cl's @B, else @S
  if(sat LESS 0)
    list(FIND B_LIST "@S" sat)
  endif()
  set(ns)
  set(rs)
  set(ks)
  set(i 0)
  foreach(d r IN ZIP_LISTS B_LIST B_RAW)
    if(d STREQUAL "@I" OR d STREQUAL "@S")
      if(d STREQUAL "@I")
        set(given ${A_INCS})
        set(kind u)
      else()
        set(given ${A_SYSINCS})
        set(kind s)
      endif()
      foreach(g IN LISTS given)
        _hu_dir_spellings(gr gn "${g}")
        if(NOT IS_DIRECTORY "${gn}")
          continue()           # (never an empty placeholder: CMake drops a leading empty list element)
        endif()
        list(APPEND ns "${gn}")
        list(APPEND rs "${gr}")
        list(APPEND ks ${kind})
      endforeach()
    elseif(IS_DIRECTORY "${d}")
      list(APPEND ns "${d}")
      list(APPEND rs "${r}")
      if(i LESS sat)
        list(APPEND ks U)
      else()
        list(APPEND ks S)
      endif()
    endif()
    math(EXPR i "${i} + 1")
  endforeach()
  get_property(have GLOBAL PROPERTY _HU_IMPLICIT_REAL SET)    # (the compiler's own directories: computed once)
  if(have)
    get_property(implicit GLOBAL PROPERTY _HU_IMPLICIT_REAL)
  else()
    set(implicit)
    foreach(d IN LISTS CMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES)
      if(IS_DIRECTORY "${d}")
        file(REAL_PATH "${d}" rp)
        list(APPEND implicit "${rp}")
      endif()
    endforeach()
    set_property(GLOBAL PROPERTY _HU_IMPLICIT_REAL "${implicit}")
  endif()
  set(reals)
  set(sysreals)
  foreach(n k IN ZIP_LISTS ns ks)
    _hu_real_path(rp "${n}")
    list(APPEND reals "${rp}")
    if(k MATCHES "^[Ss]$" AND rp)
      list(APPEND sysreals "${rp}")
    endif()
  endforeach()
  set(dirs)
  set(raws)
  set(kept)
  foreach(n r k rp IN ZIP_LISTS ns rs ks reals)
    if(NOT rp OR rp IN_LIST kept OR (k MATCHES "^[Uu]$" AND rp IN_LIST sysreals)
       OR (k MATCHES "^[us]$" AND rp IN_LIST implicit))
      continue()
    endif()
    list(APPEND kept "${rp}")
    list(APPEND dirs "${n}")
    list(APPEND raws "${r}")
  endforeach()
  set(${p}_DIRS "${dirs}" PARENT_SCOPE)
  set(${p}_RAW "${raws}" PARENT_SCOPE)
  set(${p}_ARGS "${B_ARGS}" PARENT_SCOPE)
endfunction()

# The language level CMake compiles target <tgt> with: CXX_STANDARD, or the compiler's default when unset, raised by
# compile features (its own and its link interface's cxx_std_NN), as CMake picks the -std flag (e.g. a target with only
# cxx_std_20 gets no flag on GCC 16, whose default is C++20); CXX_EXTENSIONS, or the compiler's default.  <why_out>:
# " (raised by compile feature ...)" or "".  Used by the lookup and the consumer/set compatibility check alike.
function(_hu_target_std std_out ext_out why_out tgt)
  get_target_property(s ${tgt} CXX_STANDARD)
  if(NOT s)
    set(s "${CMAKE_CXX_STANDARD_DEFAULT}")
  endif()
  get_target_property(feats ${tgt} COMPILE_FEATURES)
  if(NOT feats)
    set(feats)
  endif()
  get_target_property(ll ${tgt} LINK_LIBRARIES)
  if(ll)
    _hu_collect_usage(CU ${ll})
    list(APPEND feats ${CU_FEATS})
  endif()
  set(why "")
  foreach(f IN LISTS feats)
    if(f MATCHES "^cxx_std_([0-9]+)$" AND CMAKE_MATCH_1 GREATER s)
      set(s "${CMAKE_MATCH_1}")
      set(why " (raised by compile feature ${f})")
    endif()
  endforeach()
  get_target_property(e ${tgt} CXX_EXTENSIONS)
  if(e STREQUAL "e-NOTFOUND")
    set(e "${CMAKE_CXX_EXTENSIONS_DEFAULT}")
  endif()
  _hu_bool(e "${e}")
  set(${std_out} "${s}" PARENT_SCOPE)
  set(${ext_out} "${e}" PARENT_SCOPE)
  set(${why_out} "${why}" PARENT_SCOPE)
endfunction()

# The compile context of target <tgt> as far as the header lookup needs it, read from its properties as CMake will
# use them: CMAKE_INCLUDE_CURRENT_DIR (its build and source directory first), INCLUDE_DIRECTORIES, the usage
# requirements of LINK_LIBRARIES (_hu_collect_usage: -I or -isystem), COMPILE_OPTIONS and the language level
# (_hu_target_std).  Extra INCS / LIBS / OPTS and STD / EXT overrides
# come from target_auto_header_units().  Generator expressions are skipped (BUILD_INTERFACE unwrapped); a directory
# given with target_include_directories(SYSTEM PRIVATE) is not distinguishable here and counts as -I.  Outputs
# <p>_DIRS / <p>_RAW (_hu_search_list).
function(_hu_target_search p tgt)
  cmake_parse_arguments(PARSE_ARGV 2 A "" "STD;EXT" "INCS;LIBS;OPTS")
  get_target_property(sdir ${tgt} SOURCE_DIR)
  get_target_property(bdir ${tgt} BINARY_DIR)
  set(incs)
  _hu_dirvar(cur "${sdir}" CMAKE_INCLUDE_CURRENT_DIR)
  if(cur)
    list(APPEND incs "${bdir}" "${sdir}")
  endif()
  get_target_property(ti ${tgt} INCLUDE_DIRECTORIES)
  if(NOT ti)
    set(ti)
  endif()
  foreach(d IN LISTS ti A_INCS)
    if(d MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
      set(d "${CMAKE_MATCH_1}")
    endif()
    if(d AND NOT d MATCHES "\\$<")
      list(APPEND incs "${d}")
    endif()
  endforeach()
  get_target_property(tl ${tgt} LINK_LIBRARIES)
  if(NOT tl)
    set(tl)
  endif()
  _hu_collect_usage(U ${tl} ${A_LIBS})
  get_target_property(to ${tgt} COMPILE_OPTIONS)
  if(NOT to)
    set(to)
  endif()
  set(opts)
  foreach(o IN LISTS to A_OPTS U_OPTS)
    if(NOT o MATCHES "\\$<")
      list(APPEND opts "${o}")
    endif()
  endforeach()
  _hu_target_std(std ext why ${tgt})
  if(DEFINED A_STD)
    set(std "${A_STD}")
  endif()
  if(DEFINED A_EXT)
    _hu_bool(ext "${A_EXT}")
  endif()
  _hu_search_list(S DIR "${sdir}" STD "${std}" EXT "${ext}" INCS ${incs} ${U_INCS} SYSINCS ${U_SYSINCS} OPTS ${opts})
  set(${p}_DIRS "${S_DIRS}" PARENT_SCOPE)
  set(${p}_RAW "${S_RAW}" PARENT_SCOPE)
endfunction()

# Self-check, once per configure (one compiler run on a 3-line file, with the options of the first real lookup): the
# compiler must open headers where _hu_search_list predicts, and GCC must name them by one of the mapper keys of
# _hu_gcc_keys.  The probe adds -I "<sc>/sub/../inc" and -isystem "<sc>/sys" and includes <hu_sc_shadow.h> (in both: the
# -I one wins), <hu_sc_sys.h> (only in sys/) and <cstddef> (the C++ library's own directory).  A compiler that orders
# or names headers otherwise (an untested version) stops the configure here instead of producing a broken build; a
# probe that cannot run (a header not opened) only warns, as the lookup itself may still be right.
function(_hu_self_check)
  get_property(scset GLOBAL PROPERTY _HU_SC_SET)
  if(NOT scset)
    return()
  endif()
  get_property(hudir GLOBAL PROPERTY _HU_DIR)
  get_property(tc GLOBAL PROPERTY _HU_TC)
  foreach(v DIR STD EXT OPTS)
    get_property(sc_${v} GLOBAL PROPERTY _HU_SC_${v})
  endforeach()
  set(sc "${hudir}/probe/sc")
  # distinct contents: GCC's #pragma once takes files with the same contents and time for one file
  foreach(f inc/hu_sc_shadow.h sys/hu_sc_shadow.h sys/hu_sc_sys.h)
    file(CONFIGURE OUTPUT "${sc}/${f}" CONTENT "#pragma once\n// HeaderUnits self-check: ${f}\n")
  endforeach()
  file(MAKE_DIRECTORY "${sc}/sub")
  set(src "${sc}/probe.cpp")
  file(CONFIGURE OUTPUT "${src}" CONTENT "#include <hu_sc_shadow.h>\n#include <hu_sc_sys.h>\n#include <cstddef>\n")
  set(names hu_sc_shadow.h hu_sc_sys.h cstddef)
  set(inc "${sc}/sub/../inc")
  set(sys "${sc}/sys")
  _hu_search_list(P DIR "${sc_DIR}" STD "${sc_STD}" EXT "${sc_EXT}" INCS "${inc}" SYSINCS "${sys}" OPTS ${sc_OPTS})
  set(args)
  foreach(a IN LISTS P_ARGS)
    if(a STREQUAL "${hudir}/probe/mI")
      list(APPEND args "${inc}")
    elseif(a STREQUAL "${hudir}/probe/mS")
      list(APPEND args "${sys}")
    else()
      list(APPEND args "${a}")
    endif()
  endforeach()
  if(tc STREQUAL "MSVC")
    # cl: /showIncludes names each opened header on stdout ("<prefix><path>", one more blank per nesting level), with
    # CMake's detected (localized) prefix; /Zs: syntax check only, no preprocessed output.
    set(cmd "${CMAKE_CXX_COMPILER}" /nologo ${args} /Zs /showIncludes "${src}")
    execute_process(COMMAND ${cmd} OUTPUT_VARIABLE err ERROR_VARIABLE err RESULT_VARIABLE rc)
  else()
    set(hflag -H)
    if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
      set(hflag /clang:-H)     # (clang-cl ignores a bare -H)
    endif()
    set(cmd "${CMAKE_CXX_COMPILER}" ${args} -x c++ -E ${hflag} "${src}")
    execute_process(COMMAND ${cmd} OUTPUT_QUIET ERROR_VARIABLE err RESULT_VARIABLE rc)
  endif()
  get_property(runs GLOBAL PROPERTY _HU_LOOKUP_RUNS)
  if(NOT runs)
    set(runs 0)
  endif()
  math(EXPR runs "${runs} + 1")
  set_property(GLOBAL PROPERTY _HU_LOOKUP_RUNS ${runs})
  string(REPLACE "\r" "" err "${err}")
  set(output "${err}")
  string(REPLACE ";" "\\;" err "${err}")
  string(REPLACE "\n" ";" lines "${err}")
  set(opened)
  foreach(l IN LISTS lines)
    if(tc STREQUAL "MSVC" AND CMAKE_CL_SHOWINCLUDES_PREFIX)
      string(LENGTH "${CMAKE_CL_SHOWINCLUDES_PREFIX}" pl)
      string(SUBSTRING "${l}" 0 ${pl} lp)
      if(lp STREQUAL CMAKE_CL_SHOWINCLUDES_PREFIX)
        string(SUBSTRING "${l}" ${pl} -1 rest)
        if(NOT CMAKE_CL_SHOWINCLUDES_PREFIX MATCHES " $")
          string(REGEX REPLACE "^ " "" rest "${rest}")    # (a prefix detected without its separating blank)
        endif()
        if(rest MATCHES "^[^ ]")
          list(APPEND opened "${rest}")
        endif()
      endif()
    elseif(l MATCHES "^\\. (.+)$")
      list(APPEND opened "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  set(why "")
  set(missing)
  foreach(name IN LISTS names)
    set(o "")
    foreach(x IN LISTS opened)
      file(TO_CMAKE_PATH "${x}" xc)
      get_filename_component(xn "${xc}" NAME)
      if(xn STREQUAL name)
        set(o "${x}")
        break()
      endif()
    endforeach()
    if(o STREQUAL "")
      list(APPEND missing "<${name}>")
      continue()
    endif()
    file(TO_CMAKE_PATH "${o}" oc)
    _hu_find_header(f "${name}" ${P_DIRS})
    if(NOT f)
      string(APPEND why "\n  <${name}>: the compiler opens '${o}', predicted: not found")
      continue()
    endif()
    file(REAL_PATH "${f}" rf)
    file(REAL_PATH "${oc}" ro)
    if(NOT rf STREQUAL ro)
      string(APPEND why "\n  <${name}>: the compiler opens '${o}', predicted '${f}'")
    elseif(tc STREQUAL "GCC")
      _hu_gcc_keys(keys "${f}" "${name}" DIRS ${P_DIRS} RAW ${P_RAW})
      if(NOT o IN_LIST keys)
        string(APPEND why "\n  <${name}>: GCC names it '${o}', which is none of the mapper keys (${keys})")
      endif()
    endif()
  endforeach()
  string(JOIN " " shown ${cmd})
  string(JOIN "\n    " dirs ${P_DIRS})
  set(detail "\n  predicted search list:\n    ${dirs}\n  command: ${shown}\n"
    "  exit code ${rc}, output:\n${output}")
  if(why)
    message(FATAL_ERROR "HeaderUnits: self-check failed: this compiler finds or names headers otherwise than HeaderUnits "
      "expects, so its header units would not match what the compiles open:${why}${detail}")
  endif()
  if(missing)
    string(JOIN ", " missing ${missing})
    message(WARNING "HeaderUnits: self-check incomplete: the probe did not open ${missing}, so the header lookup is not "
      "verified for this compiler and options (the lookup itself is unchanged).${detail}")
  endif()
endfunction()

function(_hu_bool out v)
  if(v)
    set(${out} ON PARENT_SCOPE)
  else()
    set(${out} OFF PARENT_SCOPE)
  endif()
endfunction()

# ---------------------------------------------------------------------------------------------------------
# Header-unit import declarations in a file ("import <x>;", "import \"x\";", optionally exported), as a list of
# "a|<name>" (angle) and "q|<name>" (quote).  Imports produced by macros or hidden in #if are not considered.
function(_hu_scan_imports out file)
  set(r)
  file(STRINGS "${file}" ls REGEX "^[ \t]*(export[ \t]+)?import[ \t]*[<\"][^>\"]+[>\"][ \t]*;")
  foreach(l IN LISTS ls)
    if(l MATCHES "import[ \t]*<([^>]+)>")
      list(APPEND r "a|${CMAKE_MATCH_1}")
    elseif(l MATCHES "import[ \t]*\"([^\"]+)\"")
      list(APPEND r "q|${CMAKE_MATCH_1}")
    endif()
  endforeach()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# <name> in a search list (_hu_search_list): the first directory holding it, "" if none.  An absolute name stands for
# itself.  The result is normalized, like the directories.
function(_hu_find_header out name)
  set(r "")
  if(IS_ABSOLUTE "${name}")
    if(EXISTS "${name}" AND NOT IS_DIRECTORY "${name}")
      set(r "${name}")
    endif()
  else()
    foreach(d IN LISTS ARGN)
      if(EXISTS "${d}/${name}" AND NOT IS_DIRECTORY "${d}/${name}")
        set(r "${d}/${name}")
        break()
      endif()
    endforeach()
  endif()
  if(r)
    cmake_path(NORMAL_PATH r)
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# Header unit lookup by import name (angle name, or absolute path for a quote import found next to the importer),
# resolved with the search list given as the remaining arguments: outputs set, resolved path, BMI, (Clang) module
# name and module map; set is "" if no set has a header unit of that file.
function(_hu_lookup prefix name)
  _hu_find_header(f "${name}" ${ARGN})
  set(t "")
  if(f)
    file(REAL_PATH "${f}" rf)
    string(MD5 k "${rf}")
    get_property(t GLOBAL PROPERTY _HU_REAL_SET_${k})
  endif()
  set(${prefix}_SET "${t}" PARENT_SCOPE)
  if(NOT t)
    return()
  endif()
  get_property(ps GLOBAL PROPERTY _HU_SET_${t}_PATHS)
  get_property(bs GLOBAL PROPERTY _HU_SET_${t}_CMIS)
  get_property(ms GLOBAL PROPERTY _HU_SET_${t}_MIDS)
  get_property(mm GLOBAL PROPERTY _HU_SET_${t}_MMAPS)
  set(idx 0)
  foreach(p IN LISTS ps)
    file(REAL_PATH "${p}" rp)
    if(rp STREQUAL rf)
      break()
    endif()
    math(EXPR idx "${idx} + 1")
  endforeach()
  list(GET ps ${idx} p)
  list(GET bs ${idx} b)
  set(${prefix}_PATH "${p}" PARENT_SCOPE)
  set(${prefix}_BMI "${b}" PARENT_SCOPE)
  if(ms)
    list(GET ms ${idx} m)
    list(GET mm ${idx} mp)
    set(${prefix}_MID "${m}" PARENT_SCOPE)
    set(${prefix}_MAP "${mp}" PARENT_SCOPE)
  endif()
endfunction()

# Set plus the sets its header units import, transitively.
function(_hu_set_closure out s)
  set(r "${s}")
  set(todo "${s}")
  while(todo)
    list(POP_FRONT todo x)
    get_property(ds GLOBAL PROPERTY _HU_SET_${x}_DEPSETS)
    foreach(d IN LISTS ds)
      if(NOT d IN_LIST r)
        list(APPEND r "${d}")
        list(APPEND todo "${d}")
      endif()
    endforeach()
  endwhile()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# "a|x" -> x ; "q|x" -> the normalized absolute path if x exists relative to <dir> (quote lookup), else x.
function(_hu_import_name out entry dir)
  string(SUBSTRING "${entry}" 2 -1 n)
  if(entry MATCHES "^q\\|" AND NOT IS_ABSOLUTE "${n}" AND EXISTS "${dir}/${n}")
    set(n "${dir}/${n}")
    cmake_path(NORMAL_PATH n)
  endif()
  set(${out} "${n}" PARENT_SCOPE)
endfunction()

# Usage requirements of LINK_LIBRARIES for the header lookup, following INTERFACE_LINK_LIBRARIES recursively: ALIAS
# resolved, $<LINK_ONLY:...> (private dependencies of static libraries) and cross-directory markers (::@...) skipped,
# $<BUILD_INTERFACE:x> -> x, $<INSTALL_INTERFACE:...> dropped.  Other generator expressions cannot be evaluated at
# configure time and are skipped (VERBOSE message); a header found only through such a directory is then not found
# (pass the directory with INCLUDE_DIRECTORIES).  Include directories as CMake passes them to a consumer: those of
# IMPORTED targets (unless SYSTEM is OFF), of SYSTEM targets and INTERFACE_SYSTEM_INCLUDE_DIRECTORIES as -isystem
# (<prefix>_SYSINCS), the others as -I (<prefix>_INCS).  Also <prefix>_DEFS, <prefix>_OPTS (INTERFACE_COMPILE_OPTIONS)
# and <prefix>_FEATS.
function(_hu_collect_usage prefix)
  set(incs)
  set(sysincs)
  set(defs)
  set(opts)
  set(feats)
  set(seen)
  set(todo ${ARGN})
  while(todo)
    list(POP_FRONT todo l)
    if(l MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
      set(l "${CMAKE_MATCH_1}")
    endif()
    if(l STREQUAL "" OR l MATCHES "^::@" OR l MATCHES "\\$<")
      if(l MATCHES "\\$<" AND NOT l MATCHES "^\\$<(LINK_ONLY|INSTALL_INTERFACE):")
        message(VERBOSE "HeaderUnits: the header lookup skips link item '${l}'")
      endif()
      continue()
    endif()
    if(NOT TARGET "${l}")
      continue()            # a plain library: no usage requirements
    endif()
    get_target_property(al "${l}" ALIASED_TARGET)
    if(al)
      set(l "${al}")
    endif()
    if(l IN_LIST seen)
      continue()
    endif()
    list(APPEND seen "${l}")
    get_target_property(imp "${l}" IMPORTED)
    get_target_property(sys "${l}" SYSTEM)
    if(imp AND sys STREQUAL "sys-NOTFOUND")
      set(sys ON)           # IMPORTED targets are SYSTEM unless set otherwise
    endif()
    get_target_property(sysdirs "${l}" INTERFACE_SYSTEM_INCLUDE_DIRECTORIES)
    if(NOT sysdirs)
      set(sysdirs)
    endif()
    foreach(prop INTERFACE_INCLUDE_DIRECTORIES INTERFACE_COMPILE_DEFINITIONS INTERFACE_COMPILE_OPTIONS INTERFACE_COMPILE_FEATURES)
      get_target_property(vals "${l}" ${prop})
      if(NOT vals)
        continue()
      endif()
      foreach(v IN LISTS vals)
        if(v MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
          set(v "${CMAKE_MATCH_1}")
        endif()
        if(v STREQUAL "" OR v MATCHES "\\$<")
          if(v MATCHES "\\$<" AND NOT v MATCHES "^\\$<INSTALL_INTERFACE:")
            message(VERBOSE "HeaderUnits: the header lookup skips ${prop} item '${v}' of ${l}")
          endif()
          continue()
        endif()
        if(prop STREQUAL "INTERFACE_INCLUDE_DIRECTORIES")
          if(sys OR v IN_LIST sysdirs)
            list(APPEND sysincs "${v}")
          else()
            list(APPEND incs "${v}")
          endif()
        elseif(prop STREQUAL "INTERFACE_COMPILE_DEFINITIONS")
          list(APPEND defs "${v}")
        elseif(prop STREQUAL "INTERFACE_COMPILE_OPTIONS")
          list(APPEND opts "${v}")
        else()
          list(APPEND feats "${v}")
        endif()
      endforeach()
    endforeach()
    get_target_property(ill "${l}" INTERFACE_LINK_LIBRARIES)
    if(ill)
      list(APPEND todo ${ill})
    endif()
  endwhile()
  foreach(v incs sysincs defs feats)
    if(${v})
      list(REMOVE_DUPLICATES ${v})
    endif()
  endforeach()
  foreach(v INCS SYSINCS DEFS OPTS FEATS)
    string(TOLOWER "${v}" lv)
    set(${prefix}_${v} "${${lv}}" PARENT_SCOPE)
  endforeach()
endfunction()

# All C++ sources of a target, as absolute paths (SOURCES + CXX_MODULES file sets).
function(_hu_target_cxx_sources out tgt)
  get_target_property(sdir ${tgt} SOURCE_DIR)
  get_target_property(bdir ${tgt} BINARY_DIR)
  get_target_property(srcs ${tgt} SOURCES)
  if(NOT srcs)
    set(srcs)
  endif()
  get_target_property(msets ${tgt} CXX_MODULE_SETS)
  if(msets)
    foreach(ms IN LISTS msets)
      if(ms STREQUAL "CXX_MODULES")
        get_target_property(f ${tgt} CXX_MODULE_SET)
      else()
        get_target_property(f ${tgt} CXX_MODULE_SET_${ms})
      endif()
      if(f)
        list(APPEND srcs ${f})
      endif()
    endforeach()
  endif()
  set(res)
  foreach(s IN LISTS srcs)
    if(s MATCHES "\\$<")
      message(FATAL_ERROR "target_import_header_units(${tgt}): source '${s}' is a generator expression; list the sources with SOURCES.")
    endif()
    if(NOT s MATCHES "\\.(cpp|cc|cxx|c\\+\\+|C|cppm|ixx|mpp|cxxm|ccm|c\\+\\+m)$")
      continue()
    endif()
    if(IS_ABSOLUTE "${s}")
      set(a "${s}")
    elseif(EXISTS "${sdir}/${s}")
      set(a "${sdir}/${s}")
    else()
      set(a "${bdir}/${s}")
    endif()
    cmake_path(NORMAL_PATH a)
    list(APPEND res "${a}")
  endforeach()
  list(REMOVE_DUPLICATES res)
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

# A consumer's own include path decides which file "#include <h>" / "import <h>" opens.  Warns when the consumer
# receives a header unit for <h> of another file than the one it finds, and that file has no header unit among the
# sets it receives (an import of <h> would fail; a #include stays textual).  A consumer that also has a header unit
# of its own file is fine (e.g. a reused set brings another <config.h>, unused here).
# Writes <path> with <content>, rewritten only when the content changes; UNIX: "\n" line ends.  In a multi-config build
# tree (_HU_CFG) <path> and <content> contain $<CONFIG>: one file per configuration (file(GENERATE)).
function(_hu_write path content)
  cmake_parse_arguments(A "UNIX" "" "" ${ARGN})
  set(nl)
  if(A_UNIX)
    set(nl NEWLINE_STYLE UNIX)
  endif()
  get_property(cfg GLOBAL PROPERTY _HU_CFG)
  if(cfg)
    file(GENERATE OUTPUT "${path}" CONTENT "${content}" ${nl})
  else()
    file(CONFIGURE OUTPUT "${path}" CONTENT "${content}" @ONLY ${nl})
  endif()
endfunction()

# file(REAL_PATH) of an existing file or directory, asked once per configure run (a real path changes only when a
# symbolic link is made, which a configure run does not do to the files it looks up).
function(_hu_real_path out p)
  string(MD5 k "${p}")
  get_property(r GLOBAL PROPERTY _HU_REAL_OF_${k})
  if(NOT r)
    file(REAL_PATH "${p}" r)
    set_property(GLOBAL PROPERTY _HU_REAL_OF_${k} "${r}")
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

function(_hu_check_same_files consumer)
  _hu_target_search(C ${consumer})
  string(MD5 ck "${C_DIRS}|${ARGN}")       # the same search list and sets: the same answer
  get_property(have GLOBAL PROPERTY _HU_SAMEFILES_${ck} SET)
  if(have)
    get_property(why GLOBAL PROPERTY _HU_SAMEFILES_${ck})
    _hu_same_files_warn("${consumer}" "${why}")
    return()
  endif()
  set(covered)
  set(hl)
  set(pl)
  set(sl)
  foreach(s IN LISTS ARGN)
    get_property(hs GLOBAL PROPERTY _HU_SET_${s}_HEADERS)
    get_property(ps GLOBAL PROPERTY _HU_SET_${s}_PATHS)
    foreach(h p IN ZIP_LISTS hs ps)
      file(REAL_PATH "${p}" rp)
      list(APPEND covered "${rp}")
      list(APPEND hl "${h}")
      list(APPEND pl "${p}")
      list(APPEND sl "${s}")
    endforeach()
  endforeach()
  set(why "")
  foreach(h p s IN ZIP_LISTS hl pl sl)
    _hu_find_header(f "${h}" ${C_DIRS})
    if(NOT f)
      continue()
    endif()
    file(REAL_PATH "${f}" rf)
    if(NOT rf IN_LIST covered)
      string(APPEND why "\n  <${h}>: its include path finds '${f}', which has no header unit; set '${s}' has <${h}> as '${p}'")
    endif()
  endforeach()
  set_property(GLOBAL PROPERTY _HU_SAMEFILES_${ck} "${why}")
  _hu_same_files_warn("${consumer}" "${why}")
endfunction()

function(_hu_same_files_warn consumer why)
  if(why)
    message(WARNING "HeaderUnits: target '${consumer}' receives header units of other files than its include path "
      "finds:${why}\nAn import of such a header fails to compile (a #include of it stays textual). Give the target the "
      "set's include directory first, or declare the file it finds as a header unit.")
  endif()
endfunction()

# Definitions of a target that change the C++ library's ABI (object layout), as "NAME=VALUE", sorted: from the target,
# its directory and its link interface (generator expressions are not evaluated and so not compared).  Only a named list
# per library, so that an unrelated definition never fails the configure; a mismatch would otherwise be silent (the
# header unit's types differ from what the consumer's own code expects).
function(_hu_abi_defs out tgt)
  if(CMAKE_CXX_SIMULATE_ID STREQUAL "MSVC" OR CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    set(re "^(_ITERATOR_DEBUG_LEVEL|_HAS_ITERATOR_DEBUGGING|_SECURE_SCL|_HAS_EXCEPTIONS)(=(.*))?$")
  else()
    set(re "^(_GLIBCXX_DEBUG|_GLIBCXX_DEBUG_PEDANTIC|_GLIBCXX_USE_CXX11_ABI|_GLIBCXX_FULLY_DYNAMIC_STRING|_LIBCPP_ABI_[A-Z0-9_]+)(=(.*))?$")
  endif()
  get_target_property(td ${tgt} COMPILE_DEFINITIONS)
  get_target_property(sd ${tgt} SOURCE_DIR)
  get_directory_property(dd DIRECTORY "${sd}" COMPILE_DEFINITIONS)
  get_target_property(ll ${tgt} LINK_LIBRARIES)
  if(NOT td)
    set(td)
  endif()
  if(NOT ll)
    set(ll)
  endif()
  _hu_collect_usage(U ${ll})
  set(r)
  foreach(d IN LISTS td dd U_DEFS)
    string(REGEX REPLACE "^-D" "" d "${d}")
    if(d MATCHES "${re}")
      if(CMAKE_MATCH_2)
        list(APPEND r "${CMAKE_MATCH_1}=${CMAKE_MATCH_3}")
      else()
        list(APPEND r "${CMAKE_MATCH_1}=1")
      endif()
    endif()
  endforeach()
  if(CMAKE_CXX_SIMULATE_ID STREQUAL "MSVC" OR CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    get_target_property(rt ${tgt} MSVC_RUNTIME_LIBRARY)
    if(NOT rt)
      set(rt "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")   # CMake's default
    endif()
    list(APPEND r "MSVC_RUNTIME_LIBRARY=${rt}")
  endif()
  list(REMOVE_DUPLICATES r)
  # A value the library would pick anyway is the same as none (no false mismatch with a side that does not spell it).
  list(REMOVE_ITEM r "_GLIBCXX_USE_CXX11_ABI=1" "_HAS_EXCEPTIONS=1")
  list(SORT r)
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# _hu_abi_defs() result <defs> in configuration <cfg> ("" with no build type): an _ITERATOR_DEBUG_LEVEL at the default
# of that configuration is the same as none (2 with the debug runtime, CMake's default in Debug and compared on its own;
# else 0).
function(_hu_abi_defs_cfg out defs cfg)
  string(TOUPPER "${cfg}" ucfg)                          # ($<CONFIG:Debug> ignores case)
  if(ucfg STREQUAL "DEBUG")
    list(REMOVE_ITEM defs "_ITERATOR_DEBUG_LEVEL=2")
  else()
    list(REMOVE_ITEM defs "_ITERATOR_DEBUG_LEVEL=0")
  endif()
  set(${out} "${defs}" PARENT_SCOPE)
endfunction()

# The configurations that are built: with a multi-config generator (Ninja Multi-Config) every entry of
# CMAKE_CONFIGURATION_TYPES, else CMAKE_BUILD_TYPE (none when it is empty).
function(_hu_configs out)
  get_property(multi GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
  if(multi)
    set(${out} "${CMAKE_CONFIGURATION_TYPES}" PARENT_SCOPE)
  else()
    set(${out} "${CMAKE_BUILD_TYPE}" PARENT_SCOPE)
  endif()
endfunction()

# "configuration <c>: " or "configurations <c1>, <c2>: " to start the line of a difference in <cfgs> ("" for none).
function(_hu_cfg_label out cfgs)
  list(LENGTH cfgs n)
  string(REPLACE ";" ", " s "${cfgs}")
  if(n EQUAL 0)
    set(${out} "" PARENT_SCOPE)
  elseif(n EQUAL 1)
    set(${out} "configuration ${s}: " PARENT_SCOPE)
  else()
    set(${out} "configurations ${s}: " PARENT_SCOPE)
  endif()
endfunction()

function(_hu_check_compat consumer set)
  get_property(std GLOBAL PROPERTY _HU_SET_${set}_STD)
  get_property(ext GLOBAL PROPERTY _HU_SET_${set}_EXT)
  get_property(sdir GLOBAL PROPERTY _HU_SET_${set}_DIR)
  _hu_target_std(cstd cext cfeat ${consumer})
  set(why "")
  if(NOT cstd STREQUAL std)
    string(APPEND why "\n  consumer's C++ standard is C++${cstd}${cfeat} (CXX_STANDARD, else the compiler default) but the set was built with CXX_STANDARD=${std}")
  endif()
  # (MSVC and clang-cl spell both -std:c++NN: there CXX_EXTENSIONS changes nothing)
  if(NOT cext STREQUAL ext AND NOT (DEFINED CMAKE_CXX${std}_EXTENSION_COMPILE_OPTION
                                    AND CMAKE_CXX${std}_EXTENSION_COMPILE_OPTION STREQUAL CMAKE_CXX${std}_STANDARD_COMPILE_OPTION))
    string(APPEND why "\n  consumer CXX_EXTENSIONS=${cext} but the set uses CXX_EXTENSIONS=${ext} (-std=c++NN vs -std=gnu++NN)")
  endif()
  get_target_property(opts ${consumer} COMPILE_OPTIONS)
  foreach(o IN LISTS opts)
    if(o MATCHES "^(/clang:)?-std=|^[-/]std:")
      string(APPEND why "\n  consumer has compile option '${o}'")
    endif()
  endforeach()
  # Exceptions / RTTI must match (the compilers reject a mismatch when the BMI is loaded).
  get_property(sopts GLOBAL PROPERTY _HU_SET_${set}_OPTS)
  set(a "")
  set(b "")
  set(re "^(/clang:)?-f(no-)?(exceptions|rtti)$|^[-/]EH|^[-/]GR-?$")
  foreach(o IN LISTS opts)
    if(o MATCHES "${re}")
      list(APPEND a "${o}")
    endif()
  endforeach()
  foreach(o IN LISTS sopts)
    if(o MATCHES "${re}")
      list(APPEND b "${o}")
    endif()
  endforeach()
  if(NOT "${a}" STREQUAL "${b}")
    string(APPEND why "\n  exceptions/RTTI options differ: consumer '${a}', set '${b}'")
  endif()
  # PIC: both compilers silently accept a mismatch; only predefined macros (__PIC__/__pic__) differ.
  get_property(spic GLOBAL PROPERTY _HU_SET_${set}_PIC)
  get_target_property(type ${consumer} TYPE)
  get_target_property(cpic ${consumer} POSITION_INDEPENDENT_CODE)
  if(type MATCHES "SHARED_LIBRARY|MODULE_LIBRARY")
    set(cpic ON)
  endif()
  _hu_bool(cpic "${cpic}")
  if(NOT cpic STREQUAL spic)
    message(WARNING "target_import_header_units(${consumer} ${set}): POSITION_INDEPENDENT_CODE is ${cpic} for the consumer "
      "but ${spic} for the set. GCC and Clang accept this silently; only __PIC__-dependent preprocessor branches in the "
      "headers could differ. Pass POSITION_INDEPENDENT_CODE to add_header_units() to match.")
  endif()
  # ABI definitions and the configuration's flags, in every configuration that is built (each of CMAKE_CONFIGURATION_TYPES
  # with Ninja Multi-Config: CMAKE_BUILD_TYPE is empty there); with no build type, one comparison.  The default
  # _ITERATOR_DEBUG_LEVEL depends on the configuration; configurations with the same difference share its line.
  _hu_configs(cfgs)
  _hu_abi_defs(cabi0 ${consumer})
  _hu_abi_defs(sabi0 ${set})
  list(LENGTH cfgs n)
  if(n EQUAL 0)
    set(n 1)
  endif()
  math(EXPR last "${n} - 1")
  set(keys)
  foreach(i RANGE ${last})
    set(cfg "")
    if(cfgs)
      list(GET cfgs ${i} cfg)
    endif()
    _hu_abi_defs_cfg(cabi "${cabi0}" "${cfg}")
    _hu_abi_defs_cfg(sabi "${sabi0}" "${cfg}")
    if(NOT "${cabi}" STREQUAL "${sabi}")
      string(REPLACE ";" ", " cabi_s "${cabi}")
      string(REPLACE ";" ", " sabi_s "${sabi}")
      string(MD5 k "${cabi_s}|${sabi_s}")
      if(NOT k IN_LIST keys)
        list(APPEND keys ${k})
        set(diff_${k} "consumer '${cabi_s}', set '${sabi_s}'")
        set(cfgs_${k})
      endif()
      list(APPEND cfgs_${k} "${cfg}")
    endif()
  endforeach()
  foreach(k IN LISTS keys)
    _hu_cfg_label(in "${cfgs_${k}}")
    string(APPEND why "\n  ${in}ABI-affecting definitions differ: ${diff_${k}} (give the set the same: "
                      "COMPILE_DEFINITIONS of add_header_units() or the directory's, and MSVC_RUNTIME_LIBRARY on the set's target)")
  endforeach()
  # A configuration's variable is spelled in upper case (CMAKE_CXX_FLAGS_DEBUG for Debug), as CMake looks it up.
  get_target_property(cdir ${consumer} SOURCE_DIR)
  set(vars CMAKE_CXX_FLAGS)
  foreach(cfg IN LISTS cfgs)
    string(TOUPPER "${cfg}" ucfg)
    list(APPEND vars CMAKE_CXX_FLAGS_${ucfg})
  endforeach()
  list(REMOVE_DUPLICATES vars)
  foreach(v IN LISTS vars)
    get_directory_property(a DIRECTORY "${cdir}" DEFINITION ${v})
    get_directory_property(b DIRECTORY "${sdir}" DEFINITION ${v})
    if(NOT a STREQUAL b)
      set(in "")
      foreach(cfg IN LISTS cfgs)
        string(TOUPPER "${cfg}" ucfg)
        if(v STREQUAL "CMAKE_CXX_FLAGS_${ucfg}")
          _hu_cfg_label(in "${cfg}")
          break()
        endif()
      endforeach()
      string(APPEND why "\n  ${in}${v} differs between the consumer's directory ('${a}') and the set's directory ('${b}')")
    endif()
  endforeach()
  get_property(tc GLOBAL PROPERTY _HU_TC)
  cmake_language(CALL _hu_${tc}_check_compat)
  if(why)
    message(FATAL_ERROR "target_import_header_units(${consumer} ${set}): target '${consumer}' is incompatible with "
      "header-unit set '${set}':${why}\nA header unit must be compiled with exactly the consumer's language settings.")
  endif()
endfunction()

# ---------------------------------------------------------------------------------------------------------
# hu-mapper (hu-mapper.cpp): GCC's module mapper, and for every toolchain the native import scan of
# target_auto_header_units() / target_header_units_scan_sources() (_hu_native_scan; the CMake functions above are its
# fallback).  Built once per build tree at configure time, with the project's compiler; cross-compiling with a host
# compiler (HU_HOST_CXX, else c++ / g++ / clang++ on the host's PATH).  Kept only if it runs here.  Not built when nothing
# would use it: HU_NATIVE_SCAN OFF and (not GCC, or HU_GCC_WRAPPERS ON).  Sets the global property _HU_HELPER (the
# program, or "").
function(_hu_build_helper)
  get_property(hudir GLOBAL PROPERTY _HU_DIR)
  get_property(tc GLOBAL PROPERTY _HU_TC)
  get_property(native GLOBAL PROPERTY _HU_NATIVE_SCAN)
  set_property(GLOBAL PROPERTY _HU_HELPER "")
  if(NOT native AND (NOT tc STREQUAL "GCC" OR HU_GCC_WRAPPERS))
    return()
  endif()
  set(src "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/hu-mapper.cpp")
  set(exe "${hudir}/hu-mapper")
  if(CMAKE_HOST_WIN32)
    string(APPEND exe ".exe")
  endif()
  set(cxx "")
  set(args)
  set(arg1)
  set(msvc_style FALSE)
  set(gnu_static FALSE)
  if(NOT CMAKE_CROSSCOMPILING)
    set(cxx "${CMAKE_CXX_COMPILER}")
    if(CMAKE_CXX_COMPILER_ARG1)
      separate_arguments(args NATIVE_COMMAND "${CMAKE_CXX_COMPILER_ARG1}")
    endif()
    set(arg1 ${args})
    separate_arguments(flags NATIVE_COMMAND "${CMAKE_CXX_FLAGS}")
    list(APPEND args ${flags})
    if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" OR CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
      set(msvc_style TRUE)
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU"
           OR (NOT CMAKE_CXX_SIMULATE_ID STREQUAL "MSVC" AND NOT CMAKE_CXX_FLAGS MATCHES "-stdlib=libc\\+\\+"))
      set(gnu_static TRUE)             # GCC starts it as mapper without the compiler's runtime on the library path
    endif()
  elseif(HU_HOST_CXX)
    set(cxx "${HU_HOST_CXX}")
  else()
    unset(found)                       # (find_program does not search when its variable is already set)
    find_program(found NAMES c++ g++ clang++ NO_CACHE NO_CMAKE_FIND_ROOT_PATH)
    if(found)
      set(cxx "${found}")
    endif()
  endif()
  if(CMAKE_CROSSCOMPILING AND cxx)
    get_filename_component(cn "${cxx}" NAME_WE)
    if(cn MATCHES "^(cl|clang-cl)$")
      set(msvc_style TRUE)
    else()
      set(gnu_static TRUE)
    endif()
  endif()
  if(NOT cxx)
    message(STATUS "HeaderUnits: cross-compiling without a host C++ compiler (HU_HOST_CXX): no hu-mapper")
    return()
  endif()
  set(ok FALSE)
  if(EXISTS "${exe}" AND NOT "${src}" IS_NEWER_THAN "${exe}")
    execute_process(COMMAND "${exe}" -v RESULT_VARIABLE rc OUTPUT_VARIABLE v ERROR_QUIET)
    if(rc EQUAL 0 AND v MATCHES "^hu-mapper 3")
      set(ok TRUE)
    endif()
  endif()
  if(NOT ok)
    file(MAKE_DIRECTORY "${hudir}/helper")
    file(REMOVE "${hudir}/scan-cache.txt")      # (written by an earlier version of the program)
    # The program is named relative to the working directory (helper/): MinGW's linker opens its output with the
    # ANSI code page, which cannot spell every directory (Ninja hands it relative paths too).
    get_filename_component(rexe "${exe}" NAME)
    set(rexe "../${rexe}")
    if(msvc_style)
      set(tail /nologo /std:c++17 /EHsc /O1 "/Fe:${rexe}" "${src}")
    else()
      set(tail -std=c++17 -O1 -o "${rexe}" "${src}")
      if(gnu_static)
        list(APPEND tail -static-libstdc++ -static-libgcc)
        if(CMAKE_HOST_WIN32 AND (NOT CMAKE_CROSSCOMPILING OR NOT cxx MATCHES "clang"))
          list(APPEND tail -static)    # MinGW: no DLLs to find when GCC starts it (Ninja's PATH may lack its bin)
        endif()
      endif()
    endif()
    # With the project's flags (they may select the target, the C++ library or a GCC installation), and if that
    # fails (e.g. -Werror with a warning in this file), without them.
    set(out "")
    foreach(fl IN ITEMS 1 0)
      if(fl)
        set(cmd "${cxx}" ${args} ${tail})
      else()
        set(cmd "${cxx}" ${arg1} ${tail})
      endif()
      execute_process(COMMAND ${cmd} WORKING_DIRECTORY "${hudir}/helper"
                      RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE o)
      string(APPEND out "${o}")
      if(rc EQUAL 0)
        execute_process(COMMAND "${exe}" -v RESULT_VARIABLE rc OUTPUT_VARIABLE v ERROR_VARIABLE v2)
        string(APPEND out "${v}${v2}")
      endif()
      if(rc EQUAL 0 AND v MATCHES "^hu-mapper 3")
        set(ok TRUE)
        break()
      endif()
    endforeach()
    if(ok)
      message(STATUS "HeaderUnits: built ${exe}")
    else()
      file(REMOVE "${exe}")
      if(tc STREQUAL "GCC" AND NOT HU_GCC_WRAPPERS)
        message(WARNING "HeaderUnits: could not build hu-mapper with ${cxx} (${rc}); header units are compiled from "
          "wrappers and imports are scanned by CMake:\n${out}")
      else()
        message(STATUS "HeaderUnits: could not build hu-mapper with ${cxx} (${rc}); imports are scanned by CMake")
      endif()
    endif()
  endif()
  if(ok)
    set_property(GLOBAL PROPERTY _HU_HELPER "${exe}")
  endif()
endfunction()

# Runs hu-mapper's import scan on the request text <request> (see "scan" in hu-mapper.cpp; its cache is
# <hu dir>/scan-cache.txt) and sets <out> to the lines of the result, or to "" when native scanning is off or failed
# (the caller then scans with CMake).
function(_hu_native_scan out request)
  set(${out} "" PARENT_SCOPE)
  get_property(helper GLOBAL PROPERTY _HU_HELPER)
  get_property(native GLOBAL PROPERTY _HU_NATIVE_SCAN)
  if(NOT native OR NOT helper)
    return()
  endif()
  get_property(hudir GLOBAL PROPERTY _HU_DIR)
  get_property(n GLOBAL PROPERTY _HU_SCAN_COUNT)
  if(NOT n)
    set(n 0)
  endif()
  math(EXPR n "${n} + 1")
  set_property(GLOBAL PROPERTY _HU_SCAN_COUNT ${n})
  # (passed relative to the working directory: short, and ASCII whatever the build directory)
  file(WRITE "${hudir}/scan/request-${n}.txt" "cache ${hudir}/scan-cache.txt\n${request}")
  execute_process(COMMAND "${helper}" scan "request-${n}.txt" "result-${n}.txt" WORKING_DIRECTORY "${hudir}/scan"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE o)
  set(res "${hudir}/scan/result-${n}.txt")
  if(NOT rc EQUAL 0)
    message(WARNING "HeaderUnits: hu-mapper scan failed (${rc}); imports are scanned by CMake:\n${o}")
    return()
  endif()
  file(STRINGS "${res}" lines ENCODING UTF-8)
  set(${out} "${lines}" PARENT_SCOPE)
endfunction()
