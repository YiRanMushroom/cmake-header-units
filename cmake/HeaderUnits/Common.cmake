# HeaderUnits/Common.cmake -- toolchain-independent helpers: header lookup (try_compile probe and CMake-side), import
# scanning, the set registry, usage-requirement collection, and the consumer/set compatibility check.

include_guard(GLOBAL)

# ---------------------------------------------------------------------------------------------------------
# Resolve <name> -> absolute path exactly as the compiler does for "#include <name>" with the set's flags:
# one try_compile (same CMAKE_CXX_FLAGS, -std, usage requirements of LINK_LIBRARIES) whose probe TUs each
# include an empty marker header and then <name>, compiled with -H; the first depth-1 header after the
# marker is the resolved file.
function(_hu_resolve out_var set)
  cmake_parse_arguments(PARSE_ARGV 2 A "" "STD;EXT" "HEADERS;LIBS;DEFS;OPTS;INCS")
  get_property(hudir GLOBAL PROPERTY _HU_DIR)
  set(srcs)
  set(i 0)
  foreach(h IN LISTS A_HEADERS)
    set(marker "${hudir}/probe/hu_probe_marker_${i}.h")
    if(NOT EXISTS "${marker}")
      file(WRITE "${marker}" "\n")
    endif()
    list(APPEND srcs SOURCE_FROM_CONTENT "hu_probe_${i}.cpp" "#include \"${marker}\"\n#include <${h}>\n")
    math(EXPR i "${i} + 1")
  endforeach()
  set(defs)
  foreach(d IN LISTS A_DEFS)
    list(APPEND defs "-D${d}")
  endforeach()
  set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
  set(incflags)
  if(A_INCS)
    string(REPLACE ";" "\\;" incs_esc "${A_INCS}")
    set(incflags CMAKE_FLAGS "-DINCLUDE_DIRECTORIES=${incs_esc}")
  endif()
  try_compile(ok ${srcs}
    ${incflags}
    LINK_LIBRARIES ${A_LIBS}
    COMPILE_DEFINITIONS -H ${defs} ${A_OPTS}
    CXX_STANDARD ${A_STD} CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS ${A_EXT}
    OUTPUT_VARIABLE log
    NO_CACHE)
  if(NOT ok)
    message(FATAL_ERROR "HeaderUnits: add_header_units(${set}): probe compile failed -- a header cannot be found or "
      "does not compile on its own with the set's flags/LINK_LIBRARIES:\n${log}")
  endif()
  string(REPLACE "\r" "" log "${log}")
  string(REPLACE ";" "\\;" log "${log}")
  string(REPLACE "\n" ";" lines "${log}")
  set(cur "")
  foreach(line IN LISTS lines)
    if(line MATCHES "^\\. (.*)hu_probe_marker_([0-9]+)\\.h$")
      set(cur "${CMAKE_MATCH_2}")
    elseif(NOT cur STREQUAL "" AND line MATCHES "^\\. (.+)$")
      file(TO_CMAKE_PATH "${CMAKE_MATCH_1}" p)
      set(res_${cur} "${p}")
      set(cur "")
    endif()
  endforeach()
  set(paths)
  set(i 0)
  foreach(h IN LISTS A_HEADERS)
    if(NOT DEFINED res_${i})
      message(FATAL_ERROR "HeaderUnits: add_header_units(${set}): could not determine the file for <${h}> from the -H output:\n${log}")
    endif()
    list(APPEND paths "${res_${i}}")
    math(EXPR i "${i} + 1")
  endforeach()
  set(${out_var} "${paths}" PARENT_SCOPE)
endfunction()

function(_hu_bool out v)
  if(v)
    set(${out} ON PARENT_SCOPE)
  else()
    set(${out} OFF PARENT_SCOPE)
  endif()
endfunction()

# ---------------------------------------------------------------------------------------------------------
# Header-unit import declarations in a file ("import <x>;", "import \"x\";", optionally exported), as a list of
# "a|<name>" (angle) and "q|<name>" (quote).  Imports produced by macros or hidden in #if are not considered.
function(_hu_scan_imports out file)
  set(r)
  file(STRINGS "${file}" ls REGEX "^[ \t]*(export[ \t]+)?import[ \t]*[<\"][^>\"]+[>\"][ \t]*;")
  foreach(l IN LISTS ls)
    if(l MATCHES "import[ \t]*<([^>]+)>")
      list(APPEND r "a|${CMAKE_MATCH_1}")
    elseif(l MATCHES "import[ \t]*\"([^\"]+)\"")
      list(APPEND r "q|${CMAKE_MATCH_1}")
    endif()
  endforeach()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# "a|x" -> x ; "q|x" -> the normalized absolute path if x exists relative to <dir> (quote lookup), else x.
# CMake-side lookup of <name> in the given include dirs, then the compiler's implicit include dirs ("" if not found).
# The compiler's own #include <...> search list (implicit directories), from "<compiler> -E -v" once per configure.
# CMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES is not enough: it is empty for clang++ targeting MSVC.
function(_hu_compiler_include_dirs out)
  get_property(have GLOBAL PROPERTY _HU_COMPILER_INCLUDES SET)
  if(NOT have)
    get_property(hudir GLOBAL PROPERTY _HU_DIR)
    set(f "${hudir}/probe/empty.cpp")
    file(CONFIGURE OUTPUT "${f}" CONTENT "")
    separate_arguments(flags NATIVE_COMMAND "${CMAKE_CXX_FLAGS}")
    execute_process(COMMAND "${CMAKE_CXX_COMPILER}" ${flags} -x c++ -E -v "${f}"
                    OUTPUT_QUIET ERROR_VARIABLE err RESULT_VARIABLE rc)
    set(dirs ${CMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES})
    string(REPLACE "\r" "" err "${err}")
    string(REPLACE ";" "\\;" err "${err}")
    string(REPLACE "\n" ";" lines "${err}")
    set(in FALSE)
    foreach(l IN LISTS lines)
      if(l MATCHES "^#include <\\.\\.\\.> search starts here")
        set(in TRUE)
      elseif(l MATCHES "^End of search list")
        break()
      elseif(in AND l MATCHES "^ +(.+)$")
        string(REGEX REPLACE " \\(framework directory\\)$" "" d "${CMAKE_MATCH_1}")
        file(TO_CMAKE_PATH "${d}" d)
        list(APPEND dirs "${d}")
      endif()
    endforeach()
    set_property(GLOBAL PROPERTY _HU_COMPILER_INCLUDES "${dirs}")
  endif()
  get_property(v GLOBAL PROPERTY _HU_COMPILER_INCLUDES)
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

function(_hu_find_header out name)
  set(r "")
  if(IS_ABSOLUTE "${name}")
    if(EXISTS "${name}")
      set(r "${name}")
    endif()
  else()
    _hu_compiler_include_dirs(sys)
    foreach(d IN LISTS ARGN sys)
      if(d AND EXISTS "${d}/${name}" AND NOT IS_DIRECTORY "${d}/${name}")
        set(r "${d}/${name}")
        break()
      endif()
    endforeach()
  endif()
  if(r)
    cmake_path(NORMAL_PATH r)
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# Header unit lookup by import name (angle name, or absolute path for a quote import found next to the importer):
# outputs set, resolved path, BMI, (Clang) module name and module map; set is "" if no set provides it.
function(_hu_lookup prefix name)
  string(MD5 k "${name}")
  get_property(t GLOBAL PROPERTY _HU_NAME_SET_${k})
  if(NOT t AND IS_ABSOLUTE "${name}")
    get_property(t GLOBAL PROPERTY _HU_PATH_SET_${k})
  endif()
  set(${prefix}_SET "${t}" PARENT_SCOPE)
  if(NOT t)
    return()
  endif()
  get_property(hs GLOBAL PROPERTY _HU_SET_${t}_HEADERS)
  get_property(ps GLOBAL PROPERTY _HU_SET_${t}_PATHS)
  get_property(bs GLOBAL PROPERTY _HU_SET_${t}_CMIS)
  get_property(ms GLOBAL PROPERTY _HU_SET_${t}_MIDS)
  get_property(mm GLOBAL PROPERTY _HU_SET_${t}_MMAPS)
  list(FIND hs "${name}" idx)
  if(idx LESS 0)
    list(FIND ps "${name}" idx)
  endif()
  list(GET ps ${idx} p)
  list(GET bs ${idx} b)
  set(${prefix}_PATH "${p}" PARENT_SCOPE)
  set(${prefix}_BMI "${b}" PARENT_SCOPE)
  if(ms)
    list(GET ms ${idx} m)
    list(GET mm ${idx} mp)
    set(${prefix}_MID "${m}" PARENT_SCOPE)
    set(${prefix}_MAP "${mp}" PARENT_SCOPE)
  endif()
endfunction()

# Set plus the sets its header units import, transitively.
function(_hu_set_closure out s)
  set(r "${s}")
  set(todo "${s}")
  while(todo)
    list(POP_FRONT todo x)
    get_property(ds GLOBAL PROPERTY _HU_SET_${x}_DEPSETS)
    foreach(d IN LISTS ds)
      if(NOT d IN_LIST r)
        list(APPEND r "${d}")
        list(APPEND todo "${d}")
      endif()
    endforeach()
  endwhile()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

function(_hu_import_name out entry dir)
  string(SUBSTRING "${entry}" 2 -1 n)
  if(entry MATCHES "^q\\|" AND NOT IS_ABSOLUTE "${n}" AND EXISTS "${dir}/${n}")
    set(n "${dir}/${n}")
    cmake_path(NORMAL_PATH n)
  endif()
  set(${out} "${n}" PARENT_SCOPE)
endfunction()

# Usage requirements of LINK_LIBRARIES for the configure-time probe.  try_compile() accepts only IMPORTED targets
# (and follows their dependencies itself), so for in-tree targets the INTERFACE include directories and compile
# definitions are collected here, following INTERFACE_LINK_LIBRARIES recursively: ALIAS resolved, $<LINK_ONLY:...>
# (private dependencies of static libraries) and cross-directory markers (::@...) skipped, $<BUILD_INTERFACE:x> -> x,
# $<INSTALL_INTERFACE:...> dropped.  Other generator expressions cannot be evaluated at configure time and are
# skipped; they only matter if the probe then fails, which it does loudly (pass the missing pieces with
# INCLUDE_DIRECTORIES / COMPILE_DEFINITIONS).  Outputs <prefix>_LIBS, <prefix>_INCS, <prefix>_DEFS.
function(_hu_collect_usage prefix)
  set(libs)
  set(incs)
  set(defs)
  set(feats)
  set(seen)
  set(todo ${ARGN})
  list(LENGTH todo ntop)
  set(i 0)
  while(todo)
    list(POP_FRONT todo l)
    math(EXPR i "${i} + 1")
    if(l MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
      set(l "${CMAKE_MATCH_1}")
    endif()
    if(l STREQUAL "" OR l MATCHES "^::@" OR l MATCHES "\\$<")
      if(l MATCHES "\\$<" AND NOT l MATCHES "^\\$<(LINK_ONLY|INSTALL_INTERFACE):")
        message(VERBOSE "HeaderUnits: the header probe skips link item '${l}'")
      endif()
      continue()
    endif()
    if(NOT TARGET "${l}")
      if(i LESS_EQUAL ntop)
        list(APPEND libs "${l}")   # a plain library given directly: try_compile takes it as is
      endif()
      continue()
    endif()
    get_target_property(al "${l}" ALIASED_TARGET)
    if(al)
      set(l "${al}")
    endif()
    if(l IN_LIST seen)
      continue()
    endif()
    list(APPEND seen "${l}")
    get_target_property(fe "${l}" INTERFACE_COMPILE_FEATURES)
    if(fe)
      foreach(f IN LISTS fe)
        if(NOT f MATCHES "\\$<")
          list(APPEND feats "${f}")
        endif()
      endforeach()
    endif()
    get_target_property(imp "${l}" IMPORTED)
    if(imp)
      list(APPEND libs "${l}")
      # followed for compile features only (try_compile follows an IMPORTED target's dependencies itself)
      get_target_property(ill "${l}" INTERFACE_LINK_LIBRARIES)
      if(ill)
        list(APPEND todo ${ill})
      endif()
      continue()
    endif()
    foreach(prop INTERFACE_INCLUDE_DIRECTORIES INTERFACE_COMPILE_DEFINITIONS)
      get_target_property(vals "${l}" ${prop})
      if(NOT vals)
        continue()
      endif()
      foreach(v IN LISTS vals)
        if(v MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
          set(v "${CMAKE_MATCH_1}")
        endif()
        if(v STREQUAL "" OR v MATCHES "\\$<")
          continue()
        endif()
        if(prop STREQUAL "INTERFACE_INCLUDE_DIRECTORIES")
          list(APPEND incs "${v}")
        else()
          list(APPEND defs "${v}")
        endif()
      endforeach()
    endforeach()
    get_target_property(ill "${l}" INTERFACE_LINK_LIBRARIES)
    if(ill)
      list(APPEND todo ${ill})
    endif()
  endwhile()
  foreach(v libs incs defs feats)
    if(${v})
      list(REMOVE_DUPLICATES ${v})
    endif()
  endforeach()
  set(${prefix}_LIBS "${libs}" PARENT_SCOPE)
  set(${prefix}_INCS "${incs}" PARENT_SCOPE)
  set(${prefix}_DEFS "${defs}" PARENT_SCOPE)
  set(${prefix}_FEATS "${feats}" PARENT_SCOPE)
endfunction()

# All C++ sources of a target, as absolute paths (SOURCES + CXX_MODULES file sets).
function(_hu_target_cxx_sources out tgt)
  get_target_property(sdir ${tgt} SOURCE_DIR)
  get_target_property(bdir ${tgt} BINARY_DIR)
  get_target_property(srcs ${tgt} SOURCES)
  if(NOT srcs)
    set(srcs)
  endif()
  get_target_property(msets ${tgt} CXX_MODULE_SETS)
  if(msets)
    foreach(ms IN LISTS msets)
      if(ms STREQUAL "CXX_MODULES")
        get_target_property(f ${tgt} CXX_MODULE_SET)
      else()
        get_target_property(f ${tgt} CXX_MODULE_SET_${ms})
      endif()
      if(f)
        list(APPEND srcs ${f})
      endif()
    endforeach()
  endif()
  set(res)
  foreach(s IN LISTS srcs)
    if(s MATCHES "\\$<")
      message(FATAL_ERROR "target_import_header_units(${tgt}): source '${s}' is a generator expression; list the sources with SOURCES.")
    endif()
    if(NOT s MATCHES "\\.(cpp|cc|cxx|c\\+\\+|C|cppm|ixx|mpp|cxxm|ccm|c\\+\\+m)$")
      continue()
    endif()
    if(IS_ABSOLUTE "${s}")
      set(a "${s}")
    elseif(EXISTS "${sdir}/${s}")
      set(a "${sdir}/${s}")
    else()
      set(a "${bdir}/${s}")
    endif()
    cmake_path(NORMAL_PATH a)
    list(APPEND res "${a}")
  endforeach()
  list(REMOVE_DUPLICATES res)
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

function(_hu_check_compat consumer set)
  get_property(std GLOBAL PROPERTY _HU_SET_${set}_STD)
  get_property(ext GLOBAL PROPERTY _HU_SET_${set}_EXT)
  get_property(sdir GLOBAL PROPERTY _HU_SET_${set}_DIR)
  # The consumer's effective standard: CXX_STANDARD, or the compiler default when it is unset, raised by compile
  # features (its own and those of its link interface), as CMake picks the -std flag.  E.g. a target with only
  # target_compile_features(cxx_std_20) gets no -std flag on GCC 16, whose default is already C++20.
  get_target_property(cstd ${consumer} CXX_STANDARD)
  if(NOT cstd)
    set(cstd "${CMAKE_CXX_STANDARD_DEFAULT}")
  endif()
  get_target_property(feats ${consumer} COMPILE_FEATURES)
  if(NOT feats)
    set(feats)
  endif()
  get_target_property(cll ${consumer} LINK_LIBRARIES)
  if(cll)
    _hu_collect_usage(CU ${cll})
    list(APPEND feats ${CU_FEATS})
  endif()
  set(cfeat "")
  foreach(f IN LISTS feats)
    if(f MATCHES "^cxx_std_([0-9]+)$" AND CMAKE_MATCH_1 GREATER cstd)
      set(cstd "${CMAKE_MATCH_1}")
      set(cfeat " (raised by compile feature ${f})")
    endif()
  endforeach()
  get_target_property(cext ${consumer} CXX_EXTENSIONS)
  if(cext STREQUAL "cext-NOTFOUND")
    set(cext "${CMAKE_CXX_EXTENSIONS_DEFAULT}")
  endif()
  _hu_bool(cext "${cext}")
  set(why "")
  if(NOT cstd STREQUAL std)
    string(APPEND why "\n  consumer's C++ standard is C++${cstd}${cfeat} (CXX_STANDARD, else the compiler default) but the set was built with CXX_STANDARD=${std}")
  endif()
  if(NOT cext STREQUAL ext)
    string(APPEND why "\n  consumer CXX_EXTENSIONS=${cext} but the set uses CXX_EXTENSIONS=${ext} (-std=c++NN vs -std=gnu++NN)")
  endif()
  get_target_property(opts ${consumer} COMPILE_OPTIONS)
  foreach(o IN LISTS opts)
    if(o MATCHES "^-std=|^/std:")
      string(APPEND why "\n  consumer has compile option '${o}'")
    endif()
  endforeach()
  # Exceptions / RTTI must match (both compilers reject a mismatch when the BMI is loaded).
  get_property(sopts GLOBAL PROPERTY _HU_SET_${set}_OPTS)
  set(a "")
  set(b "")
  foreach(o IN LISTS opts)
    if(o MATCHES "^-f(no-)?(exceptions|rtti)$")
      list(APPEND a "${o}")
    endif()
  endforeach()
  foreach(o IN LISTS sopts)
    if(o MATCHES "^-f(no-)?(exceptions|rtti)$")
      list(APPEND b "${o}")
    endif()
  endforeach()
  if(NOT "${a}" STREQUAL "${b}")
    string(APPEND why "\n  exceptions/RTTI options differ: consumer '${a}', set '${b}'")
  endif()
  # PIC: both compilers silently accept a mismatch; only predefined macros (__PIC__/__pic__) differ.
  get_property(spic GLOBAL PROPERTY _HU_SET_${set}_PIC)
  get_target_property(type ${consumer} TYPE)
  get_target_property(cpic ${consumer} POSITION_INDEPENDENT_CODE)
  if(type MATCHES "SHARED_LIBRARY|MODULE_LIBRARY")
    set(cpic ON)
  endif()
  _hu_bool(cpic "${cpic}")
  if(NOT cpic STREQUAL spic)
    message(WARNING "target_import_header_units(${consumer} ${set}): POSITION_INDEPENDENT_CODE is ${cpic} for the consumer "
      "but ${spic} for the set. GCC and Clang accept this silently; only __PIC__-dependent preprocessor branches in the "
      "headers could differ. Pass POSITION_INDEPENDENT_CODE to add_header_units() to match.")
  endif()
  get_target_property(cdir ${consumer} SOURCE_DIR)
  foreach(v CMAKE_CXX_FLAGS CMAKE_CXX_FLAGS_${CMAKE_BUILD_TYPE})
    get_directory_property(a DIRECTORY "${cdir}" DEFINITION ${v})
    get_directory_property(b DIRECTORY "${sdir}" DEFINITION ${v})
    if(NOT a STREQUAL b)
      string(APPEND why "\n  ${v} differs between the consumer's directory ('${a}') and the set's directory ('${b}')")
    endif()
  endforeach()
  get_property(tc GLOBAL PROPERTY _HU_TC)
  cmake_language(CALL _hu_${tc}_check_compat)
  if(why)
    message(FATAL_ERROR "target_import_header_units(${consumer} ${set}): target '${consumer}' is incompatible with "
      "header-unit set '${set}':${why}\nA header unit must be compiled with exactly the consumer's language settings.")
  endif()
endfunction()
