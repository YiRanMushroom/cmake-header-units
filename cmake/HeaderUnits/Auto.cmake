# HeaderUnits/Auto.cmake -- target_auto_header_units(): header units discovered from the import declarations of a
# target's sources.

include_guard(GLOBAL)

# target_auto_header_units(<target> [LINK_LIBRARIES ...] [INCLUDE_DIRECTORIES ...] [COMPILE_DEFINITIONS ...]
#                          [COMPILE_OPTIONS ...] [CXX_STANDARD <n>] [CXX_EXTENSIONS <bool>] [EXCLUDE <name>...]
#                          [NO_RECONFIGURE])
# Scans the target's C++ sources for "import <x>;" / "import \"x\";" and makes every imported header a header unit
# of the target:
#   * headers that already belong to a set (any target's) are reused, matched by the file the name resolves to;
#   * the rest go into a new set <target>_hu, built with the target's direct LINK_LIBRARIES (targets only),
#     INCLUDE_DIRECTORIES, COMPILE_DEFINITIONS and COMPILE_OPTIONS (plain values and $<BUILD_INTERFACE:...>; no warning
#     options), CXX_STANDARD and CXX_EXTENSIONS, plus the given ones;
#   * "x" found next to the importing source is used by absolute path (like the compiler's quote lookup);
#   * with HU_ALLOW_HEADER_IMPORTS ON, headers imported by those headers are added too (recursively).
# The scanned sources become CMAKE_CONFIGURE_DEPENDS (a new import re-runs CMake) unless NO_RECONFIGURE.
# The scan runs at the end of the directory (CMakeLists.txt) of the call, so the target's sources and settings may come
# after the command in the same file.  Changes made later from another directory are not seen; they are reported.
function(target_auto_header_units tgt)
  _hu_auto_request(target_auto_header_units ${tgt} ${ARGN})
endfunction()

# target_header_units_scan_sources(<target> <src>... [same options as target_auto_header_units])
# The same, but only the listed sources (paths relative to the current source directory) are scanned, and only they
# receive the header units; the target's other sources are left alone (their #includes stay textual).  Can be called
# several times for one target: headers that already have a header unit are reused.
function(target_header_units_scan_sources tgt)
  _hu_auto_request(target_header_units_scan_sources ${tgt} ${ARGN})
endfunction()

# Call time: check the arguments and record the request.  The scan (_hu_auto_run) is deferred to the end of the
# current directory; requests of the top-level directory run from _hu_finalize, which is scheduled before them.
function(_hu_auto_request cmd tgt)
  cmake_parse_arguments(PARSE_ARGV 2 A "NO_RECONFIGURE" "CXX_STANDARD;CXX_EXTENSIONS"
    "LINK_LIBRARIES;INCLUDE_DIRECTORIES;COMPILE_DEFINITIONS;COMPILE_OPTIONS;EXCLUDE")
  set(only)
  if(cmd STREQUAL "target_header_units_scan_sources")
    if(NOT A_UNPARSED_ARGUMENTS)
      message(FATAL_ERROR "${cmd}(${tgt}): no sources given.")
    endif()
    foreach(s IN LISTS A_UNPARSED_ARGUMENTS)
      cmake_path(ABSOLUTE_PATH s BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE OUTPUT_VARIABLE a)
      list(APPEND only "${a}")
    endforeach()
  elseif(A_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "${cmd}(${tgt}): unexpected arguments: ${A_UNPARSED_ARGUMENTS}")
  endif()
  if(NOT TARGET ${tgt})
    message(FATAL_ERROR "${cmd}: '${tgt}' is not a target.")
  endif()
  set(incs)
  foreach(i IN LISTS A_INCLUDE_DIRECTORIES)
    if(NOT i MATCHES "\\$<")
      cmake_path(ABSOLUTE_PATH i BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE)
    endif()
    list(APPEND incs "${i}")
  endforeach()
  get_property(i GLOBAL PROPERTY _HU_AUTO_COUNT)
  if(NOT i)
    set(i 0)
  endif()
  math(EXPR i "${i} + 1")
  set_property(GLOBAL PROPERTY _HU_AUTO_COUNT ${i})
  set(p _HU_AUTO_${i})
  set_property(GLOBAL PROPERTY ${p}_CMD "${cmd}")
  set_property(GLOBAL PROPERTY ${p}_TGT "${tgt}")
  set_property(GLOBAL PROPERTY ${p}_ONLY "${only}")
  set_property(GLOBAL PROPERTY ${p}_LIBS "${A_LINK_LIBRARIES}")
  set_property(GLOBAL PROPERTY ${p}_INCS "${incs}")
  set_property(GLOBAL PROPERTY ${p}_DEFS "${A_COMPILE_DEFINITIONS}")
  set_property(GLOBAL PROPERTY ${p}_OPTS "${A_COMPILE_OPTIONS}")
  set_property(GLOBAL PROPERTY ${p}_EXCLUDE "${A_EXCLUDE}")
  set_property(GLOBAL PROPERTY ${p}_NORECONF "${A_NO_RECONFIGURE}")
  set_property(GLOBAL PROPERTY ${p}_STD_GIVEN OFF)
  if(DEFINED A_CXX_STANDARD)
    set_property(GLOBAL PROPERTY ${p}_STD_GIVEN ON)
    set_property(GLOBAL PROPERTY ${p}_STD "${A_CXX_STANDARD}")
  endif()
  set_property(GLOBAL PROPERTY ${p}_EXT_GIVEN OFF)
  if(DEFINED A_CXX_EXTENSIONS)
    set_property(GLOBAL PROPERTY ${p}_EXT_GIVEN ON)
    set_property(GLOBAL PROPERTY ${p}_EXT "${A_CXX_EXTENSIONS}")
  endif()
  set_property(GLOBAL PROPERTY ${p}_ALLOW "${HU_ALLOW_HEADER_IMPORTS}")
  set_property(GLOBAL PROPERTY ${p}_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  set_property(GLOBAL PROPERTY ${p}_DONE OFF)
  _hu_schedule_finalize()
  # (arguments of a deferred call are expanded when it runs: pass the value, not ${i})
  cmake_language(EVAL CODE "cmake_language(DEFER CALL _hu_auto_run ${i})")
endfunction()

function(_hu_auto_run i)
  set(p _HU_AUTO_${i})
  get_property(done GLOBAL PROPERTY ${p}_DONE)
  if(done)
    return()
  endif()
  set_property(GLOBAL PROPERTY ${p}_DONE ON)
  get_property(cmd GLOBAL PROPERTY ${p}_CMD)
  get_property(tgt GLOBAL PROPERTY ${p}_TGT)
  get_property(only GLOBAL PROPERTY ${p}_ONLY)
  get_property(A_LINK_LIBRARIES GLOBAL PROPERTY ${p}_LIBS)
  get_property(A_INCLUDE_DIRECTORIES GLOBAL PROPERTY ${p}_INCS)
  get_property(A_COMPILE_DEFINITIONS GLOBAL PROPERTY ${p}_DEFS)
  get_property(A_COMPILE_OPTIONS GLOBAL PROPERTY ${p}_OPTS)
  get_property(A_EXCLUDE GLOBAL PROPERTY ${p}_EXCLUDE)
  get_property(A_NO_RECONFIGURE GLOBAL PROPERTY ${p}_NORECONF)
  get_property(given GLOBAL PROPERTY ${p}_STD_GIVEN)
  if(given)
    get_property(A_CXX_STANDARD GLOBAL PROPERTY ${p}_STD)
  endif()
  get_property(given GLOBAL PROPERTY ${p}_EXT_GIVEN)
  if(given)
    get_property(A_CXX_EXTENSIONS GLOBAL PROPERTY ${p}_EXT)
  endif()
  get_property(HU_ALLOW_HEADER_IMPORTS GLOBAL PROPERTY ${p}_ALLOW)
  foreach(prop IN ITEMS SOURCES LINK_LIBRARIES INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS CXX_STANDARD)
    get_target_property(v ${tgt} ${prop})
    if(v MATCHES "-NOTFOUND$")
      set(v "")             # unset (the NOTFOUND value names the variable, so it differs between reads)
    endif()
    set_property(GLOBAL PROPERTY ${p}_SNAP_${prop} "${v}")
  endforeach()
  get_target_property(sdir ${tgt} SOURCE_DIR)
  get_target_property(srcs ${tgt} SOURCES)
  if(NOT srcs)
    set(srcs)
  endif()
  get_target_property(msets ${tgt} CXX_MODULE_SETS)
  if(msets)
    foreach(ms IN LISTS msets)
      get_target_property(mf ${tgt} CXX_MODULE_SET_${ms})
      if(mf)
        list(APPEND srcs ${mf})
      endif()
    endforeach()
  endif()
  # the target's C++ sources, absolute
  set(all)
  foreach(s IN LISTS srcs)
    if(s MATCHES "\\$<" OR NOT s MATCHES "\\.(cpp|cc|cxx|c\\+\\+|C|cppm|ccm|cxxm|c\\+\\+m|ixx|mpp)$")
      continue()
    endif()
    if(NOT IS_ABSOLUTE "${s}")
      set(s "${sdir}/${s}")
    endif()
    cmake_path(NORMAL_PATH s)
    list(APPEND all "${s}")
  endforeach()
  if(only)
    set(pick)
    foreach(s IN LISTS only)
      cmake_path(ABSOLUTE_PATH s BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE OUTPUT_VARIABLE a)
      if(NOT a IN_LIST all)
        message(FATAL_ERROR "${cmd}(${tgt}): '${s}' is not a C++ source of target '${tgt}'.")
      endif()
      if(NOT EXISTS "${a}")
        message(FATAL_ERROR "${cmd}(${tgt}): '${s}' does not exist at configure time (a generated source cannot be scanned).")
      endif()
      list(APPEND pick "${a}")
    endforeach()
    set(all ${pick})
  endif()
  set(names)
  set(files)
  foreach(s IN LISTS all)
    if(NOT EXISTS "${s}")
      continue()
    endif()
    list(APPEND files "${s}")
    _hu_scan_imports(imps "${s}")
    get_filename_component(d "${s}" DIRECTORY)
    foreach(e IN LISTS imps)
      _hu_import_name(n "${e}" "${d}")
      list(APPEND names "${n}")
    endforeach()
  endforeach()
  if(files AND NOT A_NO_RECONFIGURE)
    set_property(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${files})
  endif()
  if(names)
    list(REMOVE_DUPLICATES names)
  endif()
  if(A_EXCLUDE AND names)
    list(REMOVE_ITEM names ${A_EXCLUDE})
  endif()
  if(NOT names)
    message(STATUS "HeaderUnits: ${cmd}(${tgt}): no header-unit imports found.")
    return()
  endif()

  # Flags for a new set: the target's own usage context.
  set(libs ${A_LINK_LIBRARIES})
  get_target_property(ll ${tgt} LINK_LIBRARIES)
  if(ll)
    foreach(l IN LISTS ll)
      if(NOT l MATCHES "\\$<" AND TARGET "${l}")
        list(APPEND libs "${l}")
      endif()
    endforeach()
  endif()
  set(incs ${A_INCLUDE_DIRECTORIES})
  get_target_property(ti ${tgt} INCLUDE_DIRECTORIES)
  if(ti)
    foreach(i IN LISTS ti)
      if(i MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
        set(i "${CMAKE_MATCH_1}")
      endif()
      if(NOT i MATCHES "\\$<")
        list(APPEND incs "${i}")
      endif()
    endforeach()
  endif()
  set(defs ${A_COMPILE_DEFINITIONS})
  get_target_property(td ${tgt} COMPILE_DEFINITIONS)
  if(td)
    foreach(d IN LISTS td)
      if(NOT d MATCHES "\\$<")
        list(APPEND defs "${d}")
      endif()
    endforeach()
  endif()
  # The target's compile options, except warning options (they do not change the BMI, and a third-party header
  # compiled on its own is not a system header).  Generator expressions are not copied.
  set(opts ${A_COMPILE_OPTIONS})
  get_target_property(to ${tgt} COMPILE_OPTIONS)
  if(to)
    foreach(o IN LISTS to)
      if(o MATCHES "\\$<" OR (o MATCHES "^-(W|pedantic)" AND NOT o MATCHES "^-W[apl],"))
        continue()
      endif()
      list(APPEND opts "${o}")
    endforeach()
  endif()
  set(stdargs)
  if(DEFINED A_CXX_STANDARD)
    list(APPEND stdargs CXX_STANDARD ${A_CXX_STANDARD})
  else()
    get_target_property(tstd ${tgt} CXX_STANDARD)
    if(tstd)
      list(APPEND stdargs CXX_STANDARD ${tstd})
    endif()
  endif()
  if(DEFINED A_CXX_EXTENSIONS)
    list(APPEND stdargs CXX_EXTENSIONS ${A_CXX_EXTENSIONS})
  else()
    get_target_property(text ${tgt} CXX_EXTENSIONS)
    if(NOT text STREQUAL "text-NOTFOUND")
      list(APPEND stdargs CXX_EXTENSIONS ${text})
    endif()
  endif()

  # A name that cannot be found with the target's include paths is skipped: typically an import in an inactive #if
  # branch (a platform-specific header).  If such an import is active after all, the compiler reports it.
  _hu_set_search_dirs(search INCS ${incs} LIBS ${libs} OPTS ${opts})
  set(kept)
  foreach(n IN LISTS names)
    _hu_find_header(cand "${n}" ${search})
    if(cand)
      list(APPEND kept "${n}")
    else()
      message(VERBOSE "HeaderUnits: ${cmd}(${tgt}): <${n}> is not found with the target's include "
        "paths and is skipped (an import in an inactive #if branch?).")
    endif()
  endforeach()
  set(names ${kept})
  if(NOT names)
    message(STATUS "HeaderUnits: ${cmd}(${tgt}): no importable headers found.")
    return()
  endif()

  set(used)
  set(todo ${names})
  while(todo)
    set(fresh)
    foreach(n IN LISTS todo)
      # Reuse by the file this target actually includes, not by the name: <config.h> may be a different file for
      # another target (its own include directories).
      set(s "")
      _hu_find_header(cand "${n}" ${search})
      if(cand)
        file(REAL_PATH "${cand}" rp)
        string(MD5 k "${rp}")
        get_property(s GLOBAL PROPERTY _HU_REAL_SET_${k})
      else()
        string(MD5 k "${n}")
        get_property(s GLOBAL PROPERTY _HU_NAME_SET_${k})
      endif()
      if(s)
        list(APPEND used ${s})
      else()
        list(APPEND fresh "${n}")
      endif()
    endforeach()
    if(NOT fresh)
      break()
    endif()
    set(sn "${tgt}_hu")
    set(i 2)
    while(TARGET ${sn})
      set(sn "${tgt}_hu_${i}")
      math(EXPR i "${i} + 1")
    endwhile()
    add_header_units(${sn} HEADERS ${fresh} LINK_LIBRARIES ${libs} INCLUDE_DIRECTORIES ${incs}
                     COMPILE_DEFINITIONS ${defs} COMPILE_OPTIONS ${opts} ${stdargs})
    list(APPEND used ${sn})
    set(todo)
    if(HU_ALLOW_HEADER_IMPORTS)
      get_property(ps GLOBAL PROPERTY _HU_SET_${sn}_PATHS)
      foreach(p IN LISTS ps)
        string(MD5 hk "${p}")
        get_property(imps GLOBAL PROPERTY _HU_HDRIMPORTS_${hk})
        get_filename_component(d "${p}" DIRECTORY)
        foreach(e IN LISTS imps)
          _hu_import_name(n "${e}" "${d}")
          list(APPEND todo "${n}")
        endforeach()
      endforeach()
      if(todo)
        list(REMOVE_DUPLICATES todo)
      endif()
    endif()
  endwhile()
  list(REMOVE_DUPLICATES used)
  foreach(s IN LISTS used)
    if(only)
      target_import_header_units(${tgt} ${s} SOURCES ${files})
    else()
      target_import_header_units(${tgt} ${s})
    endif()
  endforeach()
  string(JOIN ", " ul ${used})
  message(STATUS "HeaderUnits: ${cmd}(${tgt}): ${ul}")
endfunction()

# Called first by _hu_finalize (end of the top-level directory): runs the requests still pending (those of the
# top-level directory), then reports targets changed after their request ran (e.g. from a parent directory).
function(_hu_auto_finish)
  get_property(na GLOBAL PROPERTY _HU_AUTO_COUNT)
  if(NOT na)
    return()
  endif()
  foreach(i RANGE 1 ${na})
    _hu_auto_run(${i})
  endforeach()
  foreach(i RANGE 1 ${na})
    set(p _HU_AUTO_${i})
    get_property(cmd GLOBAL PROPERTY ${p}_CMD)
    get_property(tgt GLOBAL PROPERTY ${p}_TGT)
    get_property(dir GLOBAL PROPERTY ${p}_DIR)
    set(changed)
    foreach(prop IN ITEMS SOURCES LINK_LIBRARIES INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS CXX_STANDARD)
      get_property(old GLOBAL PROPERTY ${p}_SNAP_${prop})
      get_target_property(now ${tgt} ${prop})
      if(now MATCHES "-NOTFOUND$")
        set(now "")
      endif()
      if(NOT "${now}" STREQUAL "${old}")
        list(APPEND changed ${prop})
      endif()
    endforeach()
    if(changed)
      string(JOIN ", " cl ${changed})
      message(WARNING "HeaderUnits: ${cmd}(${tgt}): the target's ${cl} changed after its header units were set up "
        "at the end of ${dir}/CMakeLists.txt (by a command in another directory?).  The header units do not see the "
        "change; make these settings in that directory.")
    endif()
  endforeach()
endfunction()
