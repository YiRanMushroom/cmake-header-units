# HeaderUnits/Core.cmake -- add_header_units(), target_import_header_units() and the end-of-configure finalization.
# Toolchain-specific steps are macros of GCC.cmake / Clang.cmake, called as cmake_language(CALL _hu_${tc}_<step>).

include_guard(GLOBAL)

function(add_header_units set)
  cmake_parse_arguments(PARSE_ARGV 1 A "" "CXX_STANDARD;CXX_EXTENSIONS;POSITION_INDEPENDENT_CODE" "HEADERS;LINK_LIBRARIES;COMPILE_DEFINITIONS;COMPILE_OPTIONS;INCLUDE_DIRECTORIES")
  get_property(tc GLOBAL PROPERTY _HU_TC)
  get_property(hudir GLOBAL PROPERTY _HU_DIR)
  if(A_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "add_header_units(${set}): unexpected arguments: ${A_UNPARSED_ARGUMENTS}")
  endif()
  if(TARGET ${set})
    message(FATAL_ERROR "add_header_units(${set}): a target named '${set}' already exists.")
  endif()
  if(NOT set MATCHES "^[A-Za-z0-9_.+-]+$")
    message(FATAL_ERROR "add_header_units(${set}): set names may only contain [A-Za-z0-9_.+-].")
  endif()
  if(NOT A_HEADERS)
    message(FATAL_ERROR "add_header_units(${set}): HEADERS is empty.")
  endif()
  # Header resolution uses try_compile(), which only accepts IMPORTED targets: _hu_collect_usage() gathers the
  # usage requirements of in-tree targets (recursively).  The OBJECT library that builds the BMIs links
  # LINK_LIBRARIES normally, so its real compile gets CMake's full transitive usage requirements.
  _hu_collect_usage(U ${A_LINK_LIBRARIES})
  set(probe_libs ${U_LIBS})
  set(probe_incs ${A_INCLUDE_DIRECTORIES} ${U_INCS})
  set(probe_defs ${A_COMPILE_DEFINITIONS} ${U_DEFS})
  # Language level of the set (consumers must match exactly: GCC and Clang reject -std mismatches).
  if(DEFINED A_CXX_STANDARD)
    set(std "${A_CXX_STANDARD}")
  else()
    set(std "${CMAKE_CXX_STANDARD}")
  endif()
  if(NOT std OR std LESS 20)
    message(FATAL_ERROR "add_header_units(${set}): needs CXX_STANDARD >= 20 (set CMAKE_CXX_STANDARD or pass CXX_STANDARD).")
  endif()
  if(DEFINED A_CXX_EXTENSIONS)
    _hu_bool(ext "${A_CXX_EXTENSIONS}")
  elseif(DEFINED CMAKE_CXX_EXTENSIONS)
    _hu_bool(ext "${CMAKE_CXX_EXTENSIONS}")
  else()
    _hu_bool(ext "${CMAKE_CXX_EXTENSIONS_DEFAULT}")
  endif()
  list(REMOVE_DUPLICATES A_HEADERS)
  if(CMAKE_INTERMEDIATE_DIR_STRATEGY STREQUAL "SHORT")
    message(FATAL_ERROR "add_header_units(${set}): CMAKE_INTERMEDIATE_DIR_STRATEGY=SHORT is not supported "
      "(the module needs to know where the header-unit BMIs, i.e. the set's object files, are written).")
  endif()

  # Headers that contain import declarations cannot go through the try_compile probe (the header units they
  # import do not exist at configure time): find them CMake-side first.  Without HU_ALLOW_HEADER_IMPORTS
  # such a header is an error; with it, the CMake-side path is used directly.
  set(search_incs ${probe_incs})
  foreach(l IN LISTS probe_libs)
    if(TARGET ${l})
      get_target_property(li ${l} INTERFACE_INCLUDE_DIRECTORIES)
      if(li)
        foreach(i IN LISTS li)
          if(NOT i MATCHES "\\$<")
            list(APPEND search_incs "${i}")
          endif()
        endforeach()
      endif()
    endif()
  endforeach()
  set(probe_headers)
  foreach(h IN LISTS A_HEADERS)
    _hu_find_header(cand "${h}" ${search_incs})
    set(imps)
    if(cand)
      _hu_scan_imports(imps "${cand}")
    endif()
    if(imps)
      if(NOT HU_ALLOW_HEADER_IMPORTS)
        set(shown "${imps}")
        list(TRANSFORM shown REPLACE "^a\\|(.*)$" "import <\\1>")
        list(TRANSFORM shown REPLACE "^q\\|(.*)$" "import \"\\1\"")
        string(JOIN ", " shown ${shown})
        message(FATAL_ERROR "add_header_units(${set}): header <${h}> ('${cand}') contains ${shown}. Import declarations "
          "inside headers are not supported yet: use #include in headers (inside a TU that receives the header units, "
          "a #include of a header unit is turned into an import automatically), or set HU_ALLOW_HEADER_IMPORTS ON "
          "(experimental: header units that import other header units).")
      endif()
      string(MAKE_C_IDENTIFIER "${h}" hid)
      set(direct_${hid} "${cand}")
    else()
      list(APPEND probe_headers "${h}")
    endif()
  endforeach()
  set(probe_paths)
  if(probe_headers)
    _hu_resolve(probe_paths ${set} HEADERS ${probe_headers} LIBS ${probe_libs} DEFS ${probe_defs} INCS ${probe_incs}
                OPTS ${A_COMPILE_OPTIONS} STD ${std} EXT ${ext})
  endif()
  set(paths)
  foreach(h IN LISTS A_HEADERS)
    string(MAKE_C_IDENTIFIER "${h}" hid)
    if(DEFINED direct_${hid})
      list(APPEND paths "${direct_${hid}}")
    else()
      list(POP_FRONT probe_paths pp)
      list(APPEND paths "${pp}")
    endif()
  endforeach()

  add_library(${set} OBJECT)
  # Ordering anchor: a utility target that is complete only when every BMI of the set is built.  Consumers
  # depend on it, so their object-order phony (and that of any BMI target CMake synthesizes from them for
  # cross-target importers of their named modules, Kitware #28166) waits for the BMIs.
  add_custom_target(${set}_ready)
  add_dependencies(${set}_ready ${set})
  set_target_properties(${set} PROPERTIES
    CXX_STANDARD ${std} CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS ${ext}
    CXX_SCAN_FOR_MODULES OFF)       # header units are not scanned: each is built in isolation
  if(A_LINK_LIBRARIES)
    target_link_libraries(${set} PRIVATE ${A_LINK_LIBRARIES})
  endif()
  if(A_COMPILE_DEFINITIONS)
    target_compile_definitions(${set} PRIVATE ${A_COMPILE_DEFINITIONS})
  endif()
  if(A_INCLUDE_DIRECTORIES)
    target_include_directories(${set} PRIVATE ${A_INCLUDE_DIRECTORIES})
  endif()
  if(A_COMPILE_OPTIONS)
    target_compile_options(${set} PRIVATE ${A_COMPILE_OPTIONS})
  endif()
  if(DEFINED A_POSITION_INDEPENDENT_CODE)
    _hu_bool(pic "${A_POSITION_INDEPENDENT_CODE}")
  else()
    _hu_bool(pic "${CMAKE_POSITION_INDEPENDENT_CODE}")
  endif()
  set_target_properties(${set} PROPERTIES POSITION_INDEPENDENT_CODE ${pic})

  set(cmis)
  set(rpaths)
  set(abs_src FALSE)
  set(mids)
  set(mmaps)
  set(hmaps)
  set(maplines "")
  foreach(h p IN ZIP_LISTS A_HEADERS paths)
    if(IS_ABSOLUTE "${h}")
      # a header found relative to a source file (quote import), given by absolute path: short object name
      string(MD5 hh "${h}")
      string(SUBSTRING "${hh}" 0 8 hh)
      get_filename_component(fn "${h}" NAME)
      set(oname "abs/${hh}_${fn}")
    else()
      set(oname "${h}")
    endif()
    string(REGEX REPLACE "[^A-Za-z0-9_./+-]" "_" oname "${oname}")
    string(REPLACE ".." "__" oname "${oname}")
    cmake_language(CALL _hu_${tc}_add_header)
    target_sources(${set} PRIVATE "${p}")
    list(APPEND rpaths "${p}")
  endforeach()

  cmake_language(CALL _hu_${tc}_finish_set)

  # Import declarations inside the headers: an error unless HU_ALLOW_HEADER_IMPORTS is ON (experimental).
  foreach(h p IN ZIP_LISTS A_HEADERS rpaths)
    _hu_scan_imports(imps "${p}")
    if(NOT imps)
      continue()
    endif()
    if(NOT HU_ALLOW_HEADER_IMPORTS)
      set(shown "${imps}")
      list(TRANSFORM shown REPLACE "^a\\|(.*)$" "import <\\1>")
      list(TRANSFORM shown REPLACE "^q\\|(.*)$" "import \"\\1\"")
      string(JOIN ", " shown ${shown})
      message(FATAL_ERROR "add_header_units(${set}): header <${h}> ('${p}') contains ${shown}. Import declarations inside "
        "headers are not supported yet: use #include in headers (inside a TU that receives the header units, a "
        "#include of a header unit is turned into an import automatically), or set HU_ALLOW_HEADER_IMPORTS ON "
        "(experimental: header units that import other header units).")
    endif()
    string(MD5 hk "${p}")
    set_property(GLOBAL PROPERTY _HU_HDRIMPORTS_${hk} "${imps}")
  endforeach()
  # Registry: header name / resolved path -> set (used by target_auto_header_units and header imports).
  foreach(h p IN ZIP_LISTS A_HEADERS rpaths)
    string(MD5 k "${h}")
    set_property(GLOBAL PROPERTY _HU_NAME_SET_${k} ${set})
    string(MD5 k "${p}")
    set_property(GLOBAL PROPERTY _HU_PATH_SET_${k} ${set})
  endforeach()

  get_property(sets GLOBAL PROPERTY _HU_SETS)
  if(NOT sets)
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _hu_finalize)
  endif()
  set_property(GLOBAL APPEND PROPERTY _HU_SETS ${set})
  set_property(GLOBAL PROPERTY _HU_SET_${set}_HEADERS "${A_HEADERS}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_PATHS "${rpaths}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_STD "${std}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_EXT "${ext}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_PIC "${pic}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_OPTS "${A_COMPILE_OPTIONS}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_MAPLINES "${maplines}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_CMIS "${cmis}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_MIDS "${mids}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_MMAPS "${mmaps}")
  set_property(GLOBAL PROPERTY _HU_SET_${set}_HMAPS "${hmaps}")
  set(msg "")
  foreach(h p IN ZIP_LISTS A_HEADERS rpaths)
    string(APPEND msg "\n     <${h}> -> ${p}")
  endforeach()
  message(STATUS "HeaderUnits: set '${set}' (${tc}, CXX_STANDARD ${std}, CXX_EXTENSIONS ${ext}):${msg}")
endfunction()

# ---------------------------------------------------------------------------------------------------------
function(target_import_header_units consumer set)
  cmake_parse_arguments(PARSE_ARGV 2 A "" "" "SOURCES")
  if(A_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "target_import_header_units(${consumer} ${set}): unexpected arguments: ${A_UNPARSED_ARGUMENTS}")
  endif()
  if(NOT TARGET ${consumer})
    message(FATAL_ERROR "target_import_header_units: '${consumer}' is not a target.")
  endif()
  get_property(sets GLOBAL PROPERTY _HU_SETS)
  if(NOT set IN_LIST sets)
    message(FATAL_ERROR "target_import_header_units(${consumer} ${set}): '${set}' is not a header-unit set (add_header_units).")
  endif()
  # (never name a variable "n": if(NOT n) tests the boolean constant N, not the variable)
  get_property(cnt GLOBAL PROPERTY _HU_REQ_COUNT)
  if(NOT cnt)
    set(cnt 0)
  endif()
  math(EXPR cnt "${cnt} + 1")
  set_property(GLOBAL PROPERTY _HU_REQ_COUNT ${cnt})
  set_property(GLOBAL PROPERTY _HU_REQ_${cnt}_TARGET ${consumer})
  set_property(GLOBAL PROPERTY _HU_REQ_${cnt}_SET ${set})
  if(DEFINED A_SOURCES)
    set(abs)
    foreach(s IN LISTS A_SOURCES)
      cmake_path(ABSOLUTE_PATH s BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE OUTPUT_VARIABLE a)
      list(APPEND abs "${a}")
    endforeach()
    set_property(GLOBAL PROPERTY _HU_REQ_${cnt}_SOURCES "${abs}")
    set_property(GLOBAL PROPERTY _HU_REQ_${cnt}_ALL OFF)
  else()
    set_property(GLOBAL PROPERTY _HU_REQ_${cnt}_ALL ON)
  endif()
endfunction()

# Runs at the end of the top-level directory: all targets and their sources are known.
function(_hu_finalize)
  get_property(tc GLOBAL PROPERTY _HU_TC)
  get_property(hudir GLOBAL PROPERTY _HU_DIR)
  # Manifest for tools/tests: set|header name|resolved path|BMI
  get_property(sets GLOBAL PROPERTY _HU_SETS)
  set(manifest "")
  foreach(s IN LISTS sets)
    get_property(hs GLOBAL PROPERTY _HU_SET_${s}_HEADERS)
    get_property(ps GLOBAL PROPERTY _HU_SET_${s}_PATHS)
    get_property(bs GLOBAL PROPERTY _HU_SET_${s}_CMIS)
    foreach(h p b IN ZIP_LISTS hs ps bs)
      string(APPEND manifest "${s}|${h}|${p}|${b}\n")
    endforeach()
  endforeach()
  file(CONFIGURE OUTPUT "${hudir}/manifest.txt" CONTENT "${manifest}")

  # HU_ALLOW_HEADER_IMPORTS (experimental): a header unit whose header imports other header units is built after
  # them and sees them: Clang gets their module maps + named -fmodule-file, GCC gets them in the header's own
  # mapper.  The importing set records the imported sets, so its consumers receive them as well.
  foreach(s IN LISTS sets)
    get_property(hs GLOBAL PROPERTY _HU_SET_${s}_HEADERS)
    get_property(ps GLOBAL PROPERTY _HU_SET_${s}_PATHS)
    get_property(bs GLOBAL PROPERTY _HU_SET_${s}_CMIS)
    get_property(hm GLOBAL PROPERTY _HU_SET_${s}_HMAPS)
    set(i -1)
    foreach(h p b IN ZIP_LISTS hs ps bs)
      math(EXPR i "${i} + 1")
      string(MD5 hk "${p}")
      get_property(imps GLOBAL PROPERTY _HU_HDRIMPORTS_${hk})
      if(NOT imps)
        continue()
      endif()
      get_filename_component(d "${p}" DIRECTORY)
      set(opts)
      set(deps)
      file(RELATIVE_PATH rb0 "${CMAKE_BINARY_DIR}" "${b}")
      set(maplines "$root .\n${p} ${rb0}\n")
      foreach(e IN LISTS imps)
        _hu_import_name(n "${e}" "${d}")
        _hu_lookup(DEP "${n}")
        if(NOT DEP_SET)
          message(FATAL_ERROR "HeaderUnits: header <${h}> ('${p}', set ${s}) imports '${n}', which is not a header unit of any "
            "set. Declare it with add_header_units() (or let target_auto_header_units() discover it).")
        endif()
        if(DEP_PATH STREQUAL p)
          message(FATAL_ERROR "HeaderUnits: header <${h}> imports itself.")
        endif()
        if(NOT DEP_SET STREQUAL s)
          get_property(cur GLOBAL PROPERTY _HU_SET_${s}_DEPSETS)
          if(NOT DEP_SET IN_LIST cur)
            set_property(GLOBAL APPEND PROPERTY _HU_SET_${s}_DEPSETS ${DEP_SET})
          endif()
        endif()
        list(APPEND deps "${DEP_BMI}")
        cmake_language(CALL _hu_${tc}_header_import_dep)
      endforeach()
      cmake_language(CALL _hu_${tc}_header_import_done)
      # Once per (directory, header): source properties are per directory (a header in two sets of one directory).
      get_target_property(sd ${s} SOURCE_DIR)
      string(MD5 ek "${sd}|${p}")
      get_property(ewired GLOBAL PROPERTY _HU_EWIRED_${ek})
      if(NOT ewired)
        set_property(GLOBAL PROPERTY _HU_EWIRED_${ek} 1)
        set_property(SOURCE "${p}" TARGET_DIRECTORY ${s} APPEND PROPERTY COMPILE_OPTIONS ${opts})
        set_property(SOURCE "${p}" TARGET_DIRECTORY ${s} APPEND PROPERTY OBJECT_DEPENDS ${deps})
      endif()
    endforeach()
  endforeach()
  get_property(cnt GLOBAL PROPERTY _HU_REQ_COUNT)
  if(NOT cnt)
    return()
  endif()
  foreach(i RANGE 1 ${cnt})
    get_property(t GLOBAL PROPERTY _HU_REQ_${i}_TARGET)
    get_property(s GLOBAL PROPERTY _HU_REQ_${i}_SET)
    get_property(all GLOBAL PROPERTY _HU_REQ_${i}_ALL)
    _hu_check_compat(${t} ${s})
    if(all)
      _hu_target_cxx_sources(srcs ${t})
    else()
      get_property(srcs GLOBAL PROPERTY _HU_REQ_${i}_SOURCES)
      _hu_target_cxx_sources(tsrcs ${t})
      foreach(src IN LISTS srcs)
        if(NOT src IN_LIST tsrcs)
          message(FATAL_ERROR "target_import_header_units(${t} ${s}): '${src}' is not a C++ source of target '${t}'.")
        endif()
      endforeach()
    endif()
    _hu_set_closure(sclos ${s})
    foreach(src IN LISTS srcs)
      string(MD5 k "${t}|${src}")
      get_property(known GLOBAL PROPERTY _HU_TU_${k}_SETS SET)
      if(NOT known)
        set_property(GLOBAL APPEND PROPERTY _HU_TUS "${t}|${src}")
      endif()
      set_property(GLOBAL APPEND PROPERTY _HU_TU_${k}_SETS ${sclos})
    endforeach()
    foreach(cs IN LISTS sclos)
      add_dependencies(${t} ${cs}_ready)
    endforeach()
  endforeach()

  get_property(tus GLOBAL PROPERTY _HU_TUS)
  foreach(tu IN LISTS tus)
    string(FIND "${tu}" "|" bar)
    string(SUBSTRING "${tu}" 0 ${bar} t)
    math(EXPR bar "${bar} + 1")
    string(SUBSTRING "${tu}" ${bar} -1 src)
    string(MD5 k "${tu}")
    get_property(tsets GLOBAL PROPERTY _HU_TU_${k}_SETS)
    list(REMOVE_DUPLICATES tsets)
    list(SORT tsets)
    # One source file -> one set list (source properties are per directory; GCC's map is per source path).
    string(MD5 sk "${src}")
    get_property(prev GLOBAL PROPERTY _HU_SRC_${sk})
    if(prev AND NOT prev STREQUAL "${tsets}")
      message(FATAL_ERROR "target_import_header_units: source '${src}' is used by several targets with different "
        "header-unit sets ('${prev}' vs '${tsets}'). Not supported.")
    endif()
    set_property(GLOBAL PROPERTY _HU_SRC_${sk} "${tsets}")
    # Source properties are per directory: apply them once per (directory of the target, source), so a source
    # shared by targets in several directories gets them in each.
    get_target_property(tdir ${t} SOURCE_DIR)
    string(MD5 sdk "${tdir}|${src}")
    get_property(done GLOBAL PROPERTY _HU_SRCDIR_${sdk})
    if(done)
      continue()
    endif()
    set_property(GLOBAL PROPERTY _HU_SRCDIR_${sdk} 1)
    # A TU must not receive two header units of the same header.
    set(seen)
    foreach(s IN LISTS tsets)
      get_property(ps GLOBAL PROPERTY _HU_SET_${s}_PATHS)
      foreach(p IN LISTS ps)
        if(p IN_LIST seen)
          message(FATAL_ERROR "target_import_header_units(${t}): source '${src}' would get two header units for '${p}' (sets ${tsets}).")
        endif()
        list(APPEND seen "${p}")
      endforeach()
    endforeach()

    set(opts)
    set(deps)
    cmake_language(CALL _hu_${tc}_consumer_options)
    # CMAKE-INTERNAL (observed Ninja-generator behaviour, not documented): per-source COMPILE_OPTIONS and
    # OBJECT_DEPENDS are applied to the dependency-SCAN statement of the source as well as to its compile
    # statement.  That is what orders the BMI builds before the scan; tests/run_suite.cmake verifies it in
    # build.ninja for every consumer.  (add_dependencies() alone does NOT order object compilation in Ninja.)
    set_property(SOURCE "${src}" TARGET_DIRECTORY ${t} APPEND PROPERTY COMPILE_OPTIONS ${opts})
    set_property(SOURCE "${src}" TARGET_DIRECTORY ${t} APPEND PROPERTY OBJECT_DEPENDS ${deps})
    set_property(SOURCE "${src}" TARGET_DIRECTORY ${t} PROPERTY CXX_SCAN_FOR_MODULES ON)
  endforeach()
endfunction()
