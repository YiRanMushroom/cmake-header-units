# Makes the next commit of branch "release" from a commit of main: its tree is that commit's cmake/ and LICENSE, plus
# tools/release-README.md as README.md; its parent is the previous release commit; its message names the source commit.
#   cmake [-DFROM=<commit>] -P tools/update_release_branch.cmake        (default FROM: HEAD)
# Nothing is checked out and nothing is pushed (then: git push origin release).  The commit uses your git identity.
cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED FROM)
  set(FROM HEAD)
endif()
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

# git <args> in the repository; <out> gets its output.  IDX: with the temporary index.
function(hu_git out)
  cmake_parse_arguments(PARSE_ARGV 1 A "IDX;MAYFAIL" "" "")
  set(cmd git)
  if(A_IDX)
    set(cmd "${CMAKE_COMMAND}" -E env "GIT_INDEX_FILE=${idx}" git)
  endif()
  execute_process(COMMAND ${cmd} ${A_UNPARSED_ARGUMENTS} WORKING_DIRECTORY "${repo}" RESULT_VARIABLE rc
                  OUTPUT_VARIABLE o ERROR_VARIABLE e OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT rc EQUAL 0 AND NOT A_MAYFAIL)
    string(JOIN " " c ${A_UNPARSED_ARGUMENTS})
    message(FATAL_ERROR "git ${c} failed (${rc}):\n${e}")
  endif()
  if(NOT rc EQUAL 0)
    set(o "")
  endif()
  set(${out} "${o}" PARENT_SCOPE)
endfunction()

hu_git(sha rev-parse --verify "${FROM}^{commit}")
hu_git(subject log -1 --format=%s ${sha})
hu_git(lic rev-parse --verify "${sha}:LICENSE")
hu_git(rdm rev-parse --verify "${sha}:tools/release-README.md")
hu_git(idx rev-parse --git-path hu-release-index)
if(NOT IS_ABSOLUTE "${idx}")
  set(idx "${repo}/${idx}")
endif()
file(REMOVE "${idx}")
hu_git(_ IDX read-tree --empty)
hu_git(_ IDX read-tree "--prefix=cmake/" "${sha}:cmake")
hu_git(_ IDX update-index --add --cacheinfo "100644,${lic},LICENSE")
hu_git(_ IDX update-index --add --cacheinfo "100644,${rdm},README.md")
hu_git(tree IDX write-tree)
file(REMOVE "${idx}")

string(SUBSTRING "${sha}" 0 12 short)
hu_git(prev MAYFAIL rev-parse --verify -q refs/heads/release)
set(parent)
if(prev)
  hu_git(ptree rev-parse "${prev}^{tree}")
  if(ptree STREQUAL tree)
    message(STATUS "release (${prev}) already has the files of ${short}")
    return()
  endif()
  set(parent -p ${prev})
endif()
hu_git(commit commit-tree ${tree} ${parent} -m "Release from main ${short}: ${subject}")
hu_git(_ update-ref refs/heads/release ${commit} ${prev})
message(STATUS "release -> ${commit} (files of ${short}); publish it with: git push origin release")
