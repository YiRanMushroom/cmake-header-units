# Runs the tests of tests/run_suite.cmake in parallel: each test is a CTest test that runs run_suite.cmake for that
# test alone, and ctest -j runs them.  The same options as run_suite.cmake, plus JOBS: tests at a time (default: a
# quarter of the logical cores, at least 2; each test's own ninja runs in parallel too).
#   cmake -DTC=<toolchain> -DCMAKE_EXE=<cmake under test> -DTAG=<label> [-DTESTS=t01;t03] [-DJOBS=<n>] [...]
#         -P tests/run_parallel.cmake
# Writes _build/<TC>-<TAG>/results.txt, in test order, as run_suite.cmake does (per test: par/<test>.txt).
cmake_minimum_required(VERSION 3.28)
foreach(v TC CMAKE_EXE TAG)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "run_parallel.cmake: -D${v}=... is required")
  endif()
endforeach()
get_filename_component(PROTO "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(ROOT "${PROTO}/_build/${TC}-${TAG}")
get_filename_component(cmdir "${CMAKE_EXE}" DIRECTORY)
find_program(CTEST_EXE NAMES ctest ctest.exe HINTS "${cmdir}" NO_DEFAULT_PATH REQUIRED)

# The test names, from run_suite.cmake's list; TESTS picks by prefix, as there.
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/run_suite.cmake" l REGEX "^set\\(ALL_TESTS ")
string(REGEX REPLACE "^set\\(ALL_TESTS (.*)\\)$" "\\1" all "${l}")
separate_arguments(all)
set(names)
if(TESTS)
  foreach(t IN LISTS TESTS)
    set(found "")
    foreach(a IN LISTS all)
      if(a MATCHES "^${t}")
        set(found "${a}")
      endif()
    endforeach()
    if(NOT found)
      message(FATAL_ERROR "unknown test ${t}")
    endif()
    list(APPEND names "${found}")
  endforeach()
else()
  set(names ${all})
endif()
if(NOT JOBS)
  cmake_host_system_information(RESULT ncpu QUERY NUMBER_OF_LOGICAL_CORES)
  math(EXPR JOBS "${ncpu} / 4")
  if(JOBS LESS 2)
    set(JOBS 2)
  endif()
endif()

set(pass)
foreach(v CLANG_CXX CLANG_FLAGS LIBCXX_FLAGS LIBCXX_MODULES_JSON MINGW_CXX FRESH EXTRA_ARGS)
  if(DEFINED ${v})
    list(APPEND pass "-D${v}=${${v}}")
  endif()
endforeach()
set(par "${ROOT}/par")
file(REMOVE_RECURSE "${par}")
file(REMOVE "${ROOT}/results.txt")
set(tf "")
foreach(n IN LISTS names)
  set(args "${CMAKE_EXE}" "-DTC=${TC}" "-DCMAKE_EXE=${CMAKE_EXE}" "-DTAG=${TAG}" "-DTESTS=${n}"
           "-DRESULTS=${par}/${n}.txt")
  string(APPEND tf "add_test(${n}")
  foreach(a IN LISTS args pass)
    string(APPEND tf " [==[${a}]==]")
  endforeach()
  string(APPEND tf " -P [==[${CMAKE_CURRENT_LIST_DIR}/run_suite.cmake]==])\n")
endforeach()
file(WRITE "${par}/CTestTestfile.cmake" "${tf}")
list(LENGTH names nt)
message("run_parallel: ${nt} tests of TC=${TC}, ${JOBS} at a time")
execute_process(COMMAND "${CTEST_EXE}" --test-dir "${par}" -j ${JOBS} --timeout 7200)

set(results "")
foreach(n IN LISTS names)
  if(EXISTS "${par}/${n}.txt")
    file(READ "${par}/${n}.txt" r)
  else()
    set(r "${TC}||${n}|FAIL|0s|run_suite.cmake wrote no result (see ${ROOT}/logs/${n}.log)\n")
  endif()
  string(APPEND results "${r}")
endforeach()
file(WRITE "${ROOT}/results.txt" "${results}")
string(REGEX MATCHALL "[|](PASS|FAIL|XFAIL|XPASS|SKIP)[|]" vs "${results}")
foreach(v PASS FAIL XFAIL XPASS SKIP)
  set(c 0)
  foreach(x IN LISTS vs)
    if(x STREQUAL "|${v}|")
      math(EXPR c "${c} + 1")
    endif()
  endforeach()
  string(APPEND summary " ${v} ${c}")
endforeach()
message("run_parallel: TC=${TC}:${summary}; ${ROOT}/results.txt")
