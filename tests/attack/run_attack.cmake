# Adversarial scenarios for HeaderUnits.cmake (portable cmake -P driver; simpler than tests/run_suite.cmake).
#
#   cmake -DTC=gcc|clang|win -DCMAKE_EXE=<cmake under test> [-DSCEN=a03;a05] [-DCLANG_CXX=..] [-DCLANG_FLAGS=..]
#         -P tests/attack/run_attack.cmake
#
# Per scenario variant: fresh configure (Ninja, Debug) -> compare with the expectation for this toolchain
# (OK, or a configure error matching a regex) -> full parallel build (ninja -k 0) -> run the executables and
# compare exit codes -> per-target rebuild to attribute failures -> no-op check (ninja -n -d explain) ->
# scenario-specific steps.  Writes _build/attack-<TC>/results.txt (scenario|verdict|evidence) and logs/.
cmake_minimum_required(VERSION 3.28)
foreach(v TC CMAKE_EXE)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "run_attack.cmake: -D${v}=... is required")
  endif()
endforeach()
set(ATK "${CMAKE_CURRENT_LIST_DIR}")
get_filename_component(REPO "${ATK}/../.." ABSOLUTE)
set(ROOT "${REPO}/_build/attack-${TC}")
file(MAKE_DIRECTORY "${ROOT}/logs")
file(REMOVE "${ROOT}/results.txt")
find_program(NINJA NAMES ninja REQUIRED)
if(TC STREQUAL "gcc")
  set(TC_ARGS -DCMAKE_CXX_COMPILER=g++)
elseif(TC STREQUAL "clang")
  if(NOT DEFINED CLANG_CXX)
    set(CLANG_CXX clang++-22)
  endif()
  if(NOT DEFINED CLANG_FLAGS)
    set(CLANG_FLAGS --gcc-toolchain=/usr/local)
  endif()
  set(TC_ARGS -DCMAKE_CXX_COMPILER=${CLANG_CXX} "-DCMAKE_CXX_FLAGS=${CLANG_FLAGS}")
elseif(TC STREQUAL "win")
  set(TC_ARGS -DCMAKE_CXX_COMPILER=clang++)
else()
  message(FATAL_ERROR "TC must be gcc, clang or win")
endif()
if(CMAKE_HOST_WIN32)
  set(EXE .exe)
else()
  set(EXE "")
endif()
execute_process(COMMAND "${CMAKE_EXE}" --version OUTPUT_VARIABLE _ver)
string(REGEX MATCH "[0-9]+\\.[0-9]+\\.[0-9]+[^\n]*" CMAKE_VER "${_ver}")
file(SHA256 "${REPO}/cmake/HeaderUnits.cmake" MOD_SHA0)

# ---------------------------------------------------------------------------------------------- helpers
function(_log)
  string(JOIN "" t ${ARGN})
  file(APPEND "${CUR_LOG}" "${t}\n")
endfunction()
function(run rcv outv wd)
  string(JOIN " " c ${ARGN})
  _log("\n$ (cd ${wd}) ${c}")
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${wd}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
  _log("${out}[rc=${rc}]")
  set(${rcv} "${rc}" PARENT_SCOPE)
  set(${outv} "${out}" PARENT_SCOPE)
endfunction()
function(problem t)
  set_property(GLOBAL APPEND_STRING PROPERTY CUR_PROB "${t}; ")
  _log("*** PROBLEM: ${t}")
endfunction()
function(experr t)
  set_property(GLOBAL APPEND_STRING PROPERTY CUR_EXPERR "${t}; ")
  _log(">>> expected error: ${t}")
endfunction()
function(evid t)
  set_property(GLOBAL APPEND_STRING PROPERTY CUR_EVID "${t}; ")
  _log(">>> evidence: ${t}")
endfunction()
# first compiler/linker error lines of a build log
function(first_err out text)
  string(REPLACE "\r" "" text "${text}")
  string(REPLACE ";" "," text "${text}")
  string(REPLACE "\n" ";" l "${text}")
  set(e ${l})
  list(FILTER e INCLUDE REGEX "error:|error [A-Z]+[0-9]+|fatal|Error|undefined reference|LNK[0-9]|CreateProcess|too long")
  if(NOT e)
    set(e ${l})
    list(FILTER e INCLUDE REGEX "^FAILED")
  endif()
  list(LENGTH e len)
  if(len GREATER 2)
    list(SUBLIST e 0 2 e)
  endif()
  string(JOIN " // " r ${e})
  string(LENGTH "${r}" len)
  if(len GREATER 400)
    string(SUBSTRING "${r}" 0 400 r)
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()
# the CMake Error part of a configure log, whitespace-flattened
function(cfg_err out text)
  string(REGEX REPLACE "[ \t\r\n]+" " " flat "${text}")
  string(FIND "${flat}" "CMake Error" p)
  if(p LESS 0)
    set(p 0)
  endif()
  string(SUBSTRING "${flat}" ${p} 400 r)
  set(${out} "${r}" PARENT_SCOPE)
endfunction()
# ninja -n -d explain [targets] must report no work
function(noop_check bdir what)
  run(rc out "${bdir}" ${NINJA} -n -d explain ${ARGN})
  if(out MATCHES "no work to do")
    set_property(GLOBAL APPEND_STRING PROPERTY CUR_NOOP "${what} ")
  else()
    string(REPLACE ";" "," out "${out}")
    string(REPLACE "\n" ";" l "${out}")
    list(FILTER l INCLUDE REGEX "explain|^\\[")
    list(LENGTH l len)
    if(len GREATER 2)
      list(SUBLIST l 0 2 l)
    endif()
    string(JOIN " // " e ${l})
    problem("second ninja is not a no-op ${what}: ${e}")
  endif()
endfunction()
# run_exe(<bdir> <relpath without .exe> <expected rc>) -> problem() on mismatch; returns ok in RUN_OK
function(run_exe bdir rel want)
  set(exe "${bdir}/${rel}${EXE}")
  execute_process(COMMAND "${exe}" WORKING_DIRECTORY "${bdir}" RESULT_VARIABLE xrc OUTPUT_VARIABLE xo ERROR_VARIABLE xo TIMEOUT 120)
  string(STRIP "${xo}" xo)
  _log("$ ${exe}\n${xo}[rc=${xrc}]")
  get_filename_component(tgt "${rel}" NAME)
  if(xrc STREQUAL want)
    set(RUN_OK ON PARENT_SCOPE)
    set_property(GLOBAL APPEND_STRING PROPERTY CUR_RAN "${tgt}=${xrc} ")
  else()
    set(RUN_OK OFF PARENT_SCOPE)
    problem("${tgt} exited ${xrc}, expected ${want} (output: ${xo})")
  endif()
endfunction()

# ------------------------------------------------------------------------------------- scenario variants
# variant(<id> SRC <dir> [BDIR <name>] [ARGS <-D...>] [RUN <relexe>=<rc>|<rc>/ERR ...] [STEP <fn>] [TCS <tc>...]
#         [EXPECT <exp>] [EXPECT_gcc|EXPECT_clang|EXPECT_win <exp>])     <exp>: OK | CFG:<regex>
# <rc>/ERR: exit <rc> or a loud build failure of that target are both acceptable (deliberate misconfiguration).
set(VARIANTS "")
macro(variant id)
  cmake_parse_arguments(V "" "SRC;BDIR;STEP;EXPECT;EXPECT_gcc;EXPECT_clang;EXPECT_win" "ARGS;RUN;TCS" ${ARGN})
  list(APPEND VARIANTS ${id})
  foreach(k SRC BDIR STEP ARGS RUN TCS)
    set(VAR_${id}_${k} "${V_${k}}")
  endforeach()
  if(DEFINED V_EXPECT_${TC})
    set(VAR_${id}_EXPECT "${V_EXPECT_${TC}}")
  elseif(DEFINED V_EXPECT)
    set(VAR_${id}_EXPECT "${V_EXPECT}")
  else()
    set(VAR_${id}_EXPECT OK)
  endif()
  foreach(k SRC BDIR STEP EXPECT EXPECT_gcc EXPECT_clang EXPECT_win ARGS RUN TCS)
    unset(V_${k})
  endforeach()
endmacro()

variant(a01_n25    SRC a01_cmdline ARGS -DA01_N=25  RUN a01=0)
variant(a01_n35    SRC a01_cmdline ARGS -DA01_N=35  RUN a01=0)
variant(a01_n60    SRC a01_cmdline ARGS -DA01_N=60  RUN a01=0)
variant(a01_n250   SRC a01_cmdline ARGS -DA01_N=250 RUN a01=0)
variant(a01_stl    SRC a01_cmdline ARGS -DA01_STL=ON RUN a01=0)
variant(a02_crossdir SRC a02_crossdir RUN app/a02_plain=41 app/a02_synth=41 app/a02_hu=41 STEP step_a02)
variant(a03_shared_src SRC a03_shared_src RUN d1/a03_d1=0 d2/a03_d2=0)
variant(a04_runtime SRC a04_runtime RUN a04_ok=0 a04_rt=0/ERR a04_idl=0/ERR a04_gdbg=0/ERR)
variant(a05_features SRC a05_compat ARGS -DA05_MODE=features RUN a05=0)
variant(a05_extoff   SRC a05_compat ARGS -DA05_MODE=extoff   RUN a05=0)
variant(a06_longpath SRC a06_longpath RUN a06=0)
variant(a07_space  SRC a07_space BDIR "a07 space dir" RUN a07=0
        EXPECT_gcc "CFG:with GCC the build directory must not contain spaces")
variant(a07_space_gcchdr SRC a07_space TCS gcc RUN a07=0
        EXPECT_gcc "CFG:<sp/sp.hpp> resolves to '[^']*vendor dir/include/sp/sp.hpp' [(]contains a space[)]")
variant(a08_junction SRC a08_junction RUN a08_junc=0 a08_dotdot=0 a08_junc2=0)
variant(a08_single SRC a08_junction ARGS -DA08_SINGLE=ON RUN a08_junc=0 a08_dotdot=0)
variant(a09_lifecycle SRC a09_lifecycle RUN a09=0 STEP step_a09)
variant(a10_order SRC a10_order STEP step_a10
        EXPECT_gcc "CFG:add_header_units[(]hu_v[)]: <vector> [(]'[^']*'[)] is already a header unit of set 'hu_vs'")
variant(a10_oneset SRC a10_order ARGS -DA10_ONE_SET=ON STEP step_a10)
variant(a11_two_sets SRC a11_two_sets RUN a11=0 a11_fmt=0
        EXPECT_gcc "CFG:add_header_units[(]hu_b[)]: <vector> [(]'[^']*'[)] is already a header unit of set 'hu_a'")
variant(a11_fmtonly SRC a11_two_sets TCS gcc ARGS -DA11_NO_DUP=ON RUN a11_fmt=0)
variant(a12_unity_pch SRC a12_unity_pch RUN a12_unity=0 a12_pch=0)
variant(r01_dup_header SRC r01_dup_header RUN r01=0
        EXPECT_gcc "CFG:add_header_units[(]hu_two[)]: <vector> [(]'[^']*'[)] is already a header unit of set 'hu_one'")

# --------------------------------------------------------------------------------- scenario-specific steps
function(step_a02 bdir)
  set(det "${bdir}-vendor/include/tiny2/detail.hpp")
  file(READ "${det}" c)
  string(REPLACE "= 41;" "= 42;" c "${c}")
  file(WRITE "${det}" "${c}")
  run(rc out "${bdir}" ${NINJA})
  if(NOT rc EQUAL 0)
    first_err(e "${out}")
    problem("rebuild after editing detail.hpp 41->42 failed: ${e}")
    return()
  endif()
  set(synth "synth BMI not rebuilt")
  if(out MATCHES "@synth_[0-9]+")
    set(synth "mx@synth rebuilt")
  endif()
  set_property(GLOBAL PROPERTY CUR_RAN "")
  foreach(x a02_plain a02_synth a02_hu)
    run_exe("${bdir}" app/${x} 42)
  endforeach()
  get_property(ran GLOBAL PROPERTY CUR_RAN)
  evid("after same-size edit 41->42 of detail.hpp and one ninja run (${synth}): ${ran}")
  noop_check("${bdir}" "after-edit")
endfunction()

function(step_a09 bdir)
  get_property(src GLOBAL PROPERTY CUR_SRC)
  set(done "")
  # 1. re-run cmake
  run(rc out "${bdir}" "${CMAKE_EXE}" -S "${src}" -B "${bdir}")
  if(NOT rc EQUAL 0)
    problem("re-running cmake failed")
    return()
  endif()
  # CMake rewrites CXXDependInfo.json on every generate, so the next ninja re-collates the dyndep files (CMake
  # behaviour, independent of the module); it must not recompile anything, and the ninja after that is a no-op.
  run(rc out "${bdir}" ${NINJA})
  if(NOT rc EQUAL 0 OR out MATCHES "Building CXX object")
    string(REGEX MATCH "Building CXX object [^\n]*" b "${out}")
    problem("ninja after re-running cmake failed or recompiled (rc=${rc}): ${b}")
  endif()
  noop_check("${bdir}" "after-recmake")
  # 2. delete the BMI
  file(STRINGS "${bdir}/CMakeFiles/header_units/manifest.txt" mf LIMIT_COUNT 1)
  string(REPLACE "|" ";" mf "${mf}")
  list(GET mf 3 bmi)
  if(NOT IS_ABSOLUTE "${bmi}")
    set(bmi "${bdir}/${bmi}")
  endif()
  file(REMOVE "${bmi}")
  run(rc out "${bdir}" ${NINJA})
  get_filename_component(bn "${bmi}" NAME)
  if(NOT rc EQUAL 0 OR NOT EXISTS "${bmi}")
    first_err(e "${out}")
    problem("rebuild after deleting the BMI ${bn} failed: ${e}")
    return()
  endif()
  run_exe("${bdir}" a09 0)
  noop_check("${bdir}" "after-BMI-delete")
  # 3. ninja clean
  run(rc out "${bdir}" ${NINJA} clean)
  run(rc out "${bdir}" ${NINJA})
  if(NOT rc EQUAL 0)
    first_err(e "${out}")
    problem("build after ninja clean failed: ${e}")
    return()
  endif()
  run_exe("${bdir}" a09 0)
  noop_check("${bdir}" "after-clean")
  # 4. touch CMakeLists.txt -> regeneration
  file(TOUCH "${src}/CMakeLists.txt")
  run(rc out "${bdir}" ${NINJA})
  if(NOT rc EQUAL 0)
    first_err(e "${out}")
    problem("build after touching CMakeLists.txt failed: ${e}")
    return()
  endif()
  run_exe("${bdir}" a09 0)
  noop_check("${bdir}" "after-regen")
  evid("lifecycle: re-run cmake, delete BMI ${bn}, ninja clean, touch CMakeLists.txt -> each builds, a09=0")
endfunction()

function(step_a10 bdir)
  set(probes incvec_impfmt impfmt_incvec impvec_incstring_sameset impvec_impstring cstdint_impvec cassert_impvec
             impvec_cassert gmf)
  if(TC STREQUAL "win")
    list(APPEND probes winh_impvec impvec_winh)
  endif()
  set(ok "")
  set(bad "")
  set(okt "")
  foreach(p IN LISTS probes)
    run(rc out "${bdir}" ${NINJA} p_${p})
    if(rc EQUAL 0)
      string(APPEND ok " ${p}")
      list(APPEND okt p_${p})
    else()
      first_err(e "${out}")
      string(APPEND bad " ${p}")
      problem("probe ${p} does not compile: ${e}")
    endif()
  endforeach()
  evid("probes OK:${ok}; FAIL:${bad}")
  if(okt)
    noop_check("${bdir}" "probes" ${okt})
  endif()
endfunction()

# -------------------------------------------------------------------------------------------- one variant
function(do_variant id)
  set(src "${ATK}/${VAR_${id}_SRC}")
  set(bdn "${VAR_${id}_BDIR}")
  if(NOT bdn)
    set(bdn "${id}")
  endif()
  set(bdir "${ROOT}/${bdn}")
  set(expect "${VAR_${id}_EXPECT}")
  set_property(GLOBAL PROPERTY CUR_SRC "${src}")
  # fresh: build dir and its -vendor sibling (never the -junction link of a08: it points into the source tree)
  file(REMOVE_RECURSE "${bdir}" "${bdir}-vendor")
  run(rc out "${ROOT}" "${CMAKE_EXE}" -S "${src}" -B "${bdir}" -G Ninja -DCMAKE_BUILD_TYPE=Debug
      ${TC_ARGS} ${VAR_${id}_ARGS})
  cfg_err(ce "${out}")
  if(expect MATCHES "^CFG:(.*)$")
    set(want "${CMAKE_MATCH_1}")
    string(REGEX REPLACE "[ \t\r\n]+" " " flat "${out}")
    if(rc EQUAL 0)
      problem("configure succeeded, expected a configure error matching /${want}/")
    elseif(NOT flat MATCHES "${want}")
      problem("configure failed, but not with /${want}/: ${ce}")
    else()
      string(REGEX MATCH "${want}" m "${flat}")
      experr("configure error as expected: ${m}")
    endif()
    return()
  endif()
  if(NOT rc EQUAL 0)
    problem("configure failed: ${ce}")
    return()
  endif()
  if(out MATCHES "CMake Warning")
    string(REGEX REPLACE "[ \t\r\n]+" " " flat "${out}")
    string(REGEX MATCH "CMake Warning[^:]*:[^.]*" w "${flat}")
    evid("configure warning: ${w}")
  endif()
  # fresh full parallel build first (ordering attacks), then attribute failures per target
  run(brc bout "${bdir}" ${NINJA} -k 0)
  if(brc EQUAL 0)
    evid("fresh build OK")
  else()
    first_err(e "${bout}")
    _log("full build failed: ${e}")
  endif()
  set_property(GLOBAL PROPERTY CUR_RAN "")
  set(okt "")
  foreach(r IN LISTS VAR_${id}_RUN)
    string(REGEX MATCH "^([^=]+)=(.*)$" _m "${r}")
    set(rel "${CMAKE_MATCH_1}")
    set(want "${CMAKE_MATCH_2}")
    get_filename_component(tgt "${rel}" NAME)
    set(trc 0)
    if(NOT brc EQUAL 0 OR NOT EXISTS "${bdir}/${rel}${EXE}")
      run(trc tout "${bdir}" ${NINJA} ${tgt})
    endif()
    if(NOT trc EQUAL 0)
      first_err(te "${tout}")
      if(want MATCHES "/ERR$")
        experr("${tgt}: not caught at configure time, build fails loudly: ${te}")
      else()
        problem("${tgt} does not build: ${te}")
      endif()
      continue()
    endif()
    string(REGEX REPLACE "/ERR$" "" wantrc "${want}")
    run_exe("${bdir}" "${rel}" "${wantrc}")
    if(RUN_OK)
      list(APPEND okt ${tgt})
    endif()
  endforeach()
  get_property(ran GLOBAL PROPERTY CUR_RAN)
  if(ran)
    evid("ran: ${ran}")
  endif()
  if(brc EQUAL 0)
    noop_check("${bdir}" "after-fresh-build")
  elseif(okt)
    noop_check("${bdir}" "after-fresh-build(ok targets)" ${okt})
  endif()
  if(VAR_${id}_STEP)
    cmake_language(CALL ${VAR_${id}_STEP} "${bdir}")
  endif()
endfunction()

# -------------------------------------------------------------------------------------------------- main
set(results "")
foreach(id IN LISTS VARIANTS)
  if(SCEN)
    set(sel OFF)
    foreach(s IN LISTS SCEN)
      if(id MATCHES "^${s}")
        set(sel ON)
      endif()
    endforeach()
    if(NOT sel)
      continue()
    endif()
  endif()
  set(CUR_LOG "${ROOT}/logs/${id}.log")
  file(WRITE "${CUR_LOG}" "# ${id}  TC=${TC}  CMake ${CMAKE_VER}  expect=${VAR_${id}_EXPECT}\n")
  foreach(p CUR_PROB CUR_EXPERR CUR_EVID CUR_NOOP CUR_RAN)
    set_property(GLOBAL PROPERTY ${p} "")
  endforeach()
  string(TIMESTAMP t0 "%s")
  if(VAR_${id}_TCS AND NOT TC IN_LIST VAR_${id}_TCS)
    set(verdict SKIPPED)
    set(e "variant only for ${VAR_${id}_TCS}")
  else()
    do_variant(${id})
    get_property(pr GLOBAL PROPERTY CUR_PROB)
    get_property(xe GLOBAL PROPERTY CUR_EXPERR)
    get_property(ev GLOBAL PROPERTY CUR_EVID)
    get_property(np GLOBAL PROPERTY CUR_NOOP)
    if(np)
      string(STRIP "${np}" np)
      string(APPEND ev "no-op OK (${np}); ")
    endif()
    if(pr)
      set(verdict FAIL)
      set(e "${pr}${xe}${ev}")
    elseif(xe)
      set(verdict EXPECTED-ERROR)
      set(e "${xe}${ev}")
    else()
      set(verdict PASS)
      set(e "${ev}")
    endif()
  endif()
  string(TIMESTAMP t1 "%s")
  math(EXPR dt "${t1} - ${t0}")
  string(REPLACE "\n" " " e "${e}")
  string(REPLACE "\r" "" e "${e}")
  string(REPLACE "|" "/" e "${e}")
  message("${id}|${verdict}|${e} (${dt}s)")
  string(APPEND results "${id}|${verdict}|${e} (${dt}s)\n")
endforeach()
file(SHA256 "${REPO}/cmake/HeaderUnits.cmake" MOD_SHA1)
set(hdr "# TC=${TC} cmake=${CMAKE_VER} host=${CMAKE_HOST_SYSTEM_NAME} HeaderUnits.cmake sha256=${MOD_SHA0}")
if(NOT MOD_SHA1 STREQUAL MOD_SHA0)
  string(APPEND hdr " (CHANGED during the run, now ${MOD_SHA1})")
endif()
file(WRITE "${ROOT}/results.txt" "${hdr}\n# scenario|verdict|evidence\n${results}")
