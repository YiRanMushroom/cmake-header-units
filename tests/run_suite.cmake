# t21: build, run (exit code = value), no-op; change the value, rebuild, run, no-op.  <evout> gets a note.
function(t21_cycle evout bdir)
  set(vd "${bdir}-value")
  file(REMOVE_RECURSE "${bdir}" "${vd}")
  file(WRITE "${vd}/value.h" "#pragma once\n#define T21_VALUE 3\n")
  hu_configure(t21_self_include "${bdir}" -DT21_VALUE_DIR=${vd} ${ARGN})
  bail_if_failed()
  set(notes "")
  foreach(v 3 5)
    if(v EQUAL 5)
      file(WRITE "${vd}/value.h" "#pragma once\n#define T21_VALUE 5\n")
    endif()
    run(rc out "${bdir}" ${NINJA})
    if(NOT rc EQUAL 0)
      first_lines(e "${out}" 3)
      fail("build with value ${v} failed: ${e}")
    endif()
    if(out MATCHES "falling back to include")
      set(notes " (GCC tried to import the header unit being built)")
    endif()
    run(rc out "${bdir}" "${bdir}/t21")
    if(NOT rc EQUAL v)
      fail("with value ${v} the program returned ${rc}: a stale header unit?")
    endif()
    expect_noop("${bdir}" "after the build with value ${v}")
    bail_if_failed()
  endforeach()
  set(${evout} "${notes}" PARENT_SCOPE)
endfunction()

function(test_t21_self_include bdir)
  t21_cycle(n "${bdir}")
  bail_if_failed()
  set(w "")
  if(TC MATCHES "^(gcc|mingw)$")
    t21_cycle(nw "${bdir}-wrappers" -DHU_GCC_WRAPPERS=ON)
    bail_if_failed()
    set(w "; the same with HU_GCC_WRAPPERS (no hu-mapper: wrappers)${nw}")
    # An explicit CMAKE_SYSTEM_NAME makes CMake cross-compile: hu-mapper is then built by a host compiler
    if(TC STREQUAL "mingw")
      set(sys Windows)
    else()
      set(sys Linux)
    endif()
    t21_cycle(nx "${bdir}-cross" -DCMAKE_SYSTEM_NAME=${sys})
    bail_if_failed()
    file(GLOB mx "${bdir}-cross/CMakeFiles/header_units/hu-mapper*")
    if(NOT mx)
      fail("cross-compiling (CMAKE_SYSTEM_NAME=${sys}): hu-mapper was not built with a host compiler")
    endif()
    string(APPEND w "; cross-compiling (CMAKE_SYSTEM_NAME=${sys}) with hu-mapper built by a host compiler${nx}")
    # The headers in a directory with a space: hu-mapper reads its map entries quoted; GCC's own mapper reader
    # (HU_GCC_WRAPPERS) has no quoting, so there the header is rejected at configure time.
    set(sd "${bdir}-space headers")
    file(REMOVE_RECURSE "${sd}")
    file(COPY "${PROTO}/tests/t21_self_include/include/" DESTINATION "${sd}")
    t21_cycle(ns "${bdir}-space" "-DT21_INCLUDE_DIR=${sd}")
    bail_if_failed()
    hu_build_check(t21_self_include "${bdir}-space" NOCTEST)
    bail_if_failed()
    file(REMOVE_RECURSE "${bdir}-space-wrappers")
    run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${PROTO}/tests/t21_self_include" -B "${bdir}-space-wrappers" -G Ninja ${TC_ARGS}
        "-DT21_INCLUDE_DIR=${sd}" "-DT21_VALUE_DIR=${bdir}-space-value" -DHU_GCC_WRAPPERS=ON)
    string(REGEX REPLACE "[ \t\r\n]+" " " flat "${out}")
    if(rc EQUAL 0 OR NOT flat MATCHES "selfinc[.]h> resolves to '[^']*space headers/selfinc[.]h' [(]contains a space or a non-ASCII character[)]")
      fail("with HU_GCC_WRAPPERS, a header unit in a directory with a space was not rejected at configure time")
    endif()
    string(APPEND w "; its headers in a directory with a space${ns} (with HU_GCC_WRAPPERS a configure error)")
  endif()
  evid("a header that includes itself through another one builds, rebuilds after a change (3 -> 5) and is a no-op after each build${n}${w}")
endfunction()

