# An IDE (CLion) runs each source's flags without -M and with -E to read the compiler's settings: that must work for
# the header-unit sources of <set> too.  Appends to the evidence how many were checked.
function(ide_probe_check bdir set)
  if(TC STREQUAL "msvc")
    evid("IDE-style probe: not run with MSVC (GCC/Clang -E syntax)")
    return()
  endif()
  if(TC STREQUAL "clangcl")
    # clang-cl names a header unit's PCM with /clang:-o, which overrides any -o: a -E run would write over the PCM
    evid("IDE-style probe: not run with clang-cl (a -E run of the header-unit flags writes over the PCM, see README)")
    return()
  endif()
  file(STRINGS "${bdir}/CMakeCache.txt" cl REGEX "^CMAKE_CXX_COMPILER:")
  string(REGEX REPLACE "^[^=]*=" "" cxx "${cl}")
  file(WRITE "${bdir}/ide_probe.cpp" "")
  file(STRINGS "${bdir}/build.ninja" bl)
  list(APPEND bl "")
  set(in FALSE)
  set(n 0)
  foreach(l IN LISTS bl)
    if(l MATCHES "^build CMakeFiles/${set}\\.dir/hu/")
      set(in TRUE)
      set(v_FLAGS "")
      set(v_DEFINES "")
      set(v_INCLUDES "")
    elseif(in AND l MATCHES "^  (FLAGS|DEFINES|INCLUDES) = (.*)$")
      set(v_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
    elseif(in AND l STREQUAL "")
      set(in FALSE)
      separate_arguments(args NATIVE_COMMAND "${v_DEFINES} ${v_INCLUDES} ${v_FLAGS}")
      run(rc out "${bdir}" "${cxx}" ${args} -E "${bdir}/ide_probe.cpp" -o "${bdir}/ide_probe.i")
      if(NOT rc EQUAL 0)
        first_lines(e "${out}" 3)
        fail("an IDE-style probe (header-unit flags, -E, no -M) fails: ${e}")
      endif()
      math(EXPR n "${n} + 1")
    endif()
  endforeach()
  if(n EQUAL 0)
    fail("no header-unit statement of ${set} found in build.ninja")
  endif()
  evid("IDE-style probe of ${n} header-unit sources ok")
endfunction()

# The number in "HeaderUnits: header lookup: <n> compiler run(s)" of a configure output, or "" if absent.
function(lookup_runs out text)
  set(r "")
  if(text MATCHES "HeaderUnits: header lookup: ([0-9]+) compiler run")
    set(r "${CMAKE_MATCH_1}")
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

