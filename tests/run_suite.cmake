function(test_t19_scale bdir)
  set(runs "")
  foreach(n 5 40)
    set(b "${bdir}-${n}")
    file(REMOVE_RECURSE "${b}" "${b}-gen")
    string(TIMESTAMP s0 "%s")
    run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${PROTO}/tests/t19_scale" -B "${b}" -G Ninja -DCMAKE_BUILD_TYPE=Debug ${TC_ARGS} -DT19_N=${n})
    string(TIMESTAMP s1 "%s")
    math(EXPR dt "${s1} - ${s0}")
    if(NOT rc EQUAL 0)
      first_lines(e "${out}" 3)
      fail("configure with ${n} targets failed: ${e}")
    endif()
    lookup_runs(k "${out}")
    if(k STREQUAL "")
      fail("configure with ${n} targets does not report its compiler runs for the header lookup")
    endif()
    list(APPEND runs "${n} targets: ${k} runs, configure ${dt}s")
    set(k_${n} ${k})
  endforeach()
  if(NOT k_5 EQUAL k_40)
