function(test_t10_header_imports bdir)
  set(inc "${bdir}-inc")
  file(REMOVE_RECURSE "${inc}")
  hu_configure(t10_header_imports "${bdir}" "-DT10_INC_COPY=${inc}")
  bail_if_failed()
  hu_build_check(t10_header_imports "${bdir}")
  bail_if_failed()
  # rebuild propagation: touching b.h must rebuild b's BMI, then a's BMI (imports b), then main.cpp
  file(TOUCH "${inc}/proj/b.h")
  run(rc out "${bdir}" ${NINJA} -n -d explain)
  string(REGEX MATCHALL "[^ \n]*proj/a\\.h[^ \n]*" a_hits "${out}")
  if(NOT out MATCHES "proj/b\\.h" OR NOT a_hits OR NOT out MATCHES "main\\.cpp")
    fail("touching b.h does not rebuild b's BMI, a's BMI and main.cpp:\n${out}")
  endif()
  run(rc out "${bdir}" ${NINJA})
  expect_noop("${bdir}" "after b.h touch")
  evid("auto-discovered a.h -> <vector>, b.h; manual intra/cross-set imports; touch b.h rebuilds b BMI -> a BMI -> main.cpp")
endfunction()

