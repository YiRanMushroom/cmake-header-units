# Test driver for the HeaderUnits prototype (portable: runs on Linux and Windows).
#
#   cmake -DTC=gcc|clang|win -DCMAKE_EXE=<cmake under test> -DTAG=<label> [-DTESTS=t01;t03] [-DFRESH=ON]
#         -P tests/run_suite.cmake
#
# For every test: fresh configure + build (-j, Ninja default), ctest, no-op rebuild, build.ninja edge check
# (scan AND compile of every header-unit consumer depend on its BMIs), depfile evidence (imported headers
# are not parsed textually, the BMIs are read), negative check (BMI moved away -> the consumer's exact
# compile command fails), plus test-specific steps.  Writes _build/<TC>-<TAG>/results.txt and logs/.
cmake_minimum_required(VERSION 3.28)
foreach(v TC CMAKE_EXE TAG)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "run_suite.cmake: -D${v}=... is required")
  endif()
endforeach()
get_filename_component(PROTO "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(ROOT "${PROTO}/_build/${TC}-${TAG}")
if(NOT DEFINED FRESH)
  set(FRESH ON)
endif()
file(MAKE_DIRECTORY "${ROOT}/logs")
file(REMOVE "${ROOT}/results.txt")   # never report a previous run's table if this one aborts
get_filename_component(_cmdir "${CMAKE_EXE}" DIRECTORY)
find_program(CTEST_EXE NAMES ctest ctest.exe HINTS "${_cmdir}" NO_DEFAULT_PATH REQUIRED)
set(NINJA ninja)
if(TC STREQUAL "gcc")
  set(TC_ARGS -DCMAKE_CXX_COMPILER=g++)
  set(OBJ .o)
elseif(TC STREQUAL "clang")
  if(NOT DEFINED CLANG_CXX)
    set(CLANG_CXX clang++-22)
  endif()
  if(NOT DEFINED CLANG_FLAGS)
    set(CLANG_FLAGS --gcc-toolchain=/usr/local)   # GCC 16's libstdc++ in docker/Dockerfile
  endif()
  set(TC_ARGS -DCMAKE_CXX_COMPILER=${CLANG_CXX} "-DCMAKE_CXX_FLAGS=${CLANG_FLAGS}")
  set(OBJ .o)
elseif(TC STREQUAL "win")
  set(TC_ARGS -DCMAKE_CXX_COMPILER=clang++)
  set(OBJ .obj)
else()
  message(FATAL_ERROR "TC must be gcc, clang or win")
endif()
if(CMAKE_HOST_WIN32)
  set(EXE .exe)
else()
  set(EXE "")
endif()
set(ALL_TESTS t01_stl t02_thirdparty t03_named_modules t04_shared_set t05_rebuild t06_mixed t07_own_headers t08_auto t09_header_import_error t10_header_imports t11_transitive t12_build_tree t13_same_name t14_textual_pragma t15_scan_sources)
if(NOT TESTS)
  set(TESTS ${ALL_TESTS})
endif()
execute_process(COMMAND "${CMAKE_EXE}" --version OUTPUT_VARIABLE _ver)
string(REGEX MATCH "[0-9]+\\.[0-9]+\\.[0-9]+[^\n]*" CMAKE_VER "${_ver}")

# ---------------------------------------------------------------------------------------------- helpers
function(_log)
  string(JOIN "" t ${ARGN})
  get_property(f GLOBAL PROPERTY CUR_LOG)
  file(APPEND "${f}" "${t}\n")
endfunction()

# run(<rc var> <output var> <working dir> <command...>)
function(run rcv outv wd)
  string(JOIN " " c ${ARGN})
  _log("\n$ (cd ${wd}) ${c}")
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${wd}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
  _log("${out}[rc=${rc}]")
  set(${rcv} "${rc}" PARENT_SCOPE)
  set(${outv} "${out}" PARENT_SCOPE)
endfunction()

macro(fail msg)
  set_property(GLOBAL PROPERTY CUR_FAIL "${msg}")
  _log("\n*** FAIL: ${msg}")
  return()
endmacro()
macro(bail_if_failed)
  get_property(_f GLOBAL PROPERTY CUR_FAIL)
  if(_f)
    return()
  endif()
endmacro()
function(evid t)
  set_property(GLOBAL APPEND_STRING PROPERTY CUR_EVID "${t}; ")
  _log(">>> evidence: ${t}")
endfunction()

function(_norm out p)
  string(REPLACE "$:" ":" p "${p}")
  string(REPLACE "$ " " " p "${p}")
  file(TO_CMAKE_PATH "${p}" p)
  cmake_path(NORMAL_PATH p)
  if(CMAKE_HOST_WIN32)
    string(TOLOWER "${p}" p)
  endif()
  set(${out} "${p}" PARENT_SCOPE)
endfunction()

function(first_lines out text n)
  string(REPLACE ";" "," text "${text}")
  string(REPLACE "\\" "/" text "${text}")   # fail() is a macro: a backslash in its message would be parsed as an escape
  string(REPLACE "\n" ";" l "${text}")
  list(FILTER l INCLUDE REGEX "error|fatal|Error")
  list(SUBLIST l 0 ${n} l)
  string(JOIN " | " r ${l})
  string(LENGTH "${r}" len)
  if(len GREATER 300)
    string(SUBSTRING "${r}" 0 300 r)
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# Parsed build.ninja: statement headers + FLAGS / OBJ_FILE, as parallel lists (";" escaped as <SEMI>).
function(parse_ninja bdir)
  file(READ "${bdir}/build.ninja" bn)
  string(REPLACE ";" "<SEMI>" bn "${bn}")
  string(REPLACE "\n" ";" lines "${bn}")
  set(heads)
  set(flags)
  set(objs)
  set(cur -1)
  foreach(line IN LISTS lines)
    if(line MATCHES "^build ")
      list(APPEND heads "${line}")
      list(APPEND flags "-")
      list(APPEND objs "-")
      math(EXPR cur "${cur} + 1")
    elseif(cur GREATER -1 AND line MATCHES "^  FLAGS = (.*)$")
      list(REMOVE_AT flags ${cur})
      list(INSERT flags ${cur} "${CMAKE_MATCH_1}")
    elseif(cur GREATER -1 AND line MATCHES "^  OBJ_FILE = (.*)$")
      string(REPLACE "\\" "/" o "${CMAKE_MATCH_1}")   # Windows: OBJ_FILE uses backslashes
      list(REMOVE_AT objs ${cur})
      list(INSERT objs ${cur} "${o}")
    endif()
  endforeach()
  set(NB_HEADS "${heads}" PARENT_SCOPE)
  set(NB_FLAGS "${flags}" PARENT_SCOPE)
  set(NB_OBJS "${objs}" PARENT_SCOPE)
endfunction()

# BMIs (absolute) a statement's FLAGS hand to the TU, or empty if it is not a header-unit consumer.
function(hu_bmis_of_flags out f)
  set(r)
  # Clang consumers carry their header-unit options in a response file (@<file>.rsp): read it in.
  string(REGEX MATCHALL "@[^ \"']+[.]rsp" rsps "${f}")
  foreach(rf IN LISTS rsps)
    string(SUBSTRING "${rf}" 1 -1 rf)
    string(REPLACE "$:" ":" rf "${rf}")
    file(READ "${rf}" rc)
    string(REPLACE "\"" "" rc "${rc}")
    string(REPLACE "\n" " " rc "${rc}")
    string(APPEND f " ${rc}")
  endforeach()
  if(f MATCHES "header_units/src(/[^ \"']+)\\.map")
    string(REGEX MATCH "[^ \"'|]+/header_units/src/[^ \"']+\\.map" m "${f}")
    file(STRINGS "${m}" ml)
    foreach(l IN LISTS ml)
      if(l MATCHES "^[^$ ][^ ]* ([^ ]+)$")             # skips the "$root ." line
        set(m "${CMAKE_MATCH_1}")
        if(NOT IS_ABSOLUTE "${m}")
          set(m "${bdir}/${m}")                           # relative to the top build dir ($root .)
        endif()
        list(APPEND r "${m}")
      endif()
    endforeach()
  else()
    string(REGEX MATCHALL "-fmodule-file=[^ ]+/hu/[^ ]+" ms "${f}")
    foreach(m IN LISTS ms)
      string(REGEX REPLACE "^-fmodule-file=" "" m "${m}")
      string(REGEX REPLACE "^[A-Za-z0-9_]+=" "" m "${m}")   # lazy named form <module>=<pcm>
      if(NOT IS_ABSOLUTE "${m}")
        set(m "${bdir}/${m}")                             # spelled relative to the top build dir
      endif()
      list(APPEND r "${m}")
    endforeach()
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

function(read_manifest bdir)
  file(STRINGS "${bdir}/CMakeFiles/header_units/manifest.txt" ml)
  set(names)
  foreach(l IN LISTS ml)
    string(REPLACE "|" ";" f "${l}")
    list(GET f 1 n)
    list(GET f 2 p)
    list(GET f 3 b)
    string(MAKE_C_IDENTIFIER "${n}" id)
    # one name can have several header units (a different file per target): keep them all
    list(APPEND MF_PATHS_${id} "${p}")
    list(APPEND MF_BMIS_${id} "${b}")
    set(MF_PATHS_${id} "${MF_PATHS_${id}}" PARENT_SCOPE)
    set(MF_BMIS_${id} "${MF_BMIS_${id}}" PARENT_SCOPE)
    set(MF_PATH_${id} "${p}" PARENT_SCOPE)
    set(MF_BMI_${id} "${b}" PARENT_SCOPE)
    list(APPEND names "${n}")
  endforeach()
  set(MF_NAMES "${names}" PARENT_SCOPE)
endfunction()

function(ninja_deps out bdir obj)
  execute_process(COMMAND ${NINJA} -C "${bdir}" -t deps "${obj}" OUTPUT_VARIABLE o ERROR_VARIABLE o)
  string(REPLACE ";" "<SEMI>" o "${o}")
  string(REPLACE "\n" ";" l "${o}")
  set(r)
  foreach(x IN LISTS l)
    if(x MATCHES "^    (.+)$")
      set(n "${CMAKE_MATCH_1}")
      if(NOT IS_ABSOLUTE "${n}")
        set(n "${bdir}/${n}")    # Ninja keeps build-tree paths relative to the build dir
      endif()
      _norm(n "${n}")
      list(APPEND r "${n}")
    endif()
  endforeach()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

function(run_shell rcv outv wd cmd)
  if(CMAKE_HOST_WIN32)
    # absolute path: cmd.exe may be configured not to search the current directory (NoDefaultCurrentDirectoryInExePath)
    file(WRITE "${wd}/_hu_cmd.bat" "@echo off\r\n${cmd}\r\n")
    file(TO_NATIVE_PATH "${wd}/_hu_cmd.bat" bat)
    run(rc out "${wd}" cmd /c "${bat}")
  else()
    run(rc out "${wd}" sh -c "${cmd}")
  endif()
  set(${rcv} "${rc}" PARENT_SCOPE)
  set(${outv} "${out}" PARENT_SCOPE)
endfunction()

function(expect_noop bdir what)
  run(rc out "${bdir}" ${NINJA})
  if(NOT rc EQUAL 0 OR NOT out MATCHES "ninja: no work to do")
    fail("${what}: second build was not a no-op")
  endif()
endfunction()

function(hu_configure name bdir)
  if(FRESH)
    file(REMOVE_RECURSE "${bdir}")
  endif()
  run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${PROTO}/tests/${name}" -B "${bdir}" -G Ninja
      -DCMAKE_BUILD_TYPE=Debug ${TC_ARGS} ${ARGN})
  if(NOT rc EQUAL 0)
    first_lines(e "${out}" 3)
    fail("configure failed: ${e}")
  endif()
endfunction()

# Build, ctest, no-op, edge check, depfile evidence, negative check.
function(hu_build_check name bdir)
  cmake_parse_arguments(A "NOCTEST" "" "" ${ARGN})
  run(rc out "${bdir}" ${NINJA})
  if(NOT rc EQUAL 0)
    first_lines(e "${out}" 3)
    fail("build failed: ${e}")
  endif()
  if(NOT A_NOCTEST)
    run(rc out "${bdir}" "${CTEST_EXE}" --output-on-failure)
    if(NOT rc EQUAL 0)
      fail("ctest failed")
    endif()
  endif()
  expect_noop("${bdir}" "after build")
  bail_if_failed()
  evid("build+run ok, 2nd build no-op")

  # --- edges: every header-unit consumer's scan AND compile statement lists its BMIs as inputs
  parse_ninja("${bdir}")
  read_manifest("${bdir}")
  list(LENGTH NB_HEADS n)
  math(EXPR n "${n} - 1")
  set(nedges 0)
  set(consumers)
  set(scanflags_objs)
  foreach(i RANGE ${n})
    list(GET NB_HEADS ${i} h)
    list(GET NB_FLAGS ${i} f)
    list(GET NB_OBJS ${i} o)
    if(NOT h MATCHES "^build ([^ ]+): (CXX_SCAN__|CXX_COMPILER__[^ ]*_scanned_)")
      continue()
    endif()
    set(out "${CMAKE_MATCH_1}")
    set(kind "${CMAKE_MATCH_2}")
    hu_bmis_of_flags(bmis "${f}")
    if(NOT bmis)
      continue()
    endif()
    string(FIND "${h}" " || " oo)
    string(SUBSTRING "${h}" 0 ${oo} hin)
    foreach(b IN LISTS bmis)
      file(RELATIVE_PATH rel "${bdir}" "${b}")
      string(FIND "${hin} " " ${rel} " pos)
      if(pos LESS 0)
        fail("edge missing: '${out}' does not depend on BMI '${rel}'")
      endif()
    endforeach()
    math(EXPR nedges "${nedges} + 1")
    if(kind STREQUAL "CXX_SCAN__")
      list(APPEND scanflags_objs "${o}")
      string(MD5 k "${o}")
      set(SCANFLAGS_${k} "${f}")
    else()
      list(APPEND consumers "${out}")
      string(MD5 k "${out}")
      set(CFLAGS_${k} "${f}")
      set(CBMIS_${k} "${bmis}")
      if(h MATCHES "_scanned_[A-Za-z]+ ([^ ]+)")
        set(CSRC_${k} "${CMAKE_MATCH_1}")
      endif()
    endif()
  endforeach()
  if(nedges EQUAL 0)
    fail("no header-unit consumer found in build.ninja")
  endif()
  # the scan sees the same header-unit flags as the compile
  foreach(c IN LISTS consumers)
    string(MD5 k "${c}")
    if(NOT c IN_LIST scanflags_objs OR NOT SCANFLAGS_${k} STREQUAL CFLAGS_${k})
      fail("scan statement of '${c}' lacks the header-unit flags of its compile")
    endif()
  endforeach()
  list(LENGTH consumers nc)
  evid("build.ninja: ${nedges} scan/compile edges of ${nc} TUs depend on their BMIs, scan flags == compile flags")

  # --- depfile evidence: every 'import <x>;' of a consumer is served by the BMI, never parsed textually
  set(nimp 0)
  set(negobj "")
  foreach(c IN LISTS consumers)
    if(c MATCHES "^CMakeFiles/p_")
      continue()   # boundary probes (t06) are judged separately
    endif()
    string(MD5 k "${c}")
    _norm(src "${CSRC_${k}}")
    if(NOT EXISTS "${src}")
      string(REPLACE "$:" ":" src "${CSRC_${k}}")
    endif()
    file(STRINGS "${src}" il REGEX "^[ \t]*(export[ \t]+)?import[ \t]*<[^>]+>[ \t]*;")
    ninja_deps(deps "${bdir}" "${c}")
    foreach(l IN LISTS il)
      string(REGEX REPLACE "^.*<([^>]+)>.*$" "\\1" nm "${l}")
      string(MAKE_C_IDENTIFIER "${nm}" id)
      if(NOT DEFINED MF_PATH_${id})
        continue()
      endif()
      # the header unit of this name that this consumer actually reads (its BMI is in the depfile)
      set(hp "")
      set(bp "")
      set(rawbmi "")
      foreach(cp cb IN ZIP_LISTS MF_PATHS_${id} MF_BMIS_${id})
        _norm(np "${cp}")
        _norm(nb "${cb}")
        if(nb IN_LIST deps OR bp STREQUAL "")
          set(hp "${np}")
          set(bp "${nb}")
          set(rawbmi "${cb}")
        endif()
        if(nb IN_LIST deps)
          break()
        endif()
      endforeach()
      if(hp IN_LIST deps)
        fail("${c}: imported <${nm}> was parsed textually (${hp} in depfile)")
      endif()
      if(NOT bp IN_LIST deps)
        fail("${c}: BMI of <${nm}> (${bp}) not in depfile")
      endif()
      math(EXPR nimp "${nimp} + 1")
      if(negobj STREQUAL "")
        set(negobj "${c}")
        set(negbmi "${rawbmi}")
        set(negname "${nm}")
      endif()
    endforeach()
  endforeach()
  evid("depfiles: ${nimp} header-unit imports read from BMIs, none parsed textually")

  # --- negative check: BMI moved away -> the consumer's exact compile command fails
  if(negobj)
    execute_process(COMMAND ${NINJA} -C "${bdir}" -t commands "${negobj}" OUTPUT_VARIABLE cmds)
    string(STRIP "${cmds}" cmds)
    string(REPLACE ";" "<SEMI>" cmds "${cmds}")
    string(REPLACE "\n" ";" cmds "${cmds}")
    list(GET cmds -1 cmd)
    string(REPLACE "<SEMI>" ";" cmd "${cmd}")
    # move the BMI and the consumer's own object aside (a failing compiler deletes its -o output);
    # renaming back keeps the timestamps, so the tree stays up to date
    file(RENAME "${negbmi}" "${negbmi}.hu-bak")
    file(RENAME "${bdir}/${negobj}" "${bdir}/${negobj}.hu-bak")
    run_shell(rc out "${bdir}" "${cmd}")
    file(REMOVE "${bdir}/${negobj}")
    file(RENAME "${bdir}/${negobj}.hu-bak" "${bdir}/${negobj}")
    file(RENAME "${negbmi}.hu-bak" "${negbmi}")
    get_filename_component(bn "${negbmi}" NAME)
    if(rc EQUAL 0)
      fail("negative check: compiling ${negobj} succeeded without the BMI of <${negname}>")
    endif()
    string(FIND "${out}" "${bn}" pos)
    if(pos LESS 0)
      first_lines(e "${out}" 2)
      fail("negative check: compile of ${negobj} failed, but not because of the missing BMI ${bn}: ${e}")
    endif()
    first_lines(e "${out}" 1)
    evid("negative: without BMI of <${negname}> the compile of ${negobj} fails (${e})")
    expect_noop("${bdir}" "after negative check")
  endif()
endfunction()

# ------------------------------------------------------------------------------------------------ tests
function(test_t01_stl bdir)
  hu_configure(t01_stl "${bdir}")
  bail_if_failed()
  hu_build_check(t01_stl "${bdir}")
endfunction()

function(test_t02_thirdparty bdir)
  hu_configure(t02_thirdparty "${bdir}")
  bail_if_failed()
  hu_build_check(t02_thirdparty "${bdir}")
  bail_if_failed()
  if(NOT TC STREQUAL "gcc")
    return()
  endif()
  # GCC build-order independence of isolated header units (string vs fmt, whose header includes <string>)
  read_manifest("${bdir}")
  set(cs "${MF_BMI_string}")
  set(cf "${MF_BMI_fmt_format_h}")
  set(os "CMakeFiles/hu_std.dir/hu/string${OBJ}")
  set(of "CMakeFiles/hu_fmt.dir/hu/fmt/format.h${OBJ}")
  # SOURCE_DATE_EPOCH: GCC embeds "buildtime:" in every CMI (-g); fixing it makes CMIs byte-comparable.
  set(hashes)
  foreach(order "${os};${of}" "${of};${os}" "${os};${of}")
    file(REMOVE "${cs}" "${cf}" "${bdir}/${os}" "${bdir}/${of}")
    foreach(o IN LISTS order)
      run(rc out "${bdir}" "${CMAKE_COMMAND}" -E env SOURCE_DATE_EPOCH=1000000000 ${NINJA} "${o}")
      if(NOT rc EQUAL 0)
        fail("build-order test: building ${o} failed")
      endif()
    endforeach()
    file(SHA256 "${cs}" hs)
    file(SHA256 "${cf}" hf)
    list(APPEND hashes "${hs}/${hf}")
  endforeach()
  list(GET hashes 0 a)
  list(GET hashes 1 b)
  list(GET hashes 2 c)
  _log("CMI hashes string/fmt: order string->fmt ${a}; fmt->string ${b}; string->fmt again ${c}")
  if(NOT a STREQUAL c)
    fail("build-order test: GCC CMIs are not reproducible even for the same order")
  endif()
  if(NOT a STREQUAL b)
    fail("build-order test: CMI content depends on build order")
  endif()
  run(rc out "${bdir}" ${NINJA})
  if(NOT rc EQUAL 0)
    fail("rebuild after build-order test failed")
  endif()
  file(REMOVE "${cs}" "${bdir}/${os}")      # rebuild ONLY <string>; the fmt CMI stays
  run(rc out "${bdir}" ${NINJA})
  if(NOT rc EQUAL 0 OR out MATCHES "CRC")
    fail("rebuilding only the <string> CMI broke a consumer of both (CRC mismatch?)")
  endif()
  expect_noop("${bdir}" "after build-order test")
  bail_if_failed()
  evid("GCC: string/fmt CMIs byte-identical for both build orders; rebuilding only <string> -> no CRC mismatch")
endfunction()

function(test_t03_named_modules bdir)
  hu_configure(t03_named_modules "${bdir}")
  bail_if_failed()
  hu_build_check(t03_named_modules "${bdir}")
  bail_if_failed()
  file(STRINGS "${bdir}/build.ninja" synth REGEX "^build .*@synth_")
  list(FILTER synth EXCLUDE REGEX "@cmake_cxx_std@synth")
  if(synth)
    list(GET synth 0 s)
    fail("synthetic BMI target created: ${s}")
  endif()
  # Boundary probe: module m2 does a NON-exported 'import <vector>;' and its importer uses std::vector members.
  run(rc out "${bdir}" ${NINJA} p_m2_consumer)
  if(rc EQUAL 0)
    set(pr "OK")
  else()
    first_lines(e "${out}" 1)
    set(pr "FAIL (${e})")
  endif()
  set_property(GLOBAL PROPERTY CUR_PROBES " m2_plain_import_reachability=${pr}")
  evid("no m@synth_* target; t03_other (other target) imports m without header-unit flags; probe non-exported HU import reachable from importer: ${pr}")

  # Kitware #28166: an importer of m with target-level options makes CMake synthesize a BMI of m (m@synth_N)
  # with the importer's flags.  Its scan/BMI statements must still wait for the header units.
  set(bs "${bdir}-synth")
  file(REMOVE_RECURSE "${bs}")
  run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${PROTO}/tests/t03_named_modules" -B "${bs}" -G Ninja
      -DCMAKE_BUILD_TYPE=Debug ${TC_ARGS} -DT03_SYNTH=ON -DT03_SYNTH_OPTIONS=-O2)
  if(NOT rc EQUAL 0)
    fail("T03_SYNTH: configure failed")
  endif()
  file(STRINGS "${bs}/build.ninja" sy REGEX "^build cmake_object_order_depends_target_m@synth_[0-9]+:")
  file(STRINGS "${bs}/build.ninja" mo REGEX "^build cmake_object_order_depends_target_m:")
  if(NOT sy)
    fail("T03_SYNTH: CMake did not synthesize a BMI target for m (probe ineffective)")
  endif()
  if(NOT mo MATCHES " hu_std_ready" OR NOT sy MATCHES " cmake_object_order_depends_target_m( |$)")
    fail("T03_SYNTH: m@synth's object order does not reach hu_std_ready")
  endif()
  run(rc out "${bs}" ${NINJA})
  if(NOT rc EQUAL 0)
    first_lines(e "${out}" 2)
    fail("T03_SYNTH: build failed: ${e}")
  endif()
  execute_process(COMMAND "${bs}/t03_synth${EXE}" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    fail("T03_SYNTH: t03_synth returned ${rc}")
  endif()
  expect_noop("${bs}" "T03_SYNTH")
  bail_if_failed()
  evid("#28166 case: importer with target-level -O2 -> CMake synthesizes m@synth_N; its order phony reaches hu_std_ready; builds, runs, no-op")
endfunction()

function(test_t04_shared_set bdir)
  hu_configure(t04_shared_set "${bdir}")
  bail_if_failed()
  hu_build_check(t04_shared_set "${bdir}")
  bail_if_failed()
  foreach(v std ext exc dup)
    set(bb "${bdir}-bad-${v}")
    file(REMOVE_RECURSE "${bb}")
    run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${PROTO}/tests/t04_shared_set" -B "${bb}" -G Ninja
        -DCMAKE_BUILD_TYPE=Debug ${TC_ARGS} -DT04_BAD=${v})
    if(v STREQUAL "std")
      set(want "is incompatible with header-unit set 'hu_std'.*C[+][+]23")
    elseif(v STREQUAL "ext")
      set(want "is incompatible with header-unit set 'hu_std'.*CXX_EXTENSIONS=OFF")
    elseif(v STREQUAL "exc")
      set(want "is incompatible with header-unit set 'hu_std'.*exceptions/RTTI options differ")
    elseif(TC STREQUAL "gcc")
      set(want "is already a header unit of set 'hu_std'")
    else()
      set(want "would get two header units for")
    endif()
    string(REGEX REPLACE "[ \n]+" " " flat "${out}")
    if(rc EQUAL 0 OR NOT flat MATCHES "${want}")
      fail("T04_BAD=${v}: configure did not fail with the expected message ('${want}')")
    endif()
  endforeach()
  evid("2 targets share hu_std; rejected at configure time: CXX_STANDARD 23 consumer, CXX_EXTENSIONS OFF consumer, -fno-exceptions consumer, a second set declaring <vector> (GCC) / a TU receiving <vector> from two sets (Clang)")
endfunction()

function(t05_step bdir what)
  run(rc out "${bdir}" ${NINJA} -n -d explain)
  string(FIND "${out}" "hu_tiny.dir/hu/tiny/tiny.hpp${OBJ}" p1)
  if(p1 LESS 0)
    fail("${what}: ninja -d explain does not plan the BMI rebuild")
  endif()
  run(rc out "${bdir}" ${NINJA})
  string(FIND "${out}" "Building CXX object CMakeFiles/hu_tiny.dir/hu/tiny/tiny.hpp${OBJ}" p1)
  string(FIND "${out}" "Building CXX object CMakeFiles/t05.dir/main.cpp${OBJ}" p2)
  if(NOT rc EQUAL 0 OR p1 LESS 0 OR p2 LESS 0 OR p2 LESS p1)
    fail("${what}: BMI and then consumer were not rebuilt")
  endif()
  expect_noop("${bdir}" "${what}")
endfunction()

function(t05_value out bdir)
  execute_process(COMMAND "${bdir}/t05${EXE}" RESULT_VARIABLE rc)
  _log("t05 exit code: ${rc}")
  set(${out} "${rc}" PARENT_SCOPE)
endfunction()

function(test_t05_rebuild bdir)
  set(vend "${bdir}-vendor")
  if(FRESH)
    file(REMOVE_RECURSE "${vend}")
  endif()
  hu_configure(t05_rebuild "${bdir}" "-DT05_VENDOR_COPY=${vend}")
  bail_if_failed()
  set(det "${vend}/include/tiny/detail.hpp")
  file(READ "${det}" c)
  string(REPLACE "= 42;" "= 41;" c "${c}")
  file(WRITE "${det}" "${c}")
  hu_build_check(t05_rebuild "${bdir}" NOCTEST)
  bail_if_failed()
  t05_value(v "${bdir}")
  if(NOT v EQUAL 41)
    fail("t05 returned ${v}, expected 41")
  endif()
  file(TOUCH "${det}")
  t05_step("${bdir}" "touch detail.hpp (included by the header unit)")
  bail_if_failed()
  file(SIZE "${det}" s0)
  file(READ "${det}" c)
  string(REPLACE "= 41;" "= 42;" c "${c}")
  file(WRITE "${det}" "${c}")
  file(SIZE "${det}" s1)
  if(NOT s0 EQUAL s1)
    fail("same-size edit changed the size")
  endif()
  t05_step("${bdir}" "same-size edit 41->42")
  bail_if_failed()
  t05_value(v "${bdir}")
  if(NOT v EQUAL 42)
    fail("after same-size edit t05 returned ${v}, expected 42 (stale BMI?)")
  endif()
  file(TOUCH "${vend}/include/tiny/tiny.hpp")
  t05_step("${bdir}" "touch tiny.hpp (the header unit's own header)")
  bail_if_failed()
  evid("touch / same-size edit of external headers -> explain plans BMI rebuild, BMI then consumer rebuilt, exe 41->42, then no-op")
endfunction()

function(test_t06_mixed bdir)
  hu_configure(t06_mixed "${bdir}")
  bail_if_failed()
  set(res "")
  foreach(p import_then_include include_then_import cstdio_then_import loaded_not_imported
            import_then_include_same include_same_then_import)
    run(rc out "${bdir}" ${NINJA} p_${p})
    if(rc EQUAL 0)
      string(APPEND res " ${p}=OK")
    else()
      first_lines(e "${out}" 1)
      string(APPEND res " ${p}=FAIL")
      _log("probe ${p} first error: ${e}")
    endif()
  endforeach()
  set_property(GLOBAL PROPERTY CUR_PROBES "${res}")
  evid("boundary probes:${res}")
  hu_build_check(t06_mixed "${bdir}")
  bail_if_failed()
  read_manifest("${bdir}")
  ninja_deps(deps "${bdir}" "CMakeFiles/t06.dir/excluded.cpp${OBJ}")
  _norm(hp "${MF_PATH_vector}")
  if(NOT hp IN_LIST deps)
    fail("excluded.cpp did not parse <vector> textually")
  endif()
  ninja_deps(deps "${bdir}" "CMakeFiles/t06.dir/mixed.cpp${OBJ}")
  evid("excluded.cpp (not in SOURCES) parsed <vector> textually and built normally")
endfunction()

