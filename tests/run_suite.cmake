function(test_t08_auto bdir)
  hu_configure(t08_auto "${bdir}")
  bail_if_failed()
  hu_build_check(t08_auto "${bdir}")
  bail_if_failed()
  file(READ "${bdir}/CMakeFiles/header_units/manifest.txt" mf)
  if(NOT mf MATCHES "^t08_hu[|]" OR NOT mf MATCHES "\nt08b_hu[|]string[|]")
    fail("unexpected auto-generated sets:\n${mf}")
  endif()
  if(mf MATCHES "t08b_hu[|]vector[|]")
    fail("t08b did not reuse t08's <vector> header unit")
  endif()
  evid("sets generated from imports: t08_hu (vector, fmt/format.h, mylib/api.h, local.h by path), t08b_hu (string; vector reused)")

  # The import scan: hu-mapper's (default) and CMake's give the same build files; a reconfigure reads no unchanged
  # source (the scan cache is not rewritten); an import added to a source is found on the next configure.
  set(hud "${bdir}/CMakeFiles/header_units")
  set(outs build.ninja CMakeFiles/header_units/manifest.txt)
  if(NOT EXISTS "${hud}/scan-cache.txt")
    fail("no scan cache: hu-mapper's scan did not run")
    return()
  endif()
  file(TIMESTAMP "${hud}/scan-cache.txt" ts0 "%Y%m%d%H%M%S" UTC)
  file(SHA256 "${hud}/scan-cache.txt" sc0)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
  run(rc out "${PROTO}" "${CMAKE_EXE}" "${bdir}")
  file(TIMESTAMP "${hud}/scan-cache.txt" ts1 "%Y%m%d%H%M%S" UTC)
  if(NOT rc EQUAL 0 OR NOT ts0 STREQUAL ts1)
    fail("a reconfigure without changes rewrote the scan cache (or failed: ${rc})")
  endif()
  # (compared after a reconfigure: CMake itself writes some variables of build.ninja differently on the first run,
  # e.g. TARGET_PDB with MinGW)
  foreach(f IN LISTS outs)
    file(READ "${bdir}/${f}" "nat_${f}")
  endforeach()
  run(rc out "${PROTO}" "${CMAKE_EXE}" -DHU_NATIVE_SCAN=OFF "${bdir}")
  foreach(f IN LISTS outs)
    file(READ "${bdir}/${f}" cmk)
    if(NOT rc EQUAL 0 OR NOT cmk STREQUAL "${nat_${f}}")
      fail("HU_NATIVE_SCAN=OFF (CMake's scan) gives another ${f} than hu-mapper's scan (or failed: ${rc})")
    endif()
  endforeach()
  run(rc out "${PROTO}" "${CMAKE_EXE}" -DHU_NATIVE_SCAN=ON "${bdir}")
  bail_if_failed()
  set(src "${ROOT}/t08-scan/src")
  file(REMOVE_RECURSE "${ROOT}/t08-scan")
  file(WRITE "${src}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.28...4.5)\nproject(t08s CXX)\n"
    "set(CMAKE_CXX_STANDARD 20)\ninclude(\"${PROTO}/cmake/HeaderUnits.cmake\")\n"
    "add_executable(t08s a.cpp)\ntarget_auto_header_units(t08s)\n")
  file(WRITE "${src}/a.cpp" "import <vector>;\nint main() { return std::vector<int>{}.size(); }\n")
  run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${src}" -B "${ROOT}/t08-scan/b" -G Ninja ${TC_ARGS})
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
  file(WRITE "${src}/a.cpp" "import <vector>;\nimport <string>;\nint main() { return std::string{}.size(); }\n")
  run(rc2 out "${PROTO}" "${CMAKE_EXE}" "${ROOT}/t08-scan/b")
  file(READ "${ROOT}/t08-scan/b/CMakeFiles/header_units/manifest.txt" mf2)
  if(NOT rc EQUAL 0 OR NOT rc2 EQUAL 0 OR NOT mf2 MATCHES "[|]string[|]")
    fail("an import added to a scanned source was not found on reconfigure (${rc}/${rc2}):\n${mf2}")
  endif()
  evid("hu-mapper's scan and CMake's give the same build.ninja and manifest; an unchanged reconfigure rewrites no scan cache; an added import is found")
endfunction()

function(test_t09_header_import_error bdir)
  file(REMOVE_RECURSE "${bdir}")
  run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${PROTO}/tests/t09_header_import_error" -B "${bdir}" -G Ninja ${TC_ARGS})
  if(rc EQUAL 0)
    fail("configure succeeded although a header unit's header contains an import")
  endif()
  string(REGEX REPLACE "[ \t\r\n]+" " " flat "${out}")   # CMake wraps long messages
  if(NOT flat MATCHES "not supported yet")
    fail("configure failed without the expected message")
  endif()
  evid("configure rejected inc/bad.h with: header contains import <vector> ... not supported yet")
endfunction()

