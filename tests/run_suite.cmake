# Test driver for the HeaderUnits prototype (portable: runs on Linux and Windows).
#
#   cmake -DTC=gcc|clang|libcxx|win|clangcl|mingw|msvc -DCMAKE_EXE=<cmake under test> -DTAG=<label> [-DTESTS=t01;t03]
#         [-DFRESH=ON] [-DEXTRA_ARGS=<configure arguments>] [-DRESULTS=<file>] -P tests/run_suite.cmake
#   (tests/run_parallel.cmake runs the tests in parallel, with the same options)
#
# For every test: fresh configure + build (-j, Ninja default), ctest, no-op rebuild, build.ninja edge check
# (scan AND compile of every header-unit consumer depend on its BMIs), depfile evidence (imported headers
# are not parsed textually, the BMIs are read), negative check (BMI moved away -> the consumer's exact
# compile command fails), plus test-specific steps.  Writes _build/<TC>-<TAG>/results.txt and logs/.
cmake_minimum_required(VERSION 3.28)
foreach(v TC CMAKE_EXE TAG)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "run_suite.cmake: -D${v}=... is required")
  endif()
endforeach()
get_filename_component(PROTO "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(ROOT "${PROTO}/_build/${TC}-${TAG}")
if(NOT DEFINED FRESH)
  set(FRESH ON)
endif()
file(MAKE_DIRECTORY "${ROOT}/logs")
# RESULTS: where the table goes (tests/run_parallel.cmake gives each test its own file)
if(NOT DEFINED RESULTS)
  set(RESULTS "${ROOT}/results.txt")
endif()
file(REMOVE "${RESULTS}")   # never report a previous run's table if this one aborts
get_filename_component(_cmdir "${CMAKE_EXE}" DIRECTORY)
find_program(CTEST_EXE NAMES ctest ctest.exe HINTS "${_cmdir}" NO_DEFAULT_PATH REQUIRED)
set(NINJA ninja)
# NINJA_JOBS (-D or environment): jobs of each test's ninja (default: ninja's, all cores), to keep several suites or
# tests at a time from exhausting a machine's memory
if(NOT DEFINED NINJA_JOBS AND DEFINED ENV{NINJA_JOBS})
  set(NINJA_JOBS "$ENV{NINJA_JOBS}")
endif()
if(NINJA_JOBS)
  list(APPEND NINJA -j ${NINJA_JOBS})
endif()
if(TC STREQUAL "gcc")
  set(TC_ARGS -DCMAKE_CXX_COMPILER=g++)
  set(OBJ .o)
elseif(TC STREQUAL "clang")
  if(NOT DEFINED CLANG_CXX)
    set(CLANG_CXX clang++-22)
  endif()
  if(NOT DEFINED CLANG_FLAGS)
    set(CLANG_FLAGS --gcc-toolchain=/usr/local)   # GCC 16's libstdc++ in docker/Dockerfile
  endif()
  set(TC_ARGS -DCMAKE_CXX_COMPILER=${CLANG_CXX} "-DCMAKE_CXX_FLAGS=${CLANG_FLAGS}")
  set(OBJ .o)
elseif(TC STREQUAL "libcxx")
  # Clang with libc++ (Linux)
  if(NOT DEFINED CLANG_CXX)
    set(CLANG_CXX clang++-22)
  endif()
  if(NOT DEFINED LIBCXX_FLAGS)
    set(LIBCXX_FLAGS -stdlib=libc++)               # libc++ 22 in docker/Dockerfile
  endif()
  # CMake 4.5 sets up `import std` for every C++20 target, from the modules file of the C++ library that the compiler
  # names. In docker/Dockerfile that is /usr/lib/x86_64-linux-gnu/libc++.modules.json, whose relative paths resolve
  # only from /usr/lib/llvm-22/lib (where a symbolic link to it is), so the configure fails ("Cannot find source
  # file: /lib/share/libc++/v1/std.compat.cppm") unless CMAKE_CXX_STDLIB_MODULES_JSON names the link. Empty: not set.
  if(NOT DEFINED LIBCXX_MODULES_JSON)
    set(LIBCXX_MODULES_JSON /usr/lib/llvm-22/lib/libc++.modules.json)
  endif()
  set(TC_ARGS -DCMAKE_CXX_COMPILER=${CLANG_CXX} "-DCMAKE_CXX_FLAGS=${LIBCXX_FLAGS}")
  if(LIBCXX_MODULES_JSON)
    list(APPEND TC_ARGS "-DCMAKE_CXX_STDLIB_MODULES_JSON=${LIBCXX_MODULES_JSON}")
  endif()
  set(OBJ .o)
elseif(TC STREQUAL "win")
  # CLANG_CXX: a clang++ other than the first on PATH (vcvars64.bat puts Visual Studio's own, older Clang first).
  if(NOT DEFINED CLANG_CXX OR CLANG_CXX STREQUAL "")
    set(CLANG_CXX clang++)
  endif()
  set(TC_ARGS -DCMAKE_CXX_COMPILER=${CLANG_CXX})
  set(OBJ .obj)
elseif(TC STREQUAL "clangcl")
  # clang-cl (Clang's MSVC-style driver) with the MSVC STL, from a developer prompt; CLANG_CXX as for TC=win
  if(NOT DEFINED CLANG_CXX OR CLANG_CXX STREQUAL "")
    set(CLANG_CXX clang-cl)
  endif()
  set(TC_ARGS -DCMAKE_CXX_COMPILER=${CLANG_CXX})
  set(OBJ .obj)
elseif(TC STREQUAL "mingw")
  # GCC on Windows (MinGW-w64); its bin directory must be on PATH for the test executables' runtime DLLs
  if(NOT DEFINED MINGW_CXX)
    set(MINGW_CXX g++)
  endif()
  set(TC_ARGS -DCMAKE_CXX_COMPILER=${MINGW_CXX})
  set(OBJ .obj)
elseif(TC STREQUAL "msvc")
  # MSVC with Ninja (from a developer prompt): the module builds the header units (HeaderUnits/MSVCNinja.cmake)
  set(TC_ARGS -DCMAKE_CXX_COMPILER=cl)
  set(OBJ .obj)
else()
  message(FATAL_ERROR "TC must be gcc, clang, libcxx, win, clangcl, mingw or msvc")
endif()
list(APPEND TC_ARGS ${EXTRA_ARGS})   # -DEXTRA_ARGS=...: more configure arguments for every test (e.g. -DHU_NATIVE_SCAN=OFF)
if(CMAKE_HOST_WIN32)
  set(EXE .exe)
else()
  set(EXE "")
endif()
set(ALL_TESTS t01_stl t02_thirdparty t03_named_modules t04_shared_set t05_rebuild t06_mixed t07_own_headers t08_auto t09_header_import_error t10_header_imports t11_transitive t12_build_tree t13_same_name t14_textual_pragma t15_scan_sources t16_deferred t17_lookup t18_spelling t19_scale t20_wrong_file t21_self_include t22_import_std t23_multi_config t24_two_sets t25_shared_source t26_shared_targets t27_module_two_targets)
if(NOT TESTS)
  set(TESTS ${ALL_TESTS})
endif()
execute_process(COMMAND "${CMAKE_EXE}" --version OUTPUT_VARIABLE _ver)
string(REGEX MATCH "[0-9]+\\.[0-9]+\\.[0-9]+[^\n]*" CMAKE_VER "${_ver}")

# ---------------------------------------------------------------------------------------------- helpers
function(_log)
  string(JOIN "" t ${ARGN})
  get_property(f GLOBAL PROPERTY CUR_LOG)
  file(APPEND "${f}" "${t}\n")
endfunction()

# run(<rc var> <output var> <working dir> <command...>)
function(run rcv outv wd)
  string(JOIN " " c ${ARGN})
  _log("\n$ (cd ${wd}) ${c}")
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${wd}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
  _log("${out}[rc=${rc}]")
  set(${rcv} "${rc}" PARENT_SCOPE)
  set(${outv} "${out}" PARENT_SCOPE)
endfunction()

macro(fail msg)
  set_property(GLOBAL PROPERTY CUR_FAIL "${msg}")
  _log("\n*** FAIL: ${msg}")
  return()
endmacro()
macro(bail_if_failed)
  get_property(_f GLOBAL PROPERTY CUR_FAIL)
  if(_f)
    return()
  endif()
endmacro()
# The test does not apply here (verdict SKIP, with the reason).
function(skip why)
  set_property(GLOBAL PROPERTY CUR_SKIP "${why}")
endfunction()

function(evid t)
  set_property(GLOBAL APPEND_STRING PROPERTY CUR_EVID "${t}; ")
  _log(">>> evidence: ${t}")
endfunction()

function(_norm out p)
  string(REPLACE "$:" ":" p "${p}")
  string(REPLACE "$ " " " p "${p}")
  file(TO_CMAKE_PATH "${p}" p)
  cmake_path(NORMAL_PATH p)
  if(CMAKE_HOST_WIN32)
    string(TOLOWER "${p}" p)
  endif()
  set(${out} "${p}" PARENT_SCOPE)
endfunction()

function(first_lines out text n)
  string(REPLACE ";" "," text "${text}")
  string(REPLACE "\\" "/" text "${text}")   # fail() is a macro: a backslash in its message would be parsed as an escape
  string(REPLACE "\n" ";" l "${text}")
  list(FILTER l INCLUDE REGEX "error|fatal|Error")
  list(SUBLIST l 0 ${n} l)
  string(JOIN " | " r ${l})
  string(LENGTH "${r}" len)
  if(len GREATER 300)
    string(SUBSTRING "${r}" 0 300 r)
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# Parsed build.ninja: statement headers + FLAGS / OBJ_FILE, as parallel lists (";" escaped as <SEMI>).
function(parse_ninja bdir)
  file(READ "${bdir}/build.ninja" bn)
  string(REPLACE ";" "<SEMI>" bn "${bn}")
  string(REPLACE "\n" ";" lines "${bn}")
  set(heads)
  set(flags)
  set(objs)
  set(cur -1)
  foreach(line IN LISTS lines)
    if(line MATCHES "^build ")
      string(REPLACE "\\" "/" line "${line}")          # MSVC: CMake spells build.ninja paths with backslashes
      list(APPEND heads "${line}")
      list(APPEND flags "-")
      list(APPEND objs "-")
      math(EXPR cur "${cur} + 1")
    elseif(cur GREATER -1 AND line MATCHES "^  FLAGS = (.*)$")
      list(REMOVE_AT flags ${cur})
      list(INSERT flags ${cur} "${CMAKE_MATCH_1}")
    elseif(cur GREATER -1 AND line MATCHES "^  OBJ_FILE = (.*)$")
      string(REPLACE "\\" "/" o "${CMAKE_MATCH_1}")   # Windows: OBJ_FILE uses backslashes
      list(REMOVE_AT objs ${cur})
      list(INSERT objs ${cur} "${o}")
    endif()
  endforeach()
  set(NB_HEADS "${heads}" PARENT_SCOPE)
  set(NB_FLAGS "${flags}" PARENT_SCOPE)
  set(NB_OBJS "${objs}" PARENT_SCOPE)
endfunction()

# BMIs (absolute) a statement's FLAGS hand to the TU, or empty if it is not a header-unit consumer.
function(hu_bmis_of_flags out f)
  set(r)
  # Clang consumers carry their header-unit options in a response file (@<file>.rsp): read it in.
  string(REGEX MATCHALL "@[^ \"']+[.]rsp" rsps "${f}")
  # MSVC: iface_*.rsp gives an importer of a named module the header units that module imports; they are not the TU's
  # own (its compile waits for the module's IFC, which waits for them).
  list(FILTER rsps EXCLUDE REGEX "/iface_[0-9a-f]+[.]rsp$")
  foreach(rf IN LISTS rsps)
    string(SUBSTRING "${rf}" 1 -1 rf)
    string(REPLACE "$:" ":" rf "${rf}")
    file(READ "${rf}" rc)
    string(REPLACE "\"" "" rc "${rc}")
    string(REPLACE "\n" " " rc "${rc}")
    string(APPEND f " ${rc}")
  endforeach()
  # GCC: the TU's mapper file, gcc-m/<content hash>.map
  if(f MATCHES "header_units/gcc-m/[^ \"']+\\.map")
    string(REGEX MATCH "[^ \"'|]+/header_units/gcc-m/[^ \"']+\\.map" m "${f}")
    file(STRINGS "${m}" ml)
    foreach(l IN LISTS ml)
      if(l MATCHES "^[^$].* ([^ ]+)$")                 # "<header> <BMI>", the header maybe quoted; skips "$root ."
        set(m "${CMAKE_MATCH_1}")
        if(NOT IS_ABSOLUTE "${m}")
          set(m "${bdir}/${m}")                           # relative to the top build dir ($root .)
        endif()
        list(APPEND r "${m}")
      endif()
    endforeach()
  elseif(f MATCHES "/headerUnit ")
    # MSVC: /headerUnit "<header>=<ifc>" lines of the response file (quotes removed above; the header may hold blanks)
    string(REGEX MATCHALL "=[^ =]+/hu/[^ ]+" ms "${f}")
    foreach(m IN LISTS ms)
      string(SUBSTRING "${m}" 1 -1 m)
      if(NOT IS_ABSOLUTE "${m}")
        set(m "${bdir}/${m}")
      endif()
      list(APPEND r "${m}")
    endforeach()
  else()
    string(REGEX MATCHALL "-fmodule-file=[^ ]+/hu/[^ ]+" ms "${f}")
    foreach(m IN LISTS ms)
      string(REGEX REPLACE "^-fmodule-file=" "" m "${m}")
      string(REGEX REPLACE "^[A-Za-z0-9_]+=" "" m "${m}")   # lazy named form <module>=<pcm>
      if(NOT IS_ABSOLUTE "${m}")
        set(m "${bdir}/${m}")                             # spelled relative to the top build dir
      endif()
      list(APPEND r "${m}")
    endforeach()
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

function(read_manifest bdir)
  file(STRINGS "${bdir}/CMakeFiles/header_units/manifest.txt" ml)
  set(names)
  foreach(l IN LISTS ml)
    string(REPLACE "|" ";" f "${l}")
    list(GET f 1 n)
    list(GET f 2 p)
    list(GET f 3 b)
    string(MAKE_C_IDENTIFIER "${n}" id)
    # one name can have several header units (a different file per target): keep them all
    list(APPEND MF_PATHS_${id} "${p}")
    list(APPEND MF_BMIS_${id} "${b}")
    set(MF_PATHS_${id} "${MF_PATHS_${id}}" PARENT_SCOPE)
    set(MF_BMIS_${id} "${MF_BMIS_${id}}" PARENT_SCOPE)
    set(MF_PATH_${id} "${p}" PARENT_SCOPE)
    set(MF_BMI_${id} "${b}" PARENT_SCOPE)
    list(APPEND names "${n}")
  endforeach()
  set(MF_NAMES "${names}" PARENT_SCOPE)
endfunction()

function(ninja_deps out bdir obj)
  execute_process(COMMAND ${NINJA} -C "${bdir}" -t deps "${obj}" OUTPUT_VARIABLE o ERROR_VARIABLE o)
  string(REPLACE ";" "<SEMI>" o "${o}")
  string(REPLACE "\n" ";" l "${o}")
  set(r)
  foreach(x IN LISTS l)
    if(x MATCHES "^    (.+)$")
      set(n "${CMAKE_MATCH_1}")
      if(NOT IS_ABSOLUTE "${n}")
        set(n "${bdir}/${n}")    # Ninja keeps build-tree paths relative to the build dir
      endif()
      _norm(n "${n}")
      list(APPEND r "${n}")
    endif()
  endforeach()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

function(run_shell rcv outv wd cmd)
  if(CMAKE_HOST_WIN32)
    # absolute path: cmd.exe may be configured not to search the current directory (NoDefaultCurrentDirectoryInExePath)
    file(WRITE "${wd}/_hu_cmd.bat" "@echo off\r\n${cmd}\r\n")
    file(TO_NATIVE_PATH "${wd}/_hu_cmd.bat" bat)
    run(rc out "${wd}" cmd /c "${bat}")
  else()
    run(rc out "${wd}" sh -c "${cmd}")
  endif()
  set(${rcv} "${rc}" PARENT_SCOPE)
  set(${outv} "${out}" PARENT_SCOPE)
endfunction()

function(expect_noop bdir what)
  run(rc out "${bdir}" ${NINJA})
  if(NOT rc EQUAL 0 OR NOT out MATCHES "ninja: no work to do")
    fail("${what}: second build was not a no-op")
  endif()
endfunction()

function(hu_configure name bdir)
  if(FRESH)
    file(REMOVE_RECURSE "${bdir}")
  endif()
  run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${PROTO}/tests/${name}" -B "${bdir}" -G Ninja
      -DCMAKE_BUILD_TYPE=Debug ${TC_ARGS} ${ARGN})
  if(NOT rc EQUAL 0)
    first_lines(e "${out}" 3)
    fail("configure failed: ${e}")
  endif()
endfunction()

# Build, ctest, no-op, edge check, depfile evidence, negative check.
function(hu_build_check name bdir)
  cmake_parse_arguments(A "NOCTEST" "" "" ${ARGN})
  run(rc out "${bdir}" ${NINJA})
  if(NOT rc EQUAL 0)
    first_lines(e "${out}" 3)
    fail("build failed: ${e}")
  endif()
  if(NOT A_NOCTEST)
    run(rc out "${bdir}" "${CTEST_EXE}" --output-on-failure)
    if(NOT rc EQUAL 0)
      fail("ctest failed")
    endif()
  endif()
  expect_noop("${bdir}" "after build")
  bail_if_failed()
  evid("build+run ok, 2nd build no-op")

  # --- edges: every header-unit consumer's scan AND compile statement lists its BMIs as inputs
  parse_ninja("${bdir}")
  read_manifest("${bdir}")
  list(LENGTH NB_HEADS n)
  math(EXPR n "${n} - 1")
  set(nedges 0)
  set(consumers)
  set(scanflags_objs)
  foreach(i RANGE ${n})
    list(GET NB_HEADS ${i} h)
    list(GET NB_FLAGS ${i} f)
    list(GET NB_OBJS ${i} o)
    if(NOT h MATCHES "^build ([^ ]+): (CXX_SCAN__|CXX_COMPILER__[^ ]*_scanned_)")
      continue()
    endif()
    set(out "${CMAKE_MATCH_1}")
    set(kind "${CMAKE_MATCH_2}")
    hu_bmis_of_flags(bmis "${f}")
    if(NOT bmis)
      continue()
    endif()
    string(FIND "${h}" " || " oo)
    string(SUBSTRING "${h}" 0 ${oo} hin)
    foreach(b IN LISTS bmis)
      file(RELATIVE_PATH rel "${bdir}" "${b}")
      string(FIND "${hin} " " ${rel} " pos)
      if(pos LESS 0)
        fail("edge missing: '${out}' does not depend on BMI '${rel}'")
      endif()
    endforeach()
    math(EXPR nedges "${nedges} + 1")
    if(kind STREQUAL "CXX_SCAN__")
      list(APPEND scanflags_objs "${o}")
      string(MD5 k "${o}")
      set(SCANFLAGS_${k} "${f}")
    else()
      list(APPEND consumers "${out}")
      string(MD5 k "${out}")
      set(CFLAGS_${k} "${f}")
      set(CBMIS_${k} "${bmis}")
      if(h MATCHES "_scanned_[A-Za-z]+ ([^ ]+)")
        set(CSRC_${k} "${CMAKE_MATCH_1}")
      endif()
    endif()
  endforeach()
  if(nedges EQUAL 0)
    fail("no header-unit consumer found in build.ninja")
  endif()
  # the scan sees the same header-unit flags as the compile
  foreach(c IN LISTS consumers)
    string(MD5 k "${c}")
    if(NOT c IN_LIST scanflags_objs OR NOT SCANFLAGS_${k} STREQUAL CFLAGS_${k})
      fail("scan statement of '${c}' lacks the header-unit flags of its compile")
    endif()
  endforeach()
  list(LENGTH consumers nc)
  evid("build.ninja: ${nedges} scan/compile edges of ${nc} TUs depend on their BMIs, scan flags == compile flags")

  # --- depfile evidence: every 'import <x>;' of a consumer is served by the BMI, never parsed textually
  set(nimp 0)
  set(negobj "")
  foreach(c IN LISTS consumers)
    if(c MATCHES "^CMakeFiles/p_")
      continue()   # boundary probes (t06) are judged separately
    endif()
    string(MD5 k "${c}")
    _norm(src "${CSRC_${k}}")
    if(NOT EXISTS "${src}")
      string(REPLACE "$:" ":" src "${CSRC_${k}}")
    endif()
    file(STRINGS "${src}" il REGEX "^[ \t]*(export[ \t]+)?import[ \t]*<[^>]+>[ \t]*;")
    ninja_deps(deps "${bdir}" "${c}")
    foreach(l IN LISTS il)
      string(REGEX REPLACE "^.*<([^>]+)>.*$" "\\1" nm "${l}")
      string(MAKE_C_IDENTIFIER "${nm}" id)
      if(NOT DEFINED MF_PATH_${id})
        continue()
      endif()
      # the header unit of this name that this consumer actually reads (its BMI is in the depfile; MSVC's is not:
      # the one its flags hand it, as a header can have a header unit in several sets, t24)
      set(own "")
      foreach(ob IN LISTS CBMIS_${k})
        _norm(ob "${ob}")
        list(APPEND own "${ob}")
      endforeach()
      set(hp "")
      set(bp "")
      set(rawbmi "")
      foreach(cp cb IN ZIP_LISTS MF_PATHS_${id} MF_BMIS_${id})
        _norm(np "${cp}")
        _norm(nb "${cb}")
        if(nb IN_LIST deps OR bp STREQUAL "" OR (nb IN_LIST own AND NOT bp IN_LIST own))
          set(hp "${np}")
          set(bp "${nb}")
          set(rawbmi "${cb}")
        endif()
        if(nb IN_LIST deps)
          break()
        endif()
      endforeach()
      if(hp IN_LIST deps)
        fail("${c}: imported <${nm}> was parsed textually (${hp} in depfile)")
      endif()
      # (MSVC's /showIncludes names no IFC: there the build.ninja edge check above stands for it)
      if(NOT bp IN_LIST deps AND NOT TC STREQUAL "msvc")
        fail("${c}: BMI of <${nm}> (${bp}) not in depfile")
      endif()
      math(EXPR nimp "${nimp} + 1")
      if(negobj STREQUAL "")
        set(negobj "${c}")
        set(negbmi "${rawbmi}")
        set(negname "${nm}")
      endif()
    endforeach()
  endforeach()
  evid("depfiles: ${nimp} header-unit imports read from BMIs, none parsed textually")

  # --- negative check: BMI moved away -> the consumer's exact compile command fails
  if(negobj)
    execute_process(COMMAND ${NINJA} -C "${bdir}" -t commands "${negobj}" OUTPUT_VARIABLE cmds)
    string(STRIP "${cmds}" cmds)
    string(REPLACE ";" "<SEMI>" cmds "${cmds}")
    string(REPLACE "\n" ";" cmds "${cmds}")
    list(GET cmds -1 cmd)
    string(REPLACE "<SEMI>" ";" cmd "${cmd}")
    # move the BMI and the consumer's own object aside (a failing compiler deletes its -o output);
    # renaming back keeps the timestamps, so the tree stays up to date
    file(RENAME "${negbmi}" "${negbmi}.hu-bak")
    file(RENAME "${bdir}/${negobj}" "${bdir}/${negobj}.hu-bak")
    run_shell(rc out "${bdir}" "${cmd}")
    file(REMOVE "${bdir}/${negobj}")
    file(RENAME "${bdir}/${negobj}.hu-bak" "${bdir}/${negobj}")
    file(RENAME "${negbmi}.hu-bak" "${negbmi}")
    get_filename_component(bn "${negbmi}" NAME)
    if(rc EQUAL 0)
      fail("negative check: compiling ${negobj} succeeded without the BMI of <${negname}>")
    endif()
    string(FIND "${out}" "${bn}" pos)
    if(TC STREQUAL "msvc" AND out MATCHES "C7612: could not find header unit")
      set(pos 0)                # cl names the header, not the missing IFC
    endif()
    if(pos LESS 0)
      first_lines(e "${out}" 2)
      fail("negative check: compile of ${negobj} failed, but not because of the missing BMI ${bn}: ${e}")
    endif()
    first_lines(e "${out}" 1)
    evid("negative: without BMI of <${negname}> the compile of ${negobj} fails (${e})")
    expect_noop("${bdir}" "after negative check")
  endif()
endfunction()

# ------------------------------------------------------------------------------------------------ tests
function(test_t01_stl bdir)
  hu_configure(t01_stl "${bdir}")
  bail_if_failed()
  hu_build_check(t01_stl "${bdir}")
  bail_if_failed()
  if(TC STREQUAL "msvc")
    t01_msvc_toolchain("${bdir}")
  endif()
  bail_if_failed()
  if(CMAKE_HOST_WIN32)
    t01_non_ascii()
  endif()
endfunction()

# Windows: a project whose source and build directories have non-ASCII names ("é" is in the usual ANSI code pages,
# "中" is not), with target_auto_header_units (hu-mapper's scan) and a header unit of a header next to the source.
# hu-mapper must be built (MinGW's linker opens its output with the ANSI code page) and, with GCC, find the source in
# hu-index.txt and open its map (it reads its arguments from the wide command line).  The build is checked by
# itself (ninja, ctest, no-op): the steps of hu_build_check that run commands through cmd.exe would read non-ASCII
# paths in the OEM code page.
function(t01_non_ascii)
  set(na "é中")
  if(TC STREQUAL "msvc")
    # cl prints /showIncludes in the ANSI code page: a character outside it comes out as "?" (README, Limitations).
    # "é" is in the usual ones (1252, 936, ...).
    set(na "é")
  endif()
  set(top "${ROOT}/t01-${na}")
  set(src "${top}/src-${na}")          # (no blank: GCC rejects a source or build path with one)
  set(b "${top}/b-${na}")
  file(REMOVE_RECURSE "${top}")
  file(WRITE "${src}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.28...4.5)\nproject(t01u CXX)\n"
    "set(CMAKE_CXX_STANDARD 20)\ninclude(\"${PROTO}/cmake/HeaderUnits.cmake\")\n"
    "add_executable(t01u main.cpp)\ntarget_auto_header_units(t01u)\nenable_testing()\nadd_test(NAME t01u COMMAND t01u)\n")
  file(WRITE "${src}/local.h" "#pragma once\ninline int local_value() { return 42; }\n")
  file(WRITE "${src}/main.cpp" "import <vector>;\nimport \"local.h\";\n"
    "int main() { return std::vector<int>{local_value()}[0] == 42 ? 0 : 1; }\n")
  # The first configure while main.cpp is locked (file(LOCK): reads of it fail, as while an editor saves it or a virus
  # scanner holds it): hu-mapper reports it and does not cache it, so the next configure, unlocked, finds its imports.
  file(LOCK "${src}/main.cpp" RESULT_VARIABLE lr)
  run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${src}" -B "${b}" -G Ninja -DCMAKE_BUILD_TYPE=Debug ${TC_ARGS})
  file(LOCK "${src}/main.cpp" RELEASE)
  string(REGEX REPLACE "[ \t\r\n]+" " " flat "${out}")
  # (the output is read in the console code page: in a double-byte one, such as 936, the "/" after "中" can become part
  # of a garbled character)
  if(NOT lr EQUAL 0 OR NOT flat MATCHES "hu-mapper: cannot read [^ ]*main[.]cpp")
    fail("a source that cannot be read (locked) was not reported by hu-mapper's scan (lock: ${lr})")
  endif()
  run(rc out "${PROTO}" "${CMAKE_EXE}" "${b}")
  if(NOT rc EQUAL 0)
    first_lines(e "${out}" 3)
    fail("non-ASCII directories: configure failed: ${e}")
  endif()
  if(out MATCHES "could not build hu-mapper" OR NOT EXISTS "${b}/CMakeFiles/header_units/hu-mapper${EXE}")
    fail("non-ASCII directories: hu-mapper was not built")
  endif()
  file(READ "${b}/CMakeFiles/header_units/manifest.txt" mf)
  if(NOT mf MATCHES "[|]vector[|]" OR NOT mf MATCHES "/src-${na}/local[.]h[|]")
    fail("non-ASCII directories: the scan did not find <vector> and \"local.h\":\n${mf}")
  endif()
  bail_if_failed()
  run(rc out "${b}" ${NINJA})
  if(NOT rc EQUAL 0)
    first_lines(e "${out}" 3)
    fail("non-ASCII directories: build failed: ${e}")
  endif()
  run(rc out "${b}" "${CTEST_EXE}" --output-on-failure)
  if(NOT rc EQUAL 0)
    fail("non-ASCII directories: ctest failed")
  endif()
  set(noop ", 2nd build no-op")
  if(TC STREQUAL "msvc")
    # Not checked with MSVC: Ninja records cl's /showIncludes in the ANSI code page while build.ninja is UTF-8, so a
    # header in a non-ASCII directory always looks missing -- a plain CMake project (C++20, no HeaderUnits) does the same.
    set(noop " (no no-op check: CMake/Ninja rebuild cl's TUs in non-ASCII directories)")
  else()
    expect_noop("${b}" "non-ASCII directories")
  endif()
  bail_if_failed()
  evid("source and build directories named *-${na}: hu-mapper built, the scan finds <vector> and \"local.h\", build+run ok${noop}; a source locked during a configure is reported, not cached, and its imports are found by the next one")
endfunction()

# MSVC: Ninja keeps no header of the C++ library in its dependencies; the header units depend on the compiler and on a
# file that records the toolchain instead (HeaderUnits/MSVCNinja.cmake).  After a CMake run without a change nothing is
# compiled (CMake's collation steps run once again); after one with another INCLUDE (an empty directory appended, so no
# header resolves differently) the header units are rebuilt, then main.cpp.
function(t01_msvc_toolchain bdir)
  run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${PROTO}/tests/t01_stl" -B "${bdir}")
  if(NOT rc EQUAL 0)
    fail("CMake re-run failed")
  endif()
  run(rc out "${bdir}" ${NINJA})
  if(NOT rc EQUAL 0 OR out MATCHES "Building CXX object")
    fail("a CMake run without changes: the next build compiled something")
  endif()
  expect_noop("${bdir}" "after a CMake run without changes")
  bail_if_failed()
  set(inc "$ENV{INCLUDE}")
  file(MAKE_DIRECTORY "${bdir}/empty-include")
  set(ENV{INCLUDE} "${inc};${bdir}/empty-include")
  run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${PROTO}/tests/t01_stl" -B "${bdir}")
  set(ENV{INCLUDE} "${inc}")      # (the later tests run with the original one)
  if(NOT rc EQUAL 0)
    fail("CMake re-run with another INCLUDE failed")
  endif()
  run(rc out "${bdir}" ${NINJA})
  string(REPLACE "\\" "/" out "${out}")
  set(last -1)
  foreach(h vector string iostream)
    string(FIND "${out}" "Building CXX object CMakeFiles/hu_std.dir/hu/${h}${OBJ}" p)
    if(p LESS 0)
      fail("another INCLUDE did not rebuild the header unit of <${h}>")
    endif()
    if(p GREATER last)
      set(last ${p})
    endif()
  endforeach()
  string(FIND "${out}" "Building CXX object CMakeFiles/t01.dir/main.cpp${OBJ}" p)
  if(NOT rc EQUAL 0 OR p LESS last)
    fail("another INCLUDE: the header units and then main.cpp were not rebuilt")
  endif()
  expect_noop("${bdir}" "after the rebuild for another INCLUDE")
  bail_if_failed()
  evid("MSVC: a CMake run without changes compiles nothing, one with another INCLUDE rebuilds the header units, then main.cpp, then no-op")
endfunction()

function(test_t02_thirdparty bdir)
  hu_configure(t02_thirdparty "${bdir}")
  bail_if_failed()
  hu_build_check(t02_thirdparty "${bdir}")
  bail_if_failed()
  if(NOT TC MATCHES "^(gcc|mingw)$")
    return()
  endif()
  # GCC build-order independence of isolated header units (string vs fmt, whose header includes <string>)
  read_manifest("${bdir}")
  set(cs "${MF_BMI_string}")
  set(cf "${MF_BMI_fmt_format_h}")
  set(os "CMakeFiles/hu_std.dir/hu/string${OBJ}")
  set(of "CMakeFiles/hu_fmt.dir/hu/fmt/format.h${OBJ}")
  # SOURCE_DATE_EPOCH: GCC embeds "buildtime:" in every CMI (-g); fixing it makes CMIs byte-comparable.
  set(hashes)
  foreach(order "${os};${of}" "${of};${os}" "${os};${of}")
    file(REMOVE "${cs}" "${cf}" "${bdir}/${os}" "${bdir}/${of}")
    foreach(o IN LISTS order)
      run(rc out "${bdir}" "${CMAKE_COMMAND}" -E env SOURCE_DATE_EPOCH=1000000000 ${NINJA} "${o}")
      if(NOT rc EQUAL 0)
        fail("build-order test: building ${o} failed")
      endif()
    endforeach()
    file(SHA256 "${cs}" hs)
    file(SHA256 "${cf}" hf)
    list(APPEND hashes "${hs}/${hf}")
  endforeach()
  list(GET hashes 0 a)
  list(GET hashes 1 b)
  list(GET hashes 2 c)
  _log("CMI hashes string/fmt: order string->fmt ${a}; fmt->string ${b}; string->fmt again ${c}")
  if(NOT a STREQUAL c)
    fail("build-order test: GCC CMIs are not reproducible even for the same order")
  endif()
  if(NOT a STREQUAL b)
    fail("build-order test: CMI content depends on build order")
  endif()
  run(rc out "${bdir}" ${NINJA})
  if(NOT rc EQUAL 0)
    fail("rebuild after build-order test failed")
  endif()
  file(REMOVE "${cs}" "${bdir}/${os}")      # rebuild ONLY <string>; the fmt CMI stays
  run(rc out "${bdir}" ${NINJA})
  if(NOT rc EQUAL 0 OR out MATCHES "CRC")
    fail("rebuilding only the <string> CMI broke a consumer of both (CRC mismatch?)")
  endif()
  expect_noop("${bdir}" "after build-order test")
  bail_if_failed()
  evid("GCC: string/fmt CMIs byte-identical for both build orders; rebuilding only <string> -> no CRC mismatch")
endfunction()

function(test_t03_named_modules bdir)
  hu_configure(t03_named_modules "${bdir}")
  bail_if_failed()
  hu_build_check(t03_named_modules "${bdir}")
  bail_if_failed()
  file(STRINGS "${bdir}/build.ninja" synth REGEX "^build .*@synth_")
  list(FILTER synth EXCLUDE REGEX "@cmake_cxx_std@synth")
  if(synth)
    list(GET synth 0 s)
    fail("synthetic BMI target created: ${s}")
  endif()
  # Boundary probe: module m2 does a NON-exported 'import <vector>;' and its importer uses std::vector members.
  run(rc out "${bdir}" ${NINJA} p_m2_consumer)
  if(rc EQUAL 0)
    set(pr "OK")
  else()
    first_lines(e "${out}" 1)
    set(pr "FAIL (${e})")
  endif()
  set_property(GLOBAL PROPERTY CUR_PROBES " m2_plain_import_reachability=${pr}")
  evid("no m@synth_* target; t03_other (other target) imports m without header-unit flags; probe non-exported HU import reachable from importer: ${pr}")

  # Kitware #28166: an importer of m with target-level options makes CMake synthesize a BMI of m (m@synth_N)
  # with the importer's flags.  Its scan/BMI statements must still wait for the header units.
  set(bs "${bdir}-synth")
  file(REMOVE_RECURSE "${bs}")
  set(synth_opt -O2)
  if(TC STREQUAL "msvc")
    set(synth_opt /GS-)                             # (cl refuses /O2 with the Debug build's /RTC1)
  endif()
  run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${PROTO}/tests/t03_named_modules" -B "${bs}" -G Ninja
      -DCMAKE_BUILD_TYPE=Debug ${TC_ARGS} -DT03_SYNTH=ON -DT03_SYNTH_OPTIONS=${synth_opt})
  if(NOT rc EQUAL 0)
    fail("T03_SYNTH: configure failed")
  endif()
  file(STRINGS "${bs}/build.ninja" sy REGEX "^build cmake_object_order_depends_target_m@synth_[0-9]+:")
  file(STRINGS "${bs}/build.ninja" mo REGEX "^build cmake_object_order_depends_target_m:")
  # CMake 4.3 does not synthesize a BMI for this case (checked with a project without HeaderUnits); 4.4.5 does.
  set(synth_note "CMake synthesizes m@synth_N; its order phony reaches hu_std_ready")
  if(NOT sy AND CMAKE_VER VERSION_LESS 4.4)
    set(synth_note "no m@synth target with CMake ${CMAKE_VER} (synthesized only from 4.4 on)")
  elseif(NOT sy)
    fail("T03_SYNTH: CMake did not synthesize a BMI target for m (probe ineffective)")
  elseif(NOT mo MATCHES " hu_std_ready" OR NOT sy MATCHES " cmake_object_order_depends_target_m( |$)")
    fail("T03_SYNTH: m@synth's object order does not reach hu_std_ready")
  endif()
  run(rc out "${bs}" ${NINJA})
  if(NOT rc EQUAL 0)
    first_lines(e "${out}" 2)
    fail("T03_SYNTH: build failed: ${e}")
  endif()
  execute_process(COMMAND "${bs}/t03_synth${EXE}" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    fail("T03_SYNTH: t03_synth returned ${rc}")
  endif()
  expect_noop("${bs}" "T03_SYNTH")
  bail_if_failed()
  evid("#28166 case: importer with target-level -O2 -> ${synth_note}; builds, runs, no-op")
endfunction()

function(test_t04_shared_set bdir)
  hu_configure(t04_shared_set "${bdir}")
  bail_if_failed()
  hu_build_check(t04_shared_set "${bdir}")
  bail_if_failed()
  set(variants std ext exc abi cfgflags dup)
  if(TC MATCHES "^(msvc|clangcl)$")
    list(REMOVE_ITEM variants ext)                  # no GNU extensions (-std:c++NN either way): CXX_EXTENSIONS changes nothing
  endif()
  foreach(v IN LISTS variants)
    set(bb "${bdir}-bad-${v}")
    file(REMOVE_RECURSE "${bb}")
    run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${PROTO}/tests/t04_shared_set" -B "${bb}" -G Ninja
        -DCMAKE_BUILD_TYPE=Debug ${TC_ARGS} -DT04_BAD=${v})
    if(v STREQUAL "std")
      set(want "is incompatible with header-unit set 'hu_std'.*C[+][+]23")
    elseif(v STREQUAL "ext")
      set(want "is incompatible with header-unit set 'hu_std'.*CXX_EXTENSIONS=OFF")
    elseif(v STREQUAL "exc")
      set(want "is incompatible with header-unit set 'hu_std'.*exceptions/RTTI options differ")
    elseif(v STREQUAL "abi")
      set(want "is incompatible with header-unit set 'hu_std'.*ABI-affecting definitions differ")
    elseif(v STREQUAL "cfgflags")
      set(want "is incompatible with header-unit set 'hu_std'.*CMAKE_CXX_FLAGS_DEBUG differs")
    elseif(TC MATCHES "^(gcc|mingw)$")
      set(want "is already a header unit of set 'hu_std'")
    else()
      set(want "would get two header units for")
    endif()
    string(REGEX REPLACE "[ \n]+" " " flat "${out}")
    if(rc EQUAL 0 OR NOT flat MATCHES "${want}")
      fail("T04_BAD=${v}: configure did not fail with the expected message ('${want}')")
    endif()
  endforeach()
  # A consumer directory that adds only warning and debug-information flags is compatible: configures and builds.
  set(bb "${bdir}-warn")
  file(REMOVE_RECURSE "${bb}")
  run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${PROTO}/tests/t04_shared_set" -B "${bb}" -G Ninja -DCMAKE_BUILD_TYPE=Debug
      ${TC_ARGS} -DT04_WARN=ON)
  if(rc EQUAL 0)
    run(rc out "${bb}" ${NINJA} t04_warn)
  endif()
  if(NOT rc EQUAL 0)
    first_lines(e "${out}" 3)
    fail("a consumer directory that adds only warning / debug-information flags was rejected or does not build: ${e}")
  else()
    evid("a consumer directory adding only -Wall -Wextra (-g3 in Debug) / /W4 is accepted and builds;")
  endif()
  # Ninja Multi-Config (MSVC rejects it): every configuration is compared, and the message names it.  A consumer-only
  # _ITERATOR_DEBUG_LEVEL=0 (MSVC STL) differs in Debug only: 0 is the default of the other configurations.
  if(NOT TC STREQUAL "msvc")
    foreach(v cfgflags abi)
      set(bb "${bdir}-bad-${v}-mc")
      file(REMOVE_RECURSE "${bb}")
      run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${PROTO}/tests/t04_shared_set" -B "${bb}" -G "Ninja Multi-Config"
          ${TC_ARGS} -DT04_BAD=${v})
      set(unwanted "")
      if(v STREQUAL "cfgflags")
        set(want "is incompatible with header-unit set 'hu_std'.*configuration Debug: CMAKE_CXX_FLAGS_DEBUG differs")
      elseif(TC MATCHES "^(win|clangcl)$")
        set(want "is incompatible with header-unit set 'hu_std'.*configuration Debug: ABI-affecting definitions differ: consumer '[^']*_ITERATOR_DEBUG_LEVEL=0'")
        set(unwanted "Release[^:]*: ABI-affecting")
      else()
        set(want "is incompatible with header-unit set 'hu_std'.*configurations Debug, [^:]*Release[^:]*: ABI-affecting definitions differ")
      endif()
      string(REGEX REPLACE "[ \n]+" " " flat "${out}")
      if(rc EQUAL 0 OR NOT flat MATCHES "${want}" OR (unwanted AND flat MATCHES "${unwanted}"))
        fail("Ninja Multi-Config, T04_BAD=${v}: configure did not fail with the expected message ('${want}')")
      endif()
    endforeach()
    if(TC MATCHES "^(win|clangcl)$")
      evid("Ninja Multi-Config: the cfgflags and abi consumers are rejected naming the configuration (Debug only for a consumer-only _ITERATOR_DEBUG_LEVEL=0);")
    else()
      evid("Ninja Multi-Config: the cfgflags and abi consumers are rejected naming the configuration(s);")
    endif()
  endif()
  evid("2 targets share hu_std; rejected at configure time: CXX_STANDARD 23 consumer, CXX_EXTENSIONS OFF consumer, -fno-exceptions consumer, a consumer-only ABI definition (_GLIBCXX_DEBUG / _ITERATOR_DEBUG_LEVEL), a consumer directory's own CMAKE_CXX_FLAGS_DEBUG, a second set declaring <vector> (GCC) / a TU receiving <vector> from two sets (Clang)")
endfunction()

function(t05_step bdir what)
  run(rc out "${bdir}" ${NINJA} -n -d explain)
  string(REPLACE "\\" "/" out "${out}")             # MSVC: build.ninja paths with backslashes
  string(FIND "${out}" "hu_tiny.dir/hu/tiny/tiny.hpp${OBJ}" p1)
  if(p1 LESS 0)
    fail("${what}: ninja -d explain does not plan the BMI rebuild")
  endif()
  run(rc out "${bdir}" ${NINJA})
  string(REPLACE "\\" "/" out "${out}")
  string(FIND "${out}" "Building CXX object CMakeFiles/hu_tiny.dir/hu/tiny/tiny.hpp${OBJ}" p1)
  string(FIND "${out}" "Building CXX object CMakeFiles/t05.dir/main.cpp${OBJ}" p2)
  if(NOT rc EQUAL 0 OR p1 LESS 0 OR p2 LESS 0 OR p2 LESS p1)
    fail("${what}: BMI and then consumer were not rebuilt")
  endif()
  expect_noop("${bdir}" "${what}")
endfunction()

function(t05_value out bdir)
  execute_process(COMMAND "${bdir}/t05${EXE}" RESULT_VARIABLE rc)
  _log("t05 exit code: ${rc}")
  set(${out} "${rc}" PARENT_SCOPE)
endfunction()

function(test_t05_rebuild bdir)
  set(vend "${bdir}-vendor")
  if(FRESH)
    file(REMOVE_RECURSE "${vend}")
  endif()
  hu_configure(t05_rebuild "${bdir}" "-DT05_VENDOR_COPY=${vend}")
  bail_if_failed()
  set(det "${vend}/include/tiny/detail.hpp")
  file(READ "${det}" c)
  string(REPLACE "= 42;" "= 41;" c "${c}")
  file(WRITE "${det}" "${c}")
  hu_build_check(t05_rebuild "${bdir}" NOCTEST)
  bail_if_failed()
  t05_value(v "${bdir}")
  if(NOT v EQUAL 41)
    fail("t05 returned ${v}, expected 41")
  endif()
  file(TOUCH "${det}")
  t05_step("${bdir}" "touch detail.hpp (included by the header unit)")
  bail_if_failed()
  file(SIZE "${det}" s0)
  file(READ "${det}" c)
  string(REPLACE "= 41;" "= 42;" c "${c}")
  file(WRITE "${det}" "${c}")
  file(SIZE "${det}" s1)
  if(NOT s0 EQUAL s1)
    fail("same-size edit changed the size")
  endif()
  t05_step("${bdir}" "same-size edit 41->42")
  bail_if_failed()
  t05_value(v "${bdir}")
  if(NOT v EQUAL 42)
    fail("after same-size edit t05 returned ${v}, expected 42 (stale BMI?)")
  endif()
  file(TOUCH "${vend}/include/tiny/tiny.hpp")
  t05_step("${bdir}" "touch tiny.hpp (the header unit's own header)")
  bail_if_failed()
  evid("touch / same-size edit of external headers -> explain plans BMI rebuild, BMI then consumer rebuilt, exe 41->42, then no-op")
endfunction()

function(test_t06_mixed bdir)
  hu_configure(t06_mixed "${bdir}")
  bail_if_failed()
  set(res "")
  foreach(p import_then_include include_then_import cstdio_then_import loaded_not_imported
            import_then_include_same include_same_then_import)
    run(rc out "${bdir}" ${NINJA} p_${p})
    if(rc EQUAL 0)
      string(APPEND res " ${p}=OK")
    else()
      first_lines(e "${out}" 1)
      string(APPEND res " ${p}=FAIL")
      _log("probe ${p} first error: ${e}")
    endif()
  endforeach()
  set_property(GLOBAL PROPERTY CUR_PROBES "${res}")
  evid("boundary probes:${res}")
  hu_build_check(t06_mixed "${bdir}")
  bail_if_failed()
  read_manifest("${bdir}")
  ninja_deps(deps "${bdir}" "CMakeFiles/t06.dir/excluded.cpp${OBJ}")
  _norm(hp "${MF_PATH_vector}")
  # (MSVC: Ninja leaves headers under "Program Files" / "Microsoft Visual Studio" out of the deps, so <vector> never shows)
  if(NOT hp IN_LIST deps AND NOT TC STREQUAL "msvc")
    fail("excluded.cpp did not parse <vector> textually")
  endif()
  ninja_deps(deps "${bdir}" "CMakeFiles/t06.dir/mixed.cpp${OBJ}")
  evid("excluded.cpp (not in SOURCES) parsed <vector> textually and built normally")
endfunction()

