    fail("configure failed: ${e}")
  endif()
  if(NOT flat MATCHES "receives header units of other files" OR NOT flat MATCHES "dirB/a\\.h" OR NOT flat MATCHES "dirA/a\\.h")
    fail("no warning naming both files for a consumer that resolves <a.h> to dirB/a.h (no header unit) while its set has dirA/a.h")
  endif()
  run(rc out "${bdir}" ${NINJA})
  string(REGEX REPLACE "[ \t\r\n]+" " " flat "${out}")
  if(rc EQUAL 0)
    fail("the build of a consumer importing <a.h>, which it finds as dirB/a.h (no header unit), succeeded: was the set's BMI of dirA/a.h used silently?")
  endif()
  if(NOT flat MATCHES "dirB[/\\\\]a\\.h" AND NOT (TC STREQUAL "msvc" AND flat MATCHES "could not find header unit for 'a\\.h'"))
    first_lines(e "${out}" 3)
    fail("the build fails, but not on dirB/a.h: ${e}")
  endif()
  evid("configure warns about a consumer that resolves <a.h> to another file (without a header unit) than its set's; its build then fails on dirB/a.h")
endfunction()

function(test_t22_import_std bdir)
  if(CMAKE_VER VERSION_LESS 4.5)
    skip("import std needs CMake 4.5 (${CMAKE_VER} has it only behind an experimental switch)")
    return()
  endif()
  set(extra)
  if(TC STREQUAL "clang")
    # The image's Clang finds GCC 16's modules file only with CLANG_FLAGS (--gcc-toolchain), which CMake does not pass
    # when it asks for it (README, Results).
    execute_process(COMMAND ${CLANG_CXX} ${CLANG_FLAGS} -print-file-name=libstdc++.modules.json
                    OUTPUT_VARIABLE mj OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(IS_ABSOLUTE "${mj}" AND EXISTS "${mj}")
      list(APPEND extra "-DCMAKE_CXX_STDLIB_MODULES_JSON=${mj}")
    endif()
  endif()
  hu_configure(t22_import_std "${bdir}" ${extra})
  bail_if_failed()
  hu_build_check(t22_import_std "${bdir}")
  bail_if_failed()
  evid("import std and a header unit (greet.h, includes <string>) in one TU, and a #include of greet.h next to import std in another")
endfunction()

function(test_t23_multi_config bdir)
  # A copy of the sources (a header is edited below).
  set(src "${ROOT}/t23-src/tests/t23_multi_config")
  file(REMOVE_RECURSE "${ROOT}/t23-src" "${bdir}")
  file(COPY "${PROTO}/tests/t23_multi_config" DESTINATION "${ROOT}/t23-src/tests")
  file(COPY "${PROTO}/cmake" DESTINATION "${ROOT}/t23-src")
  run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${src}" -B "${bdir}" -G "Ninja Multi-Config" ${TC_ARGS})
  string(REGEX REPLACE "[ \t\r\n]+" " " flat "${out}")
  if(TC STREQUAL "msvc")
    if(rc EQUAL 0 OR NOT flat MATCHES "MSVC with Ninja Multi-Config is not supported")
      fail("MSVC with Ninja Multi-Config was not rejected at configure time with the reason")
    else()
      evid("MSVC with Ninja Multi-Config is rejected at configure time (/showIncludes lists no IFCs)")
    endif()
    return()
  endif()
  if(NOT rc EQUAL 0)
    first_lines(e "${out}" 3)
    fail("configure failed: ${e}")
    return()
  endif()
  # The lookup per configuration: Debug and RelWithDebInfo share a run (their flags differ only in -O/-g/-D), Release
  # (its include directory relinc/) has its own, plus the self-check.
  lookup_runs(runs "${out}")
  if(NOT runs STREQUAL "3")
    fail("the header lookup took '${runs}' compiler runs, not 3 (Debug and RelWithDebInfo, Release, the self-check)")
  endif()
  foreach(cfg Debug Release)
    run(rc out "${bdir}" ${NINJA} -f build-${cfg}.ninja)
    if(NOT rc EQUAL 0)
      first_lines(e "${out}" 3)
      fail("${cfg} build failed: ${e}")
      return()
    endif()
    run(rc out "${bdir}" "${bdir}/${cfg}/t23${EXE}")
    if(NOT rc EQUAL 0)
      fail("${cfg}: t23 failed (${rc}): wrong configuration's header unit?")
    endif()
    run(rc out "${bdir}" ${NINJA} -f build-${cfg}.ninja)
    if(NOT out MATCHES "no work to do")
      fail("${cfg}: second build was not a no-op")
    endif()
  endforeach()
  bail_if_failed()
  # The BMI of <cfgval.h> per configuration (the manifest spells the directory as $<CONFIG>).
  file(STRINGS "${bdir}/CMakeFiles/header_units/manifest.txt" ml REGEX "[|]cfgval[.]h[|]")
  string(REGEX REPLACE "^.*[|]" "" bmi "${ml}")
  string(REPLACE "$<CONFIG>" "Debug" dbmi "${bmi}")
  if(NOT EXISTS "${dbmi}")
    fail("no Debug BMI of <cfgval.h> at '${dbmi}' (manifest: ${ml})")
    return()
  endif()
  file(RELATIVE_PATH rbmi "${bdir}" "${dbmi}")
  run(rc out "${bdir}" ${NINJA} -f build-Debug.ninja -t deps CMakeFiles/t23.dir/Debug/main.cpp${OBJ})
  if(NOT out MATCHES "${rbmi}")
    fail("the Debug compile of main.cpp does not list its BMI '${rbmi}' in its dependencies (depfile)")
  endif()
  # A header edit: the Debug BMI and both consumers rebuild in the same ninja run, then nothing.
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
  file(APPEND "${src}/inc/cfgval.h" "// edited\n")
  run(rc out "${bdir}" ${NINJA} -f build-Debug.ninja)
  if(NOT rc EQUAL 0 OR NOT out MATCHES "cfgval[.]h" OR NOT out MATCHES "main[.]cpp" OR NOT out MATCHES "other[.]cpp")
    fail("after a header edit, one Debug ninja run did not rebuild the BMI and both consumers:\n${out}")
  endif()
  run(rc out "${bdir}" ${NINJA} -f build-Debug.ninja)
  if(NOT out MATCHES "no work to do")
    fail("after a header edit: the second Debug build was not a no-op")
  endif()
  # A deleted BMI is rebuilt, and the consumers after it.
  file(REMOVE "${dbmi}")
  run(rc out "${bdir}" ${NINJA} -f build-Debug.ninja)
  if(NOT rc EQUAL 0 OR NOT EXISTS "${dbmi}" OR NOT out MATCHES "main[.]cpp")
    fail("a deleted Debug BMI was not rebuilt with its consumers:\n${out}")
  endif()
  run(rc out "${bdir}" "${bdir}/Debug/t23${EXE}")
  if(NOT rc EQUAL 0)
    fail("Debug: t23 failed after the rebuilds (${rc})")
  endif()
  evid("Ninja Multi-Config: Debug and Release build and run with their own header units (NDEBUG), each a no-op after; a header edit rebuilds BMI and consumers in one run; a deleted BMI is rebuilt; the consumer's depfile names its BMI; the lookup uses each configuration's flags (a Release-only include directory that loses on order: 3 compiler runs)")
  # A Release-only include directory whose <vector> shadows the C++ library's: one header unit cannot serve both files.
  run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${src}" -B "${bdir}-shadow" -G "Ninja Multi-Config" -DT23_SHADOW=ON ${TC_ARGS})
  string(REGEX REPLACE "[ \t\r\n]+" " " flat "${out}")
  set(want "<vector> is another file in another configuration.* configurations Debug, RelWithDebInfo: '[^']*vector' configuration Release: '[^']*/relshadow/vector'")
  if(rc EQUAL 0 OR NOT flat MATCHES "${want}")
    first_lines(e "${out}" 8)
    fail("a <vector> shadowed in Release only did not stop the configure naming the configurations and files: ${e}")
  else()
    evid("; a <vector> shadowed in Release only stops the configure, naming the configurations and both files")
  endif()
  if(TC MATCHES "^(gcc|mingw)$")
    run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${src}" -B "${bdir}-wrappers" -G "Ninja Multi-Config" -DHU_GCC_WRAPPERS=ON ${TC_ARGS})
    string(REGEX REPLACE "[ \t\r\n]+" " " flat "${out}")
    if(rc EQUAL 0 OR NOT flat MATCHES "hu-mapper is required")
      fail("GCC with HU_GCC_WRAPPERS and Ninja Multi-Config was not rejected at configure time")
    else()
      evid("; GCC without hu-mapper (HU_GCC_WRAPPERS) is rejected")
    endif()
  endif()
endfunction()

# One header in two sets of one directory, each set imported by its own target (<vector>; <t24/val.h>, spelled <val.h>
# by hu_two).  GCC: one header unit per header per build tree, the second set is rejected at configure time.  The
# others: source properties are per directory, so the header's compile options are shared by both sets; each set must
# still write its own BMI (MSVC's /ifcOutput, clang-cl's /clang:-o) at the object path its consumers depend on.
function(test_t24_two_sets bdir)
  if(TC MATCHES "^(gcc|mingw)$")
    file(REMOVE_RECURSE "${bdir}")
    run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${PROTO}/tests/t24_two_sets" -B "${bdir}" -G Ninja
        -DCMAKE_BUILD_TYPE=Debug ${TC_ARGS})
    string(REGEX REPLACE "[ \t\r\n]+" " " flat "${out}")
    set(want "add_header_units[(]hu_two[)]: <vector> [(]'[^']*'[)] is already a header unit of set 'hu_one'")
    if(rc EQUAL 0 OR NOT flat MATCHES "${want}")
      first_lines(e "${out}" 3)
      fail("configure did not fail with /${want}/: ${e}")
    else()
      evid("a second set with <vector> is rejected at configure time (one header unit per header per build tree)")
    endif()
    return()
  endif()
  hu_configure(t24_two_sets "${bdir}")
  bail_if_failed()
  hu_build_check(t24_two_sets "${bdir}")
  bail_if_failed()
  # Each set's BMIs (manifest: set|name|path|bmi): two each, all distinct, all built.
  file(STRINGS "${bdir}/CMakeFiles/header_units/manifest.txt" ml)
  set(all)
  foreach(s hu_one hu_two)
    set(B_${s})
    foreach(l IN LISTS ml)
      string(REPLACE "|" ";" f "${l}")
      list(GET f 0 ls)
      list(GET f 3 b)
      if(ls STREQUAL s)
        _norm(nb "${b}")
        list(APPEND B_${s} "${nb}")
        list(APPEND all "${nb}")
        if(NOT EXISTS "${b}")
          fail("${s}: BMI '${b}' was not built")
        endif()
      endif()
    endforeach()
    list(LENGTH B_${s} n)
    if(NOT n EQUAL 2)
      fail("${s}: ${n} header units in the manifest, expected 2:\n${ml}")
    endif()
  endforeach()
  list(LENGTH all n0)
  list(REMOVE_DUPLICATES all)
  list(LENGTH all n1)
  if(NOT n0 EQUAL n1)
    fail("the two sets share a BMI path: ${all}")
  endif()
  bail_if_failed()
  # Each consumer's compile hands it exactly its own set's BMIs.
  parse_ninja("${bdir}")
  set(cons t24_a t24_b)
  set(sets hu_one hu_two)
  set(others t24_b t24_a)
  set(nchecked 0)
  foreach(c s IN ZIP_LISTS cons sets)
    set(found "")
    foreach(h f IN ZIP_LISTS NB_HEADS NB_FLAGS)
      if(NOT h MATCHES "^build CMakeFiles/${c}[.]dir/[^ ]*[.]cpp[^ ]*: CXX_COMPILER__")
        continue()
      endif()
      set(found 1)
      hu_bmis_of_flags(bmis "${f}")
      set(nbmis)
      foreach(b IN LISTS bmis)
        _norm(b "${b}")
        list(APPEND nbmis "${b}")
      endforeach()
      list(SORT nbmis)
      set(want ${B_${s}})
      list(SORT want)
      if(NOT nbmis STREQUAL want)
        fail("${c}: its compile gets the BMIs '${nbmis}', expected those of ${s}: '${want}'")
      endif()
    endforeach()
    if(NOT found)
      fail("no compile statement of ${c} in build.ninja")
    endif()
    math(EXPR nchecked "${nchecked} + 1")
  endforeach()
  if(NOT nchecked EQUAL 2)
    fail("the consumer check ran ${nchecked} times, expected 2")
  endif()
  bail_if_failed()
  # A deleted BMI of <vector> is rebuilt at its own path, with its own set's consumer only.
  set(nrebuilt 0)
  foreach(s c o IN ZIP_LISTS sets cons others)
    set(vb "")
    foreach(l IN LISTS ml)
      if(l MATCHES "^${s}[|]vector[|][^|]*[|](.*)$")
        set(vb "${CMAKE_MATCH_1}")
      endif()
    endforeach()
    file(REMOVE "${vb}")
    run(rc out "${bdir}" ${NINJA})
    string(REPLACE "\\" "/" out "${out}")
    if(NOT rc EQUAL 0 OR NOT EXISTS "${vb}" OR NOT out MATCHES "${c}[.]dir/" OR out MATCHES "${o}[.]dir/")
      first_lines(e "${out}" 3)
      fail("after deleting ${s}'s BMI of <vector>, ninja did not rebuild it alone with ${c} (rc=${rc}): ${e}")
    endif()
    expect_noop("${bdir}" "after deleting ${s}'s BMI of <vector>")
    math(EXPR nrebuilt "${nrebuilt} + 1")
  endforeach()
  if(NOT nrebuilt EQUAL 2)
    fail("the BMI deletion check ran ${nrebuilt} times, expected 2")
  endif()
  evid("2 sets of one directory with <vector> and <t24/val.h> (= <val.h>): 4 distinct BMIs built, each consumer's compile gets only its own set's, a deleted BMI is rebuilt alone with its consumer")
endfunction()

function(test_t25_shared_source bdir)
  hu_configure(t25_shared_source "${bdir}")
  bail_if_failed()
  hu_build_check(t25_shared_source "${bdir}")
  bail_if_failed()
  # GCC: every target's compile of src/main.cpp also translates its #include <sh2.h> into an import: the header is not
  # in the depfile, its CMI is
  if(TC MATCHES "^(gcc|mingw)$")
    read_manifest("${bdir}")
    _norm(bmi "${MF_BMI_sh2_h}")
    file(GLOB_RECURSE objs RELATIVE "${bdir}" "${bdir}/*main.cpp${OBJ}")
    foreach(t ta tb tc)
      set(obj "${objs}")
      list(FILTER obj INCLUDE REGEX "/${t}[.]dir/")
      list(LENGTH obj no)
      if(NOT no EQUAL 1)
        fail("${t}: expected one object of src/main.cpp, found '${obj}'")
      endif()
      ninja_deps(deps "${bdir}" "${obj}")
      foreach(d IN LISTS deps)
        if(d MATCHES "/inc/sh2[.]h$")
          fail("${t}: #include <sh2.h> was parsed textually (${d} in the depfile of ${obj})")
        endif()
      endforeach()
      if(NOT bmi IN_LIST deps)
        fail("${t}: the CMI of <sh2.h> (${bmi}) is not in the depfile of ${obj}")
      endif()
    endforeach()
  endif()
  evid("one source in three targets (two directories, two in one) with three spellings of the include directory: each compile imports <sh.h> and translates #include <sh2.h>")
endfunction()

# One source in two targets (t26): a target that does not import header units compiles a source that a target of
# another directory imports them for.  A clean build of only that target, and one after an edit of the header, need no
# header unit and keep the #include textual.
function(test_t26_shared_targets bdir)
  hu_configure(t26_shared_targets "${bdir}")
  bail_if_failed()
  read_manifest("${bdir}")
  _norm(bmi "${MF_BMI_t26_h}")
  file(RELATIVE_PATH rbmi "${bdir}" "${bmi}")
  run(rc out "${bdir}" ${NINJA} t26_plain)
  if(NOT rc EQUAL 0)
    first_lines(e "${out}" 3)
    fail("a clean 'ninja t26_plain' (no header units; its source is a consumer in another directory) failed: ${e}")
  endif()
  if(EXISTS "${bmi}")
    fail("a clean 'ninja t26_plain' built the header unit ${rbmi}")
  endif()
  file(GLOB_RECURSE pobj RELATIVE "${bdir}" "${bdir}/c/*plain.cpp${OBJ}")
  list(LENGTH pobj no)
  if(NOT no EQUAL 1)
    fail("expected one object of src/plain.cpp in c/, found '${pobj}'")
  endif()
  ninja_deps(deps "${bdir}" "${pobj}")
  _norm(hdr "${PROTO}/tests/t26_shared_targets/inc/t26.h")
  if(NOT hdr IN_LIST deps AND NOT TC STREQUAL "msvc")
    fail("t26_plain: #include <t26.h> was not textual (${hdr} not in the depfile of ${pobj})")
  endif()
  if(bmi IN_LIST deps)
    fail("t26_plain: the header unit ${rbmi} is in the depfile of ${pobj}")
  endif()
  bail_if_failed()
  hu_build_check(t26_shared_targets "${bdir}")
  bail_if_failed()
  # after an edit of the header: t26_plain's object is rebuilt, the header unit is not built for it
  file(TOUCH "${PROTO}/tests/t26_shared_targets/inc/t26.h")
  run(rc out "${bdir}" ${NINJA} -v t26_plain)
  if(NOT rc EQUAL 0)
    first_lines(e "${out}" 3)
    fail("'ninja t26_plain' after an edit of t26.h failed: ${e}")
  endif()
  string(REPLACE "\\" "/" out "${out}")
  string(FIND "${out}" "plain.cpp" ppos)
  string(FIND "${out}" "${rbmi}" bpos)
  if(ppos LESS 0)
    fail("'ninja t26_plain' after an edit of t26.h did not recompile src/plain.cpp")
  elseif(NOT bpos LESS 0)
    fail("'ninja t26_plain' after an edit of t26.h built the header unit ${rbmi}")
  endif()
  run(rc out "${bdir}" ${NINJA})
  if(NOT rc EQUAL 0)
    fail("build after the edit of t26.h failed")
  endif()
  expect_noop("${bdir}" "after the edit of t26.h")
  bail_if_failed()
  evid("t26_plain (no header units, its source a consumer in a/): clean 'ninja t26_plain' builds without the header unit, #include textual in its depfile; after an edit of the header only its object is rebuilt")
endfunction()

function(test_t27_module_two_targets bdir)
  hu_configure(t27_module_two_targets "${bdir}")
