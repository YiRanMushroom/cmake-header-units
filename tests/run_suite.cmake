function(test_t14_textual_pragma bdir)
  hu_configure(t14_textual_pragma "${bdir}")
  bail_if_failed()
  hu_build_check(t14_textual_pragma "${bdir}")
  bail_if_failed()
  # impl.cpp and plain.cpp parse stbish.h textually (the header itself is in their depfiles)
  foreach(o impl plain)
    file(GLOB obj RELATIVE "${bdir}" "${bdir}/CMakeFiles/t14.dir/${o}.cpp.o*")
    list(FILTER obj EXCLUDE REGEX "[.](d|ddi|modmap)$")
    list(GET obj 0 obj)
    ninja_deps(deps "${bdir}" "${obj}")
    set(found FALSE)
    foreach(d IN LISTS deps)
      if(d MATCHES "stbish/stbish[.]h$")
        set(found TRUE)
      endif()
    endforeach()
    if(NOT found)
      fail("${o}.cpp did not include stbish.h textually (not in its depfile)")
    endif()
  endforeach()
  evid("marked impl.cpp/plain.cpp include stbish.h textually (STBISH_IMPLEMENTATION kept), main.cpp imports it, impl.cpp's own import <vector> uses the header unit")
endfunction()

function(test_t15_scan_sources bdir)
  hu_configure(t15_scan_sources "${bdir}")
  bail_if_failed()
  hu_build_check(t15_scan_sources "${bdir}")
  bail_if_failed()
  file(READ "${bdir}/CMakeFiles/header_units/manifest.txt" mf)
  if(NOT mf MATCHES "t15_hu[|]cfg[.]h[|]" OR NOT mf MATCHES "t15_hu[|]vector[|]" OR NOT mf MATCHES "t15_hu_2[|]string[|]")
    fail("expected t15_hu (cfg.h, vector) and t15_hu_2 (string):\n${mf}")
  endif()
  if(mf MATCHES "t15_hu_2[|]vector[|]")
    fail("the second call did not reuse <vector>")
  endif()
  # c.cpp is not listed: it parses cfg.h textually
  file(GLOB obj RELATIVE "${bdir}" "${bdir}/CMakeFiles/t15.dir/c.cpp.o*")
  list(FILTER obj EXCLUDE REGEX "[.](d|ddi|modmap)$")
  list(GET obj 0 obj)
  ninja_deps(deps "${bdir}" "${obj}")
  set(found FALSE)
  foreach(d IN LISTS deps)
    if(d MATCHES "inc/cfg[.]h$")
      set(found TRUE)
    endif()
  endforeach()
  if(NOT found)
    fail("unlisted c.cpp did not include cfg.h textually")
  endif()
  set(bb "${bdir}-bad")
  file(REMOVE_RECURSE "${bb}")
  run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${PROTO}/tests/t15_scan_sources" -B "${bb}" -G Ninja ${TC_ARGS} -DT15_BAD=ON)
  string(REGEX REPLACE "[ \t\r\n]+" " " flat "${out}")
  if(rc EQUAL 0 OR NOT flat MATCHES "is not a C[+][+] source of target 't15'")
    fail("T15_BAD: configure did not fail with 'is not a C++ source of target'")
  endif()
  evid("two calls: a.cpp -> t15_hu (cfg.h, vector), b.cpp -> t15_hu_2 (string, vector reused); unlisted c.cpp keeps its macro-configured #include textual; a non-source is rejected at configure time")
endfunction()

# -------------------------------------------------------------------------------------------------- main
set(results "")
foreach(t IN LISTS TESTS)
  set(name "")
  foreach(a IN LISTS ALL_TESTS)
    if(a MATCHES "^${t}")
      set(name "${a}")
    endif()
  endforeach()
  if(NOT name)
    message(FATAL_ERROR "unknown test ${t}")
  endif()
  set(bdir "${ROOT}/${name}")
  set_property(GLOBAL PROPERTY CUR_LOG "${ROOT}/logs/${name}.log")
  set_property(GLOBAL PROPERTY CUR_FAIL "")
  set_property(GLOBAL PROPERTY CUR_EVID "")
  file(WRITE "${ROOT}/logs/${name}.log" "# ${name}  TC=${TC}  CMake ${CMAKE_VER}\n")
  string(TIMESTAMP t0 "%s")
  cmake_language(CALL test_${name} "${bdir}")
  string(TIMESTAMP t1 "%s")
  math(EXPR dt "${t1} - ${t0}")
  get_property(f GLOBAL PROPERTY CUR_FAIL)
  get_property(e GLOBAL PROPERTY CUR_EVID)
  if(f)
    set(verdict FAIL)
    set(e "${f} || ${e}")
  else()
    set(verdict PASS)
  endif()
  string(REPLACE "\n" " " e "${e}")
  message("${verdict}  ${TC}  cmake-${CMAKE_VER}  ${name}  (${dt}s)  ${e}")
  string(APPEND results "${TC}|${CMAKE_VER}|${name}|${verdict}|${dt}s|${e}\n")
endforeach()
file(WRITE "${ROOT}/results.txt" "${results}")
