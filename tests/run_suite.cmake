# Sources that stop being header-unit consumers (t15): the compile parses the header textually again (depfile) and sees
# its edits.  The files the compile rule reads (GCC: hu-index.txt) describe exactly the current configure: a dropped
# source leaves it, also when no consumer is left (the scan finds no import any more, or no header-unit command runs).
function(t15_drop_check what b obj)
  ninja_deps(deps "${b}" "CMakeFiles/t15d.dir/${obj}${OBJ}")
  set(found FALSE)
  foreach(d IN LISTS deps)
    if(d MATCHES "/inc/h[.]hpp$")
      set(found TRUE)
    elseif(d MATCHES "_hu[^/]*[.]dir/")
      fail("${what}: ${obj} still reads a header unit (${d})")
    endif()
  endforeach()
  if(NOT found)
    fail("${what}: ${obj} does not include h.hpp textually (deps: ${deps})")
  endif()
  if(TC MATCHES "^(gcc|mingw)$" AND EXISTS "${b}/CMakeFiles/header_units/hu-index.txt")
    file(READ "${b}/CMakeFiles/header_units/hu-index.txt" idx)
    string(FIND "${idx}" "/t15-drop/src/${obj}|" pos)
    if(NOT pos EQUAL -1)
      fail("${what}: hu-index.txt still gives ${obj} a header-unit map:\n${idx}")
    endif()
  endif()
endfunction()

# an edit after a build: one second later, so that its time stamp is newer than the build's outputs
function(t15_drop_edit f content)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
  file(WRITE "${f}" "${content}")
endfunction()

function(t15_drop_step what b want)
  run(rc out "${b}" ${NINJA})
  if(NOT rc EQUAL 0)
    first_lines(e "${out}" 3)
    fail("${what}: build failed: ${e}")
  endif()
  execute_process(COMMAND "${b}/t15d${EXE}" RESULT_VARIABLE rc)
  _log("t15d exit code: ${rc}")
  if(NOT rc EQUAL want)
    fail("${what}: t15d returned ${rc}, expected ${want} (a stale object: the header's edit not seen?)")
  endif()
endfunction()

function(t15_drop)
  set(src "${ROOT}/t15-drop/src")
  set(b "${ROOT}/t15-drop/b")
  file(REMOVE_RECURSE "${ROOT}/t15-drop")
  file(WRITE "${src}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.28...4.5)\nproject(t15d CXX)\n"
    "set(CMAKE_CXX_STANDARD 20)\ninclude(\"${PROTO}/cmake/HeaderUnits.cmake\")\n"
    "add_executable(t15d a.cpp b.cpp)\ntarget_include_directories(t15d PRIVATE inc)\n"
    "string(REPLACE , \";\" T15D_SCAN \"\${T15D_SCAN}\")\n"
    "if(T15D_SCAN)\n  target_header_units_scan_sources(t15d \${T15D_SCAN})\nendif()\n")
  set(imp "import <h.hpp>;\n")
  set(inc "#include <h.hpp>\n")
  set(amain "int g();\nint main() { return f() + g(); }\n")
  set(bg "int g() { return f(); }\n")
  file(WRITE "${src}/inc/h.hpp" "#pragma once\ninline int f() { return 0; }\n")
  file(WRITE "${src}/a.cpp" "${imp}${amain}")
  file(WRITE "${src}/b.cpp" "${imp}${bg}")
  run(rc out "${PROTO}" "${CMAKE_EXE}" -S "${src}" -B "${b}" -G Ninja -DCMAKE_BUILD_TYPE=Debug ${TC_ARGS} "-DT15D_SCAN=a.cpp,b.cpp")   # (a ';' would split run()'s arguments)
  if(NOT rc EQUAL 0)
    fail("t15-drop: configure failed")
  endif()
  t15_drop_step("a.cpp and b.cpp consumers" "${b}" 0)
  bail_if_failed()
  # one consumer left: b.cpp is no longer listed (and includes the header)
  t15_drop_edit("${src}/b.cpp" "${inc}${bg}")
  run(rc out "${PROTO}" "${CMAKE_EXE}" "-DT15D_SCAN=a.cpp" "${b}")
  t15_drop_step("b.cpp dropped" "${b}" 0)
  bail_if_failed()
  t15_drop_check("b.cpp dropped" "${b}" b.cpp)
  bail_if_failed()
  # none left: a.cpp's import becomes an #include, the scan finds nothing (the build re-runs CMake)
  t15_drop_edit("${src}/a.cpp" "${inc}${amain}")
  t15_drop_step("a.cpp's import made an #include" "${b}" 0)
  bail_if_failed()
  t15_drop_check("a.cpp's import made an #include" "${b}" a.cpp)
  bail_if_failed()
  t15_drop_edit("${src}/inc/h.hpp" "#pragma once\ninline int f() { return 1; }\n")
  t15_drop_step("no consumer left, h.hpp edited" "${b}" 2)
  bail_if_failed()
  # a consumer again, then no header-unit command at all (include(HeaderUnits) stays)
  t15_drop_edit("${src}/a.cpp" "${imp}${amain}")
  t15_drop_step("a.cpp a consumer again" "${b}" 2)
  bail_if_failed()
  t15_drop_edit("${src}/a.cpp" "${inc}${amain}")
  run(rc out "${PROTO}" "${CMAKE_EXE}" "-DT15D_SCAN=" "${b}")
  t15_drop_step("no header-unit command" "${b}" 2)
  bail_if_failed()
  t15_drop_check("no header-unit command" "${b}" a.cpp)
  bail_if_failed()
  t15_drop_edit("${src}/inc/h.hpp" "#pragma once\ninline int f() { return 2; }\n")
  t15_drop_step("no header-unit command, h.hpp edited" "${b}" 4)
endfunction()

