# -------------------------------------------------------------------------------------------------- main
set(results "")
foreach(t IN LISTS TESTS)
  set(name "")
  foreach(a IN LISTS ALL_TESTS)
    if(a MATCHES "^${t}")
      set(name "${a}")
    endif()
  endforeach()
  if(NOT name)
    message(FATAL_ERROR "unknown test ${t}")
  endif()
  set(bdir "${ROOT}/${name}")
  set_property(GLOBAL PROPERTY CUR_LOG "${ROOT}/logs/${name}.log")
  set_property(GLOBAL PROPERTY CUR_FAIL "")
  set_property(GLOBAL PROPERTY CUR_EVID "")
  set_property(GLOBAL PROPERTY CUR_SKIP "")
  file(WRITE "${ROOT}/logs/${name}.log" "# ${name}  TC=${TC}  CMake ${CMAKE_VER}\n")
  string(TIMESTAMP t0 "%s")
  cmake_language(CALL test_${name} "${bdir}")
  string(TIMESTAMP t1 "%s")
  math(EXPR dt "${t1} - ${t0}")
  get_property(f GLOBAL PROPERTY CUR_FAIL)
  get_property(e GLOBAL PROPERTY CUR_EVID)
  get_property(sk GLOBAL PROPERTY CUR_SKIP)
  # Known failures (README, Limitations): checked to still fail the known way, so a change shows up
  set(known "")
  if(TC STREQUAL "mingw" AND name MATCHES "^(t02_thirdparty)$")
    set(known TRUE)
  endif()
  # MSVC: fmt 10.1.1 header-only does not link through a header unit (as with MSBuild): format_facet::do_put
  if(TC STREQUAL "msvc" AND name MATCHES "^(t02_thirdparty|t08_auto|t11_transitive)$")
    set(known TRUE)
  endif()
  if(sk AND NOT f)
    set(verdict SKIP)
    set(e "${sk}")
  elseif(f AND known)
    set(verdict XFAIL)
    set(e "${f} || ${e}")
  elseif(f)
    set(verdict FAIL)
    set(e "${f} || ${e}")
  elseif(known)
    set(verdict XPASS)
  else()
    set(verdict PASS)
  endif()
  string(REPLACE "\n" " " e "${e}")
  message("${verdict}  ${TC}  cmake-${CMAKE_VER}  ${name}  (${dt}s)  ${e}")
  string(APPEND results "${TC}|${CMAKE_VER}|${name}|${verdict}|${dt}s|${e}\n")
endforeach()
file(WRITE "${RESULTS}" "${results}")
